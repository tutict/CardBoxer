+    for c in CHECKS:
+        print(f"{'OK  ' if c['ok'] else 'FAIL'} {c['name']} | {c['detail']}")
+    print(f"TOTAL={len(CHECKS)} PASSED={passed} FAILED={failed}")
+    print("A_VERIFIED" if passed == len(CHECKS) else "A_VERIFY_FAILED")
