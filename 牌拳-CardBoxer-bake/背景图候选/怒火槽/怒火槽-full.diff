+## 回合制专用：y=76 那条原本空着的槽位画怒火；实时模式的 _draw_meter 原样不动。
+func _draw_rage_bar(pos: Vector2, ratio: float, mirrored: bool) -> void:
+	var full: bool = ratio >= 1.0
+	draw_rect(Rect2(pos, Vector2(BAR_W, RAGE_H)), RAGE_EMPTY)
+	var fill_w: float = BAR_W * clampf(ratio, 0.0, 1.0)
+	if fill_w > 0.0:
+		var bands: int = 5
+		for i in range(bands):
+			var t: float = float(i) / float(bands - 1)
+			var col: Color = RAGE_LOW.lerp(RAGE_HIGH, t)
+			if full:
+				col = col.lerp(RAGE_FULL, 0.55)
+			var y: float = pos.y + float(i) * (RAGE_H / float(bands))
+			var x: float = (pos.x + BAR_W - fill_w) if mirrored else pos.x
+			draw_rect(Rect2(Vector2(x, y), Vector2(fill_w, RAGE_H / float(bands) + 0.5)), col)
+	var edge: Color = Color(0.45, 0.32, 0.28, 0.85)
+	var edge_w: float = 1.0
+	if full:
+		var pulse: float = 0.55 + 0.35 * sin(_time * 9.0)
+		edge = Color(RAGE_FULL.r, RAGE_FULL.g, RAGE_FULL.b, pulse)
+		edge_w = 2.0
+	draw_rect(Rect2(pos, Vector2(BAR_W, RAGE_H)), edge, false, edge_w)
+	# 数值并到 y=104 的轮次行里：槽只有 10px 高，塞不下 12px 的字，
+	# 硬画会同时压住填充色和上方血条。槽本身保持纯色带 + 满槽脉冲边框。
+
+
