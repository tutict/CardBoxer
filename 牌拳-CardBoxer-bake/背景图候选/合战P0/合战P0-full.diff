 	var key: int = (event as InputEventKey).keycode
+	if battle_mode == "taikou" and round_phase == "fight":
+		match key:
+			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
+				if not tk_bot:
+					_taikou_toggle(key - KEY_1)
+			KEY_SPACE, KEY_ENTER:
+				if not tk_bot:
+					_taikou_confirm()
+			KEY_R:
+				_start_match()
+			KEY_P:
+				paused = not paused
+		return
 	match key:
 		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
 			_try_play(key - KEY_1)

