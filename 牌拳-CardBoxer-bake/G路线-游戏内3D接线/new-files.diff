===== G/make_baseline_g.py =====
"""G 路线 P0：备份可运行游戏工程全部源码，写逐文件 size+sha256 基线。

二进制复制，绝不用 read_text/write_text（换行口径会污染证据）。
排除 .godot/ 与 __pycache__/：那是引擎缓存，不是源码。
用法：python make_baseline_g.py
"""
from __future__ import annotations

import hashlib
import json
import shutil
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
ORIG = HERE / "orig" / "pre-3d"
BASELINE = HERE / "baseline_g.json"
EXCLUDE_DIRS = {".godot", "__pycache__"}


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def game_files() -> list[Path]:
    out = []
    for p in sorted(GAME.rglob("*")):
        if not p.is_file():
            continue
        rel = p.relative_to(GAME)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        out.append(p)
    return out


def main() -> int:
    files = game_files()
    rows = []
    for p in files:
        rel = p.relative_to(GAME)
        dst = ORIG / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, dst)
        rows.append({"rel": str(rel).replace("\\", "/"),
                     "size": p.stat().st_size,
                     "sha256": sha256(p)})
    # 备份必须逐字节一致，否则「备份成功」是假的
    mismatch = []
    for row in rows:
        q = ORIG / row["rel"]
        if not q.is_file() or q.stat().st_size != row["size"] \
                or sha256(q) != row["sha256"]:
            mismatch.append(row["rel"])
    payload = {
        "game": str(GAME),
        "count": len(rows),
        "backup": str(ORIG),
        "backup_verified": not mismatch,
        "backup_mismatch": mismatch,
        "files": rows,
    }
    BASELINE.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
                        encoding="utf-8")
    print(f"BASELINE_FILES={len(rows)} BACKUP_VERIFIED={not mismatch} "
          f"MISMATCH={len(mismatch)}")
    print("BASELINE_G_OK" if not mismatch else "BASELINE_G_FAILED")
    return 0 if not mismatch else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== G/run_all_checks_g.py =====
"""跑当前游戏树上 15 套引擎内自检，按 tag 分开落盘，不污染旧归档。

用法：python run_all_checks_g.py before
      python run_all_checks_g.py after
"""
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
LOGS = HERE / "logs" / "checks"

CHECKS = [
    ("motion_check", "res://tests/motion_check.gd"),
    ("pose_probe", "res://tests/pose_probe.gd"),
    ("duel_probe", "res://tests/duel_probe.gd"),
    ("reach_probe", "res://tests/reach_probe.gd"),
    ("feet_probe", "res://tests/feet_probe.gd"),
    ("fighter_skin_check", "res://tests/fighter_skin_check.gd"),
    ("battle_motion_p0_check", "res://tests/battle_motion_p0_check.gd"),
    ("battle_rhythm_check", "res://tests/battle_rhythm_check.gd"),
    ("engine_opt_check", "res://tests/engine_opt_check.gd"),
    ("redraw_gate_check", "res://tests/redraw_gate_check.gd"),
    ("taikou_flow_check", "res://tests/taikou_flow_check.gd"),
    ("taikou_rage_check", "res://tests/taikou_rage_check.gd"),
    ("taikou_rules_check", "res://tests/taikou_rules_check.gd"),
    ("combo_check", "res://scripts/combo_check.gd"),
    ("portrait_wiring_check", "res://tests/portrait_wiring_check.gd"),
]


def summary(text: str) -> str:
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    hits = [ln for ln in lines
            if ("CHECK" in ln.upper() or "PROBE" in ln.upper()
                or "passed" in ln.lower())
            and not ln.startswith("at:")]
    return hits[-1] if hits else (lines[-1] if lines else "<empty output>")


def main() -> int:
    tag = sys.argv[1] if len(sys.argv) > 1 else "run"
    LOGS.mkdir(parents=True, exist_ok=True)
    rows, failures = [], []
    for name, script in CHECKS:
        p = GAME / script.replace("res://", "")
        if not p.is_file():
            failures.append(name)
            rows.append({"name": name, "rc": -1, "ok": False,
                         "summary": "MISSING FILE"})
            print(f"FAIL {name:32s} MISSING FILE")
            continue
        try:
            proc = subprocess.run(
                [str(GODOT), "--headless", "--path", str(GAME),
                 "--script", script],
                capture_output=True, timeout=180, cwd=str(GAME))
            rc = proc.returncode
            text = (proc.stdout + b"\n" + proc.stderr).decode("utf-8", "replace")
        except subprocess.TimeoutExpired:
            rc, text = -1, "TIMEOUT"
        bad = (rc != 0 or "FAIL:" in text or "SCRIPT ERROR" in text
               or "Parse Error" in text or len(text.strip()) < 20)
        rows.append({"name": name, "rc": rc, "ok": not bad,
                     "summary": summary(text)})
        (LOGS / f"{tag}_{name}.log").write_text(text, encoding="utf-8")
        if bad:
            failures.append(name)
        print(("FAIL " if bad else "OK   ") +
              f"{name:32s} rc={rc}  {summary(text)}")
    payload = {"tag": tag, "total": len(CHECKS), "failed": failures,
               "result": "ALL GREEN" if not failures else "FAILED",
               "checks": rows}
    (HERE / "data" / f"all_checks_{tag}.json").write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8")
    (HERE / "logs" / f"自检汇总-{tag}.txt").write_text(
        "\n".join(f"{'OK' if r['ok'] else 'FAIL'} {r['name']:32s} "
                  f"rc={r['rc']} {r['summary']}" for r in rows)
        + f"\n\nTOTAL {len(CHECKS)} checks, {len(failures)} failed\n"
        + f"RESULT: {payload['result']}\n", encoding="utf-8")
    print(f"\nTOTAL {len(CHECKS)} checks, {len(failures)} failed")
    print("ALL_GREEN" if not failures else "FAILED " + ", ".join(failures))
    return 0 if not failures else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== G/run_probe_subviewport.py =====
"""G 路线 P0 技术探针：2D 主视口 + 3D SubViewport 混合渲染能否成立。

只读 F 路线已交付的 player-rigged.glb，复制到隔离工程，
editor 导入后带窗口截一张 1280x720，用 Pillow 证明 3D 区域真的有内容。
用法：python run_probe_subviewport.py
"""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import time
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
F = BAKE / "F路线-Godot驱动层"
PROJECT = HERE / "probe_project_g"
ASSETS = PROJECT / "assets"
SHOTS = HERE / "shots"
LOGS = HERE / "logs"
DATA = HERE / "data"
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
GLB = "player-rigged.glb"
OUT = DATA / "subviewport_probe.json"

VIEW_BOX = (340, 80, 940, 640)     # 3D SubViewport 贴到 2D 的位置
RED_BOX = (40, 120, 220, 540)      # 2D 绘制链锚点


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd: list[str], env: dict, timeout: int, log: Path):
    t0 = time.perf_counter()
    try:
        r = subprocess.run(cmd, env=env, capture_output=True, timeout=timeout)
        code, out, err = r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired as exc:
        code = -1
        out = exc.stdout or b""
        err = (exc.stderr or b"") + b"\n=== TIMEOUT ===\n"
    text = (out + b"\n=== STDERR ===\n" + err).decode("utf-8", "replace")
    log.write_text(text, encoding="utf-8")
    return round(time.perf_counter() - t0, 3), code, text


def pixels(path: Path) -> dict:
    im = Image.open(path).convert("RGB")
    view = im.crop(VIEW_BOX)
    red = im.crop(RED_BOX)
    bright = 0
    colors = set()
    for r, g, b in view.get_flattened_data():
        if r + g + b > 150:
            bright += 1
        colors.add((r // 8, g // 8, b // 8))
    red_px = sum(1 for r, g, b in red.get_flattened_data()
                 if r > 100 and r > g * 2)
    return {
        "w": im.width, "h": im.height,
        "view_bright_px": bright,
        "view_color_bins": len(colors),
        "red_anchor_px": red_px,
    }


def main() -> int:
    assert GODOT.is_file(), GODOT
    for d in (ASSETS, SHOTS, LOGS, DATA):
        d.mkdir(parents=True, exist_ok=True)
    src = F / GLB
    dst = ASSETS / GLB
    assert src.is_file(), src
    shutil.copyfile(src, dst)
    src_sha, dst_sha = sha256(src), sha256(dst)
    assert src_sha == dst_sha

    env = os.environ.copy()
    dt_import, rc_import, _ = run(
        [str(GODOT), "--headless", "--editor", "--quit",
         "--path", str(PROJECT)],
        env, 300, LOGS / "godot_editor_import_g.log")

    env["G_SHOT_DIR"] = str(SHOTS)
    dt, rc, log = run(
        [str(GODOT), "--path", str(PROJECT),
         "--resolution", "1280x720",
         "--script", "res://probes/probe_subviewport.gd",
         "--quit-after", "6000"],
        env, 300, LOGS / "godot_subviewport.log")

    marker = "SV_JSON "
    line = next((l for l in log.splitlines() if l.startswith(marker)), None)
    payload = json.loads(line[len(marker):]) if line else {"error": "no SV_JSON"}
    p = Path(payload.get("path", "")) if payload.get("path") else None
    stats = pixels(p) if p and p.is_file() else {}
    has_gl = "OpenGL API" in log
    errors = log.count("SCRIPT ERROR")

    checks = {
        "import_rc": rc_import == 0,
        "render_rc": rc == 0,
        "has_opengl": has_gl,
        "no_script_errors": errors == 0,
        "no_payload_error": "error" not in payload,
        "texture_drawn": payload.get("tex_ok") is True,
        "save_ok": payload.get("save_error") == 0,
        "size_1280x720": stats.get("w") == 1280 and stats.get("h") == 720,
        "canvas_redrawn": int(payload.get("draw_count", 0)) >= 2,
        "3d_region_nonblank": stats.get("view_bright_px", 0) > 20000,
        "3d_region_textured": stats.get("view_color_bins", 0) > 200,
        "2d_anchor_visible": stats.get("red_anchor_px", 0) > 50000,
        "glb_identical": src_sha == dst_sha,
    }
    ok = all(checks.values())
    OUT.write_text(json.dumps({
        "src": str(src), "src_sha256": src_sha,
        "import": {"seconds": dt_import, "returncode": rc_import},
        "render": {"seconds": dt, "returncode": rc,
                   "has_opengl": has_gl, "script_errors": errors,
                   "headless": False},
        "payload": payload, "pixels": stats,
        "checks": checks, "failed": [k for k, v in checks.items() if not v],
        "ok": ok,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"IMPORT rc={rc_import} {dt_import}s  RENDER rc={rc} {dt}s "
          f"gl={has_gl} errs={errors}")
    print(f"PAYLOAD tex_ok={payload.get('tex_ok')} "
          f"draw_count={payload.get('draw_count')} "
          f"sv_size={payload.get('sv_size')} "
          f"save_error={payload.get('save_error')}")
    print(f"PIXELS {stats}")
    for k, v in checks.items():
        if not v:
            print("  FAIL", k)
    print("SUBVIEWPORT_PROBE_OK" if ok else "SUBVIEWPORT_PROBE_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


