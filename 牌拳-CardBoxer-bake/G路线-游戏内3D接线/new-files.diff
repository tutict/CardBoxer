def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def guard_env() -> dict:
    env = os.environ.copy()
    # 陈旧 pyc 会让「改完立刻跑」导入上一例字节码，误报 GREEN(MISSED)。
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


def run_guard() -> tuple[int, set]:
    if VERIFY_JSON.is_file():
        VERIFY_JSON.unlink()
    p = subprocess.run([PY, str(GUARD)], cwd=str(HERE),
                       env=guard_env(), capture_output=True, timeout=240)
    failed = set()
    if VERIFY_JSON.is_file():
        d = json.loads(VERIFY_JSON.read_text(encoding="utf-8"))
        failed = set(d.get("failed", []))
    return p.returncode, failed


def target(root: str, rel: str) -> Path:
    return (HERE if root == "HERE" else GAME) / rel


def main() -> int:
    selftest = "--selftest" in sys.argv
    cases = list(CASES)
    if selftest:
        # 故意把 M10 的锚点改成不存在，证明 DID NOT RUN 分支有牙。
        i = next(k for k, c in enumerate(cases) if c[0] == "M10")
        c = cases[i]
        cases[i] = (c[0], c[1], c[2], b"NO_SUCH_ANCHOR_999", c[4], c[5])
        out_path = OUT_SELFTEST
    else:
        out_path = OUT_MAIN

    LOGS.mkdir(parents=True, exist_ok=True)
    results, restore_ok = [], []
    for cid, root, rel, needle, mutant, expect in cases:
        p = target(root, rel)
        if not p.is_file():
            results.append({"id": cid, "status": "DID NOT RUN",
                            "reason": "target missing", "expect": expect})
            continue
        raw = p.read_bytes()
        before_sha = sha256(p)
        count = raw.count(needle)
        if count != 1:
            results.append({"id": cid, "status": "DID NOT RUN",
                            "reason": f"anchor_count={count}", "expect": expect,
                            "path": rel})
            continue
        mutated = raw.replace(needle, mutant, 1)
        p.write_bytes(mutated)
        try:
            rc, failed = run_guard()
            if expect is None:
                status = "MISSED (expected)" if not failed else "UNEXPECTED_RED"
            else:
                status = "CAUGHT" if expect in failed else (
                    "MISSED" if not failed else "OTHER")
        finally:
            p.write_bytes(raw)
            ok = sha256(p) == before_sha
            restore_ok.append(ok)
            if not ok:
                print(f"RESTORE FAILED {cid} {rel}", file=sys.stderr)
        results.append({"id": cid, "status": status, "expect": expect,
                        "failed_sample": sorted(failed)[:6],
                        "guard_rc": rc})

    rc_clean, failed_clean = run_guard()
    clean_green = rc_clean == 0 and not failed_clean
    caught = [r for r in results if r["status"] == "CAUGHT"]
    neg = [r for r in results if r["expect"] is None]
    dnr = [r for r in results if r["status"] == "DID NOT RUN"]
    positive = [r for r in results if r["expect"] is not None]
    unproven = (len(positive) - len(caught)) + any(
        r["status"] == "UNEXPECTED_RED" for r in neg)
    ok = (not selftest and unproven == 0 and clean_green
          and all(restore_ok) and len(restore_ok) == len(results))
    selftest_ok = (selftest and len(dnr) >= 1
                   and any(r["status"] == "CAUGHT" for r in results)
                   and clean_green and all(restore_ok))
    payload = {
        "selftest": selftest, "cases": results,
        "total": len(results), "caught": len(caught),
        "did_not_run": len(dnr),
        "negative_controls": len(neg),
        "unproven_positive": unproven,
        "restore_ok": sum(1 for x in restore_ok if x),
        "restore_total": len(restore_ok),
        "clean_rerun": "GREEN" if clean_green else "RED",
        "clean_failed": sorted(failed_clean)[:10],
        "ok": ok, "selftest_ok": selftest_ok,
    }
    out_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2)
                        + "\n", encoding="utf-8")
    for r in results:
        print(f"{r['id']:<4} {r['status']:<20} "
              f"expect={r.get('expect')}")
    print(f"CAUGHT={len(caught)}/{len(positive)} "
          f"DID_NOT_RUN={len(dnr)} restore={sum(restore_ok)}/{len(restore_ok)} "
          f"clean={payload['clean_rerun']}")
    if selftest:
        print("SELFTEST_DID_NOT_RUN_OK" if selftest_ok
              else "SELFTEST_DID_NOT_RUN_FAILED")
        return 0 if selftest_ok else 1
    print("MUTATION_G_OK" if ok else "MUTATION_G_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== G/selftest_did_not_run_g.py =====
"""G 路线：证明 mutation_g.py 的「锚点失配 = 未证明」分支真的有牙。

做法：把 mutation_g.py 复制到**工作区外**（%TEMP%），三处改写：
  ① HERE 固定指向真实工作区（副本不在工作区，__file__ 会指错）；
  ② 结果文件改名，不覆盖主变异证据；
  ③ 把 M10 的 needle 改成一个不存在的字面量。
然后跑**正常模式**（不带 --selftest），期望：
  · 该 case 报 DID NOT RUN 且 reason 是 anchor_count=0
  · 其余 case 仍有 CAUGHT（不是整批崩掉）
  · unproven_positive > 0、ok=False、退出码非 0
  · clean re-run GREEN、还原全部成功
副本放在工作区外，避免「清单覆盖全部文件」判据在守卫运行期间
看到临时文件而连锁报红，把 clean re-run 弄成假红。

用法：python selftest_did_not_run_g.py
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
PY = sys.executable
SRC = HERE / "mutation_g.py"
OUT = HERE / "logs" / "selftest_did_not_run_g.json"
NEGATIVE_RESULT = HERE / "logs" / "mutation_g_selftest_negative.json"
NEGATIVE_LOG = HERE / "logs" / "run_selftest_did_not_run_g.out"


def main() -> int:
    assert SRC.is_file(), SRC
    text = SRC.read_text(encoding="utf-8")
    a = "HERE = Path(__file__).resolve().parent"
    b = f'HERE = Path(r"{HERE}")'
    assert text.count(a) == 1, f"HERE anchor: {text.count(a)}"
    text = text.replace(a, b, 1)
    a2 = 'OUT_MAIN = LOGS / "mutation_g_result.json"'
    b2 = 'OUT_MAIN = LOGS / "mutation_g_selftest_negative.json"'
    assert text.count(a2) == 1, f"OUT anchor: {text.count(a2)}"
    text = text.replace(a2, b2, 1)
    a3 = 'b"const DEFAULT_SIDE_YAW := 55.0"'
    b3 = 'b"const DEFAULT_SIDE_YAW := 999.0_NO_SUCH"'
    assert text.count(a3) == 1, f"needle anchor: {text.count(a3)}"
    text = text.replace(a3, b3, 1)

    tmp = Path(tempfile.mkdtemp(prefix="fa-g-selftest-"))
    script = tmp / "mutation_g_negative.py"
    script.write_bytes(text.encode("utf-8"))
    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    if NEGATIVE_RESULT.is_file():
        NEGATIVE_RESULT.unlink()
    p = subprocess.run([PY, str(script)], cwd=str(HERE), env=env,
                       capture_output=True, timeout=300)
    out = (p.stdout + b"\n--- STDERR ---\n" + p.stderr).decode(
        "utf-8", "replace")
    NEGATIVE_LOG.write_text(out, encoding="utf-8")

    d = json.loads(NEGATIVE_RESULT.read_text(encoding="utf-8")) \
        if NEGATIVE_RESULT.is_file() else {}
    dnr = [r for r in d.get("cases", []) if r.get("status") == "DID NOT RUN"]
    caught = [r for r in d.get("cases", []) if r.get("status") == "CAUGHT"]
    checks = {
        "exit_nonzero": p.returncode != 0,
        "not_selftest_mode": d.get("selftest") is False,
        "has_did_not_run": len(dnr) == 1,
        "dnr_is_m10": any(r.get("id") == "M10" for r in dnr),
        "dnr_reason_anchor": any("anchor_count=0" in r.get("reason", "")
                                 for r in dnr),
        "other_cases_still_caught": len(caught) >= 10,
        "did_not_run_counted_unproven": d.get("unproven_positive", 0) >= 1,
        "overall_not_ok": d.get("ok") is False,
        "clean_rerun_green": d.get("clean_rerun") == "GREEN",
        "restore_all_ok": d.get("restore_ok") == d.get("restore_total")
                          and d.get("restore_total", 0) > 0,
        "output_marker": "MUTATION_G_FAILED" in out,
    }
    failed = [k for k, v in checks.items() if not v]
    ok = not failed
    OUT.write_text(json.dumps({
        "checks": checks, "failed": failed,
        "did_not_run": len(dnr), "caught": len(caught),
        "unproven_positive": d.get("unproven_positive"),
        "clean_rerun": d.get("clean_rerun"),
        "ok": ok,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    for k in failed:
        print("  FAIL", k)
    print(f"SELFTEST {len(checks) - len(failed)}/{len(checks)} "
          f"dnr={len(dnr)} caught={len(caught)}")
    print("DID_NOT_RUN_BRANCH_OK" if ok else "DID_NOT_RUN_BRANCH_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== G/make_filelist_g.py =====
"""生成 G 路线交付文件清单与新增脚本 diff。

自指纪律：清单 / diff / logs / __pycache__ / .godot / orig / baseline_project
一律排除，否则「清单写好后重跑」会把自己算进去，清单永远不稳定。
另排除 probe_project_g/.godot 这类引擎缓存目录（按目录名，不按路径列）。

用法：python make_filelist_g.py
"""
from __future__ import annotations

import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = HERE.parent / "牌拳-CardBoxer"
LIST = HERE / "文件清单.txt"
DIFF = HERE / "new-files.diff"
EXCLUDE_NAMES = {"文件清单.txt", "new-files.diff"}
EXCLUDE_DIRS = {"logs", ".godot", "__pycache__", "orig", "baseline_project"}
EXCLUDE_PREFIX = ("logs/", "orig/", "baseline_project/")

# 本轮新增/改动的脚本与 GDScript，拼成可复算的 diff。
DIFF_SCRIPTS = [
    "make_baseline_g.py", "run_all_checks_g.py", "run_probe_subviewport.py",
    "install_assets_g.py", "make_baseline_project_g.py", "capture_g.py",
    "compare_g.py", "diag_ab.py", "run_static_ab_g.py",
    "run_three_d_probe.py", "compare_same_tree_g.py",
    "run_side_view_probe.py", "make_side_board.py",
    "run_side_stance_probe.py", "make_stance_board.py",
    "run_side_stance_scan.py", "make_stance_scan_board.py",
    "verify_g.py", "mutation_g.py", "selftest_did_not_run_g.py",
    "make_filelist_g.py", "crosscheck_filelist_g.py",
]
DIFF_GAME_GD = [
    "scripts/fighter_3d_layer.gd",
    "tests/three_d_probe.gd",
    "tests/side_view_probe.gd",
    "tests/side_stance_probe.gd",
]
DIFF_PROBE_GD = [
    "probe_project_g/project.godot",
    "probe_project_g/probes/probe_subviewport.gd",
]


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def entries() -> list[Path]:
    out = []
    for p in sorted(HERE.rglob("*")):
        if not p.is_file() or p.name in EXCLUDE_NAMES:
            continue
        rel = p.relative_to(HERE)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        if str(rel).replace("\\", "/").startswith(EXCLUDE_PREFIX):
            continue
        out.append(p)
    return out


def main() -> int:
    rows = []
    for p in entries():
        rel = str(p.relative_to(HERE)).replace("\\", "/")
        rows.append(f"{rel}\t{p.stat().st_size}\t{sha256(p)}")
    header = [
        "# G 路线 · 游戏内 3D 接线与侧面战斗 · 交付文件清单",
        "# 格式: 相对路径<TAB>字节<TAB>sha256",
        "# 排除: 本清单 / new-files.diff / logs / orig / baseline_project /",
        "#       .godot / __pycache__",
        "",
    ]
    # 二进制写：write_text 在 Windows 下会转 CRLF，清单稳定性判据用
    # bytes 逐字节比对，两种换行口径不一致会永远假红。
    LIST.write_bytes(("\n".join(header + rows) + "\n").encode("utf-8"))

    parts = []
    for name in DIFF_SCRIPTS:
        p = HERE / name
        if p.is_file():
            parts.append(f"===== G/{name} =====\n"
                         + p.read_text(encoding="utf-8"))
    for rel in DIFF_GAME_GD:
        p = GAME / rel
        if p.is_file():
            parts.append(f"===== GAME/{rel} =====\n"
                         + p.read_text(encoding="utf-8"))
    for rel in DIFF_PROBE_GD:
        p = HERE / rel
        if p.is_file():
            parts.append(f"===== G/{rel} =====\n"
                         + p.read_text(encoding="utf-8"))
    DIFF.write_bytes(("\n\n".join(parts) + "\n").encode("utf-8"))

    # 稳定性：立刻按同一口径重算一遍，与刚写出的清单逐字节比。
    again = ("\n".join(header + [
        f"{str(p.relative_to(HERE)).replace(chr(92), '/')}\t"
        f"{p.stat().st_size}\t{sha256(p)}" for p in entries()
    ]) + "\n").encode("utf-8")
    stable = LIST.read_bytes() == again
    print(f"FILELIST_ENTRIES={len(rows)} DIFF_BYTES={DIFF.stat().st_size}")
    print(f"STABLE={stable}")
    print("FILELIST_STABLE_OK" if stable else "FILELIST_UNSTABLE")
    return 0 if stable else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== G/crosscheck_filelist_g.py =====
"""G 路线：不经 make_filelist_g.py 的代码，独立复核清单每一行。

目的：清单生成脚本自己写自己验，逻辑错了会自洽地假绿。这里从
文件系统重新枚举，按同一口径独立算 size/sha256，逐行比对。

用法：python crosscheck_filelist_g.py
"""
from __future__ import annotations

import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
LIST = HERE / "文件清单.txt"
EXCLUDE_NAMES = {"文件清单.txt", "new-files.diff"}
EXCLUDE_DIRS = {"logs", ".godot", "__pycache__", "orig", "baseline_project"}


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def main() -> int:
    assert LIST.is_file(), LIST
    rows = {}
    for line in LIST.read_bytes().decode("utf-8").splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        rel, size, sha = line.split("\t")
        rows[rel] = (int(size), sha)
    actual = {}
    for p in HERE.rglob("*"):
        if not p.is_file() or p.name in EXCLUDE_NAMES:
            continue
        rel = p.relative_to(HERE)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        key = str(rel).replace("\\", "/")
        actual[key] = (p.stat().st_size, sha256(p))
    bad = [k for k, v in rows.items()
           if k not in actual or actual[k] != v]
    extra = sorted(set(actual) - set(rows))
    missing = sorted(set(rows) - set(actual))
    ok = not bad and not extra and not missing
    print(f"ROWS={len(rows)} ACTUAL={len(actual)} BAD={len(bad)} "
          f"EXTRA={len(extra)} MISSING={len(missing)}")
    for k in bad[:5]:
        print("  BAD", k)
    for k in extra[:5]:
        print("  EXTRA", k)
    print("CROSSCHECK_OK" if ok else "CROSSCHECK_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


