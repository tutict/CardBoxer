extends SceneTree
const FighterScript = preload("res://scripts/fighter.gd")
const NativeScript = preload("res://scripts/native_motion.gd")
const PresentationScript = preload("res://scripts/battle_presentation.gd")

func _initialize() -> void:
	var library = NativeScript.new()
	assert(library.load_data())
	var controller = PresentationScript.new()
	controller.setup(library)
	controller.reset(1)
	var forward = FighterScript.new()
	var backward = FighterScript.new()
	forward.reset_for_round(430, 1)
	backward.reset_for_round(430, 1)
	forward.tick(0.05, 1.0, true)
	backward.tick(0.05, -1.0, true)
	var context := {"mode":"realtime"}
	var sf: Dictionary = forward.presentation_snapshot()
	var sb: Dictionary = backward.presentation_snapshot()
	var vf: Dictionary = controller.sample("player", sf, context)
	var vb: Dictionary = controller.sample("player", sb, context)
	print("REVIEW_WALK opposite_displacements=", forward.position.x - 430, "/", backward.position.x - 430, " snapshots_equal=", sf == sb, " poses_equal=", vf.pose == vb.pose)
	controller.advance(0.15, context)
	var idle: Dictionary = controller.sample("player", {"state":0,"facing":1}, context)
	forward.play_card("jab")
	var immediate: Dictionary = controller.sample("player", forward.presentation_snapshot(), context)
	var stance: Dictionary = library.sample("player", "stance", 0.0)
	print("REVIEW_TRANSITION idle_to_action=", idle.clip_id, "->", immediate.clip_id, " action_exact_stance=", immediate.pose.rotations == stance.rotations, " previous_pose_equal=", immediate.pose.rotations == idle.pose.rotations)
	forward.free()
	backward.free()
	quit()
