     '\t# 输家 / 平局 / 亮牌阶段一律 stance（73 帧表里没有受击轨道）。\n'
     '\tif tk_rhythm_winner == "player" and tk_rhythm_t >= 0.0 \\\n'
     '\t\t\tand tk_motion_id != "" and tk_rhythm_t <= Rhythm.ATTACK_S:\n'
