          " tex_same=", payload.get("tex_same"))
    print("MESH_SIG player=", payload.get("player_mesh_sig"))
    print("MESH_SIG foe=   ", payload.get("foe_mesh_sig"))
    for r in rows:
        print(f"SHOT {r['name']:<14} {r['w']}x{r['h']} "
