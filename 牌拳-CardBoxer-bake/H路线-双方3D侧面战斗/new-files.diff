     '\tif tk_rhythm_t >= 0.0 and tk_motion_id != "" \\\n'
     '\t\t\tand tk_rhythm_t <= Rhythm.ATTACK_S:\n'
     '\t\tvar n: int = int(motion_3d["cards"][tk_motion_id]["frames"])\n'
     '\t\tvar f := clampi(int(tk_rhythm_t / Rhythm.ATTACK_S * float(n - 1)), 0, n - 1)\n'
     '\t\tif tk_rhythm_winner == "player":\n'
     '\t\t\tcard = tk_motion_id\n'
     '\t\t\tframe = f\n'
     '\t\telif tk_rhythm_winner == "enemy":\n'
     '\t\t\tfoe_card = tk_motion_id\n'
     '\t\t\tfoe_frame = f\n'
     '\tif layer_3d != null:\n'
     '\t\tlayer_3d.position = player.position + player.visual_shift\n'
     '\t\tlayer_3d.apply(card, frame)\n'
     '\tif layer_3d_foe != null:\n'
     '\t\tlayer_3d_foe.position = enemy.position + enemy.visual_shift\n'
     '\t\tlayer_3d_foe.apply(foe_card, foe_frame)\n'),
]


def main() -> int:
    OUT.parent.mkdir(parents=True, exist_ok=True)
    before = {}
    for p in (ARENA, LAYER, FIGHTER):
        rel = str(p.relative_to(GAME)).replace("\\", "/")
        q = BACKUP / rel
        before[rel] = {"sha256": sha(p),
                       "backup_sha256": sha(q) if q.is_file() else None,
                       "backup_matches": q.is_file() and sha(q) == sha(p)}
    assert all(v["backup_matches"] for v in before.values()), before

    # 先全文预检：所有 needle 都必须在当前盘上恰好命中 1 次。
    resolved = []
    for path, name, old, new in PATCHES:
        data = path.read_bytes()
        o_lf, n_lf = norm(old), norm(new)
        hits = []
        for eol in (b"\n", b"\r\n"):
            o = o_lf.replace(b"\n", eol)
            if data.count(o) == 1:
                hits.append((eol, o, n_lf.replace(b"\n", eol)))
        assert len(hits) >= 1, f"anchor not found: {name}"
        resolved.append((path, name, hits[0]))
    applied = []
    for path, name, (eol, o, n) in resolved:
        data = path.read_bytes()
        assert data.count(o) == 1, name
        path.write_bytes(data.replace(o, n, 1))
        applied.append({"file": path.name, "patch": name,
                        "eol": "CRLF" if eol == b"\r\n" else "LF"})

    layer_src = LAYER.read_text(encoding="utf-8")
    arena_src = ARENA.read_text(encoding="utf-8")
    checks = {
        "fighter_gd_untouched": sha(FIGHTER) == before[
            "scripts/fighter.gd"]["sha256"],
        "switch_default_off": (
            'use_3d = OS.get_environment("CARD_BOXER_3D") != ""' in arena_src),
        "override_default_false": (
            "var draw_3d_override := false" in FIGHTER.read_text(
                encoding="utf-8")),
        "sync_hook_count": arena_src.count("_sync_3d_layer()") >= 2,
        "G_shape_side_yaw_55": "const DEFAULT_SIDE_YAW := 55.0" in layer_src,
        "G_shape_side_flip_false": (
            "const DEFAULT_SIDE_FLIP := false" in layer_src),
        "G_shape_stance_bias": (
            "var stance_bias_deg: Dictionary = DEFAULT_STANCE_BIAS.duplicate()"
            in layer_src),
        "G_shape_apply_frame_before_bias": (
            "drv.apply_frame(c, f)" in layer_src
            and "_apply_stance_bias()" in layer_src),
        "G_shape_bone_pose_rotation": (
            "drv.skel.set_bone_pose_rotation(i, cur * q)" in layer_src),
        "H_foe_yaw": "const DEFAULT_FOE_YAW := -55.0" in layer_src,
        "H_foe_glb": 'FOE_GLB_PATH := "res://assets/3d/foe-rigged.glb"'
                     in layer_src,
        "H_configure": "func configure(" in layer_src,
        "H_two_layers": ("layer_3d_foe" in arena_src
                         and "motion_3d_foe" in arena_src),
        "H_two_motions": ('res://data/motion_input_foe.json' in arena_src
                          and 'res://data/motion_input.json' in arena_src),
        "H_arena_uses_layer_constants": (
            "Fighter3DLayerScript.FOE_GLB_PATH" in arena_src
            and "Fighter3DLayerScript.DEFAULT_FOE_YAW" in arena_src),
        "H_sync_early_return_preserved": (
            "or motion_3d.is_empty():" in arena_src),
        "H_enemy_override": "enemy.draw_3d_override = true" in arena_src,
        "H_enemy_winner_branch": 'tk_rhythm_winner == "enemy"' in arena_src,
        "H_layer_loads_glb_path": "var res := load(glb_path)" in layer_src,
    }
    after = {str(p.relative_to(GAME)).replace("\\", "/"): sha(p)
             for p in (ARENA, LAYER, FIGHTER)}
    report = {"before": before, "after": after, "applied": applied,
              "checks": checks,
              "failed": [k for k, v in checks.items() if not v],
              "ok": all(checks.values())}
    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for a in applied:
        print("PATCH", a["file"], a["patch"], a["eol"])
    for k, v in checks.items():
        print("CHECK", k, v)
    print("PATCH_GAME_H_OK" if report["ok"] else "PATCH_GAME_H_FAILED")
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/diag_glb_pair_h.py =====
"""H 路线：比对两份 GLB 的贴图字节与 POSITION bbox，判定是否内容串味。"""
from __future__ import annotations

import hashlib
import json
import struct
from pathlib import Path

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
PAIR = {
    "player": BAKE / "F路线-Godot驱动层" / "player-rigged.glb",
    "foe": HERE / "foe-rigged.glb",
}
OUT = HERE / "data" / "glb_pair_h.json"


def parse(p: Path):
    data = p.read_bytes()
    assert struct.unpack_from("<I", data, 0)[0] == 0x46546C67
    off, chunks = 12, []
    while off < len(data):
        clen, ctype = struct.unpack_from("<I4s", data, off)
        off += 8
        chunks.append((ctype, data[off:off + clen]))
        off += clen
    js = json.loads(next(c for t, c in chunks if t == b"JSON").decode("utf-8"))
    binary = next(c for t, c in chunks if t == b"BIN\x00")
    return js, binary, len(data)


def main() -> int:
    out = {}
    for tag, p in PAIR.items():
        js, binary, size = parse(p)
        images = []
        for im in js.get("images", []):
            bv = js["bufferViews"][im["bufferView"]]
            off = bv.get("byteOffset", 0)
            blob = binary[off:off + bv["byteLength"]]
            images.append({"name": im.get("name"), "bytes": len(blob),
                           "sha256": hashlib.sha256(blob).hexdigest()})
        prim = js["meshes"][0]["primitives"][0]
        acc = js["accessors"][prim["attributes"]["POSITION"]]
        out[tag] = {"file": p.name, "bytes": size,
                    "images": images, "verts": acc["count"],
                    "pos_min": acc.get("min"), "pos_max": acc.get("max"),
                    "skin_joints": len(js["skins"][0]["joints"])
                    if js.get("skins") else 0}
    psha = {x["sha256"] for x in out["player"]["images"]}
    fsha = {x["sha256"] for x in out["foe"]["images"]}
    report = {"pair": out,
              "image_sets_identical": psha == fsha,
              "shared_image_count": len(psha & fsha),
              "bbox_different": (out["player"]["pos_min"] != out["foe"]["pos_min"]
                                 or out["player"]["pos_max"]
                                 != out["foe"]["pos_max"]),
              "verts_different": out["player"]["verts"] != out["foe"]["verts"]}
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for tag, d in out.items():
        print(tag, d["file"], d["bytes"], "B verts=", d["verts"],
              "bbox=", d["pos_min"], d["pos_max"])
        for i in d["images"]:
            print("   IMG", i["name"], i["bytes"], i["sha256"][:16])
    print("image_sets_identical", report["image_sets_identical"],
          "shared", report["shared_image_count"],
          "bbox_different", report["bbox_different"],
          "verts_different", report["verts_different"])
    print("GLB_PAIR_DISTINCT_OK" if (not report["image_sets_identical"]
                                    and report["bbox_different"]
                                    and report["verts_different"])
          else "GLB_PAIR_SUSPICIOUS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== H/diag_roi_h.py =====
"""H 路线：用 off vs both-stance 的逐列差异自动定位两个 3D 角色的 x 区间。

肉眼按缩放后的预览图估 ROI 会偏（1280 原图被缩到约 1080 显示），
所以这里不猜坐标：逐列数差异像素，找出两段连续峰。
输出 data/roi_h.json 供 make_zoom_h.py 与 verify_h.py 使用。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops

HERE = Path(__file__).resolve().parent
SHOTS = HERE / "shots" / "two_side_ab"
OFF = SHOTS / "h-off.png"
ON = SHOTS / "h-both-stance.png"
OUT = HERE / "data" / "roi_h.json"
Y0, Y1 = 280, 545


def main() -> int:
    a = Image.open(OFF).convert("RGB").crop((0, Y0, 1280, Y1))
    b = Image.open(ON).convert("RGB").crop((0, Y0, 1280, Y1))
    d = ImageChops.difference(a, b)
    cols = []
    for x in range(1280):
        col = d.crop((x, 0, x + 1, Y1 - Y0))
        cols.append(sum(1 for px in col.get_flattened_data()
                        if sum(px) > 18))
    # 阈值 = 峰值的 12%，把连续段合并（允许 12 px 空洞）
    peak = max(cols)
    thr = max(6, int(peak * 0.12))
    hot = [c > thr for c in cols]
    segs = []
    start = None
    for x, v in enumerate(hot):
        if v and start is None:
            start = x
        if not v and start is not None:
            segs.append([start, x])
            start = None
    if start is not None:
        segs.append([start, 1280])
    merged = []
    for s in segs:
        if merged and s[0] - merged[-1][1] <= 12:
            merged[-1][1] = s[1]
        else:
            merged.append(list(s))
    big = [s for s in merged if s[1] - s[0] >= 40]
    boxes = [[s[0], Y0, s[1], Y1] for s in big[:2]]
    report = {"peak_col_diff": peak, "threshold": thr,
              "segments": big, "boxes": boxes,
              "two_regions": len(boxes) == 2,
              "left_box": boxes[0] if boxes else None,
              "right_box": boxes[1] if len(boxes) > 1 else None}
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("PEAK", peak, "THR", thr, "SEGMENTS", big)
    print("BOXES", boxes, "two_regions", report["two_regions"])
    print("ROI_H_OK" if report["two_regions"] else "ROI_H_FAILED")
    return 0 if report["two_regions"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/make_zoom_h.py =====
"""H 路线：把双侧角色的 ROI 放大，并做像素级「两人是否同一造型」核对。

左右 ROI 取同样尺寸，逐像素比对；若差异很小就说明渲染串味了。
输出 boards/H-双侧角色特写.png 与 data/zoom_h.json。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
SHOT = HERE / "shots" / "two_side_ab" / "h-both-stance.png"
OUT = HERE / "boards" / "H-双侧角色特写.png"
DATA = HERE / "data" / "zoom_h.json"
FONT = Path(r"C:\Windows\Fonts\msyh.ttc")
ROI_JSON = HERE / "data" / "roi_h.json"


def main() -> int:
    assert SHOT.is_file() and ROI_JSON.is_file()
    OUT.parent.mkdir(parents=True, exist_ok=True)
    DATA.parent.mkdir(parents=True, exist_ok=True)
    # 不手填 ROI：按 diag_roi_h.py 从 off/on 逐列差异自动定位的两个区域。
    roi = json.loads(ROI_JSON.read_text(encoding="utf-8"))
    assert roi["two_regions"] is True, roi
    left_box, right_box = roi["boxes"][:2]
    im = Image.open(SHOT).convert("RGB")
    w = min(left_box[2] - left_box[0], right_box[2] - right_box[0])
    h = min(left_box[3] - left_box[1], right_box[3] - right_box[1])
    def centered(box):
        cx = (box[0] + box[2]) // 2
        cy = (box[1] + box[3]) // 2
        return (cx - w // 2, cy - h // 2,
                cx - w // 2 + w, cy - h // 2 + h)
    LEFT, RIGHT = centered(left_box), centered(right_box)
    a = im.crop(LEFT)
    b = im.crop(RIGHT)
    assert a.size == b.size, (a.size, b.size)
    diff = ImageChops.difference(a, b)
    changed = sum(1 for px in diff.get_flattened_data()
                  if px != (0, 0, 0))
    total = a.width * a.height
    ratio = changed / total

    z = 2
    w, h = a.width * z, a.height * z
    pad, label = 24, 40
    canvas = Image.new("RGB", (2 * w + 3 * pad, h + label + 2 * pad),
                       (20, 24, 34))
    d = ImageDraw.Draw(canvas)
    f = ImageFont.truetype(str(FONT), 22) if FONT.is_file() \
        else ImageFont.load_default()
    canvas.paste(a.resize((w, h), Image.LANCZOS), (pad, pad))
    canvas.paste(b.resize((w, h), Image.LANCZOS), (2 * pad + w, pad))
    d.text((pad + 6, pad + h + 6), "左侧 · 玩家 V4b（+55°）",
           font=f, fill=(160, 225, 205))
    d.text((2 * pad + w + 6, pad + h + 6), "右侧 · 对手怪（-55°）",
           font=f, fill=(160, 225, 205))
    canvas.save(OUT)

    report = {"shot": SHOT.name, "left_roi": list(LEFT),
              "right_roi": list(RIGHT), "roi_size": list(a.size),
              "auto_boxes": [left_box, right_box],
              "changed_px": changed, "total_px": total,
              "changed_ratio": round(ratio, 4),
              # 注：这个比值含擂台背景差异，只作「不是同一张图」的辅助；
              # 「两个不同模型」的硬证据是引擎自报的 glb_path / mesh_name。
              "distinct": ratio > 0.15,
              "board": OUT.name, "board_bytes": OUT.stat().st_size}
    DATA.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                    encoding="utf-8")
    print("ROI", a.size, "changed_px", changed, "/", total,
          "ratio", round(ratio, 4), "distinct", report["distinct"])
    print("ZOOM_H_OK" if report["distinct"] else "ZOOM_H_FAILED")
    return 0 if report["distinct"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/diag_cross_h.py =====
"""H 路线：双侧模式 vs 单侧隔离模式，逐侧 ROI 像素对账（v2 订正版）。

v1（备份在 data/cross_h_v1_retired.json）用「跨进程 ROI 绝对像素等价」
当判据：要求 left_both ≈ left_only_player、right_both ≈ right_only_foe。
实测四个 ratio 全在 0.40~0.54，报 CROSS_H_SUSPICIOUS。这不是串味，
是口径错了：BOTH 与 ONLY_P / ONLY_F 分别来自三个不同的 Godot 进程，
每次启动随机化全局 RNG，观众席 / 灯光相位 / 手牌都会变，跨进程整帧
像素等价在 G 路线就已经退役（G 验证记录踩坑节）。

v2 改判据：
1. 四个 ratio 只作事实记录，不再要求绝对值 < 0.20。
2. 改用**方向性**判据：双侧左侧更接近「只有玩家」而不是「只有对手」，
   双侧右侧更接近「只有对手」而不是「只有玩家」，且差值 > 0.05。
   跨进程噪声是共同基线，排序仍然有意义。
3. 真正的「两个 SubViewport 互不串味」硬证据是同进程同树的
   data/vp_diag_h.json：隐藏一侧时另一侧 ROI changed_px 精确为 0。

输出 data/cross_h.json，带 retired_metric 字段供 verify_h.py 钉住，
防止哪天又把跨进程绝对等价当 PASS 复用。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops

HERE = Path(__file__).resolve().parent
SHOTS = HERE / "shots"
BOTH = SHOTS / "two_side_ab" / "h-both-stance.png"
ONLY_P = SHOTS / "isolate" / "player" / "h-both-stance.png"
ONLY_F = SHOTS / "isolate" / "foe" / "h-both-stance.png"
ROI = json.loads((HERE / "data" / "roi_h.json").read_text(encoding="utf-8"))
OUT = HERE / "data" / "cross_h.json"

RETIRED = ("absolute ROI pixel identity across separate Godot processes "
           "(v1: ratio < 0.20)")


def diff(a: Path, b: Path, box) -> dict:
    ia = Image.open(a).convert("RGB").crop(box)
    ib = Image.open(b).convert("RGB").crop(box)
    d = ImageChops.difference(ia, ib)
    changed = sum(1 for px in d.get_flattened_data() if sum(px) > 18)
    total = ia.width * ia.height
    return {"changed_px": changed, "total_px": total,
            "ratio": round(changed / total, 4)}


def main() -> int:
    boxes = ROI["boxes"]
    assert len(boxes) == 2
    left, right = boxes[0], boxes[1]
    out = {
        "left_both_vs_only_player": diff(BOTH, ONLY_P, left),
        "left_both_vs_only_foe": diff(BOTH, ONLY_F, left),
        "right_both_vs_only_foe": diff(BOTH, ONLY_F, right),
        "right_both_vs_only_player": diff(BOTH, ONLY_P, right),
        "left_roi": left, "right_roi": right,
        "retired_metric": RETIRED,
        "primary_evidence": "data/vp_diag_h.json (same-process A/B, "
                            "untouched ROI changed_px == 0)",
        "v1_backup": "data/cross_h_v1_retired.json",
    }
    lp = out["left_both_vs_only_player"]["ratio"]
    lf = out["left_both_vs_only_foe"]["ratio"]
    rf = out["right_both_vs_only_foe"]["ratio"]
    rp = out["right_both_vs_only_player"]["ratio"]
    out["directional_margin"] = {
        "left": round(lf - lp, 4), "right": round(rp - rf, 4)}
    # 方向性判据：对应单侧必须比反侧更接近，且余量不是浮点抖动。
    out["checks"] = {
        "left_matches_player_more": lp < lf,
        "right_matches_foe_more": rf < rp,
        "left_margin_above_noise": (lf - lp) > 0.05,
        "right_margin_above_noise": (rp - rf) > 0.05,
        "no_absolute_identity_claim": "retired_metric" in out,
    }
    out["ok"] = all(out["checks"].values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for k, v in out.items():
        if isinstance(v, dict):
            print(k, v)
    print("MARGIN", out["directional_margin"], "ok", out["ok"])
    print("CROSS_H_V2_OK" if out["ok"] else "CROSS_H_V2_FAILED")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


