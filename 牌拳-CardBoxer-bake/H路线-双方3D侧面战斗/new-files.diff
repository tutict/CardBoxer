===== H/mutation_h.py =====
"""H 路线变异验证：逐条改坏被守卫的对象，确认 verify_h.py 真的报红。

纪律（沿用 G/F 路线）：
- 用二进制读写 + sha256 证明还原，不用 read_text/write_text（换行会被转）。
- needle 匹配 0 次 = DID NOT RUN，计入未证明，不许直接崩、不许算 CAUGHT。
- 每组都还原后才进下一组；最后 clean re-run 必须 GREEN。
- 变异体必须仍能解析：改 JSON 布尔/数值、改 GDScript 字面量，不制造语法错。

H_ROOT 环境变量供 selftest_did_not_run_h.py 把副本放到 logs/ 下时
仍指向真正的工作区；正常运行时不设。
用法：python mutation_h.py
"""
from __future__ import annotations

import hashlib
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(os.environ.get("H_ROOT", str(Path(__file__).resolve().parent)))
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
VERIFY = HERE / "verify_h.py"

# (编号, 目标, needle, mutant)；目标 "GAME:xxx" 表示游戏工程内文件。
CASES = [
    ("M01_retired_metric_renamed", "data/cross_h.json",
     b'"retired_metric":', b'"retired_v1_metric":'),
    ("M02_untouched_roi_not_zero", "data/vp_diag_h.json",
     b'"changed_px": 0', b'"changed_px": 1'),
    ("M03_static_ab_pixels_changed", "data/static_ab_h.json",
     b'"changed_pixels": 0', b'"changed_pixels": 1'),
    ("M04_all_checks_not_green", "data/all_checks_h.json",
     b'"result": "ALL GREEN"', b'"result": "FAILED"'),
    ("M05_foe_yaw_flipped", "data/two_side_ab.json",
     b'"foe_yaw": -55.0', b'"foe_yaw": 55.0'),
    ("M06_basecolor_identical", "data/identity_h.json",
     b'"basecolor_thumb_mae": 75.3802',
     b'"basecolor_thumb_mae": 0.0'),
    ("M07_arena_uses_player_yaw", "GAME:scripts/arena.gd",
     b"Fighter3DLayerScript.DEFAULT_FOE_YAW",
     b"Fighter3DLayerScript.DEFAULT_SIDE_YAW"),
    ("M08_layer_loads_fixed_glb", "GAME:scripts/fighter_3d_layer.gd",
     b"var res := load(glb_path)", b"var res := load(GLB_PATH)"),
    ("M09_copy_not_identical", "data/install_assets_h.json",
     b'"identical": true', b'"identical": false'),
    ("M10_v1_negative_result_erased", "data/cross_h_v1_retired.json",
     b'"ok": false', b'"ok": true'),
    ("M11_foe_apose_equals_player", "data/apose_crosscheck_h.json",
     b'"foe_apose_not_equal_player": true',
     b'"foe_apose_not_equal_player": false'),
    ("M12_glb_has_animations", "data/foe_gltf_inspection.json",
     b'"zero_animations": true', b'"zero_animations": false'),
    ("M13_roi_not_two_regions", "data/roi_h.json",
     b'"two_regions": true', b'"two_regions": false'),
]


def resolve(target: str) -> Path:
    if target.startswith("GAME:"):
        return GAME / target[5:]
    return HERE / target


def digest(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def run_verify() -> tuple[int, str]:
    p = subprocess.run([sys.executable, "-u", str(VERIFY)],
                       capture_output=True, timeout=120)
    return p.returncode, (p.stdout + p.stderr).decode("utf-8", "replace")


def main() -> int:
    assert VERIFY.is_file(), VERIFY
    caught = 0
    did_not_run = []
    restore_ok = 0
    restore_total = 0
    for name, target, needle, mutant in CASES:
        path = resolve(target)
        if not path.is_file():
            did_not_run.append(name + ":FILE_MISSING")
            print(f"{name} DID NOT RUN (missing file)")
            continue
        orig = path.read_bytes()
        count = orig.count(needle)
        if count == 0:
            did_not_run.append(name + ":ANCHOR_MISS")
            print(f"{name} DID NOT RUN (anchor not found)")
            continue
        path.write_bytes(orig.replace(needle, mutant, 1))
        restore_total += 1
        try:
            rc, out = run_verify()
            red = rc != 0 and "H_NOT_VERIFIED" in out
            if red:
                caught += 1
            print(f"{name} {'CAUGHT' if red else 'MISSED'} rc={rc}")
        finally:
            path.write_bytes(orig)
            if path.read_bytes() == orig and digest(path.read_bytes()) == digest(orig):
                restore_ok += 1

    rc_clean, out_clean = run_verify()
    clean_green = rc_clean == 0 and "H_VERIFIED" in out_clean
    total = len(CASES)
    ok = (caught == total and not did_not_run
          and restore_ok == restore_total == total and clean_green)
    print(f"CAUGHT={caught}/{total} DID_NOT_RUN={len(did_not_run)} "
          f"restore={restore_ok}/{restore_total} "
          f"clean={'GREEN' if clean_green else 'RED'}")
    for x in did_not_run:
        print("  DNR", x)
    print("MUTATION_H_OK" if ok else "MUTATION_H_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/selftest_did_not_run_h.py =====
"""证明 mutation_h.py 的「锚点失配 = DID NOT RUN」分支真的有牙。

做法：复制一份变异脚本到 logs/（清单排除目录），把 M01 的 needle
改成一个盘上绝不会出现的字符串，用 H_ROOT 指回真工作区后跑它。
期望：M01 被标 DID NOT RUN、汇总 MUTATION_H_FAILED（不算通过）、
其余 12 组照常 CAUGHT 并逐字节还原、clean re-run 仍 GREEN。

用法：python selftest_did_not_run_h.py
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SRC = HERE / "mutation_h.py"
COPY = HERE / "logs" / "selftest_mutation_h.py"
NEEDLE = '"retired_metric":'
ABSENT = '"retired_metric_ABSENT999":'


def main() -> int:
    src = SRC.read_text(encoding="utf-8")
    anchor = src.find("CASES = [")
    assert anchor > 0, "CASES block not found"
    head, tail = src[:anchor], src[anchor:]
    assert NEEDLE in tail, "needle literal not in CASES"
    patched = head + tail.replace(NEEDLE, ABSENT, 1)
    assert ABSENT in patched and patched != src
    COPY.parent.mkdir(parents=True, exist_ok=True)
    COPY.write_text(patched, encoding="utf-8")

    env = os.environ.copy()
    env["H_ROOT"] = str(HERE)
    p = subprocess.run([sys.executable, "-u", str(COPY)],
                       capture_output=True, timeout=300, env=env)
    out = (p.stdout + p.stderr).decode("utf-8", "replace")
    (HERE / "logs" / "selftest_did_not_run_h.out").write_text(
        out, encoding="utf-8")

    checks = {
        "m01_marked_did_not_run": "M01_retired_metric_renamed DID NOT RUN" in out,
        "dnr_counted": "DID_NOT_RUN=1" in out,
        "not_reported_as_ok": "MUTATION_H_FAILED" in out,
        "other_cases_still_caught": "CAUGHT=12/13" in out,
        "all_mutations_restored": "restore=12/12" in out,
        "clean_rerun_green": "clean=GREEN" in out,
        "copy_script_left_in_excluded_dir": COPY.is_file(),
    }
    COPY.unlink(missing_ok=True)
    checks["temp_script_removed"] = not COPY.exists()
    for k, v in checks.items():
        print(("OK   " if v else "FAIL ") + k)
    ok = all(checks.values())
    print(f"SELFTEST_H {sum(checks.values())}/{len(checks)}")
    print("DID_NOT_RUN_BRANCH_OK" if ok else "DID_NOT_RUN_BRANCH_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/make_filelist_h.py =====
"""生成 H 路线交付文件清单与新增脚本 diff。

自指纪律（G 路线踩过）：清单 / diff / logs / orig / .godot /
__pycache__ 一律排除，否则「清单写好后重跑」会把自己算进去。
用法：python make_filelist_h.py
"""
from __future__ import annotations

import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = HERE.parent / "牌拳-CardBoxer"
LIST = HERE / "文件清单.txt"
DIFF = HERE / "new-files.diff"
EXCLUDE_NAMES = {"文件清单.txt", "new-files.diff"}
EXCLUDE_DIRS = {"logs", ".godot", "__pycache__", "orig"}
EXCLUDE_PREFIX = ("logs/", "orig/")

DIFF_SCRIPTS = [
    "make_baseline_h.py", "probe_blends_h.py", "diag_rest_h.py",
    "diag_motion_h.py", "make_foe_motion_h.py", "build_foe_rigged_h.py",
    "inspect_foe_glb_h.py", "install_assets_h.py", "patch_game_h.py",
    "diag_glb_pair_h.py", "diag_roi_h.py", "make_zoom_h.py",
    "diag_cross_h.py", "run_isolate_h.py", "run_two_side_probe.py",
    "run_vp_diag_h.py", "make_isolate_zoom_h.py", "diag_identity_h.py",
    "run_all_checks_h.py", "run_static_ab_h.py", "verify_h.py",
    "mutation_h.py", "selftest_did_not_run_h.py",
    "make_filelist_h.py", "crosscheck_filelist_h.py",
]
DIFF_TESTS = ["tests/two_side_probe.gd", "tests/vp_diag_probe.gd"]
DIFF_GAME_GD = ["scripts/arena.gd", "scripts/fighter_3d_layer.gd",
                "scripts/fighter.gd"]


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def entries() -> list[Path]:
    out = []
    for p in sorted(HERE.rglob("*")):
        if not p.is_file() or p.name in EXCLUDE_NAMES:
            continue
        rel = p.relative_to(HERE)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        if str(rel).replace("\\", "/").startswith(EXCLUDE_PREFIX):
            continue
        out.append(p)
    return out


def main() -> int:
    rows = []
    for p in entries():
        rel = str(p.relative_to(HERE)).replace("\\", "/")
        rows.append(f"{rel}\t{p.stat().st_size}\t{sha256(p)}")
    header = [
        "# H 路线 · 双方 3D 侧面战斗 · 交付文件清单",
        "# 格式: 相对路径<TAB>字节<TAB>sha256",
        "# 排除: 本清单 / new-files.diff / logs / orig / .godot / __pycache__",
        "",
    ]
    LIST.write_bytes(("\n".join(header + rows) + "\n").encode("utf-8"))

    parts = []
    for name in DIFF_SCRIPTS:
        p = HERE / name
        if p.is_file():
            parts.append(f"===== H/{name} =====\n"
                         + p.read_text(encoding="utf-8"))
    for rel in DIFF_TESTS:
        p = HERE / rel
        if p.is_file():
            parts.append(f"===== H/{rel} =====\n"
                         + p.read_text(encoding="utf-8"))
    for rel in DIFF_GAME_GD:
        p = GAME / rel
        if p.is_file():
            parts.append(f"===== GAME/{rel} =====\n"
                         + p.read_text(encoding="utf-8"))
    DIFF.write_bytes(("\n\n".join(parts) + "\n").encode("utf-8"))

    again = ("\n".join(header + [
        f"{str(p.relative_to(HERE)).replace(chr(92), '/')}\t"
        f"{p.stat().st_size}\t{sha256(p)}" for p in entries()
    ]) + "\n").encode("utf-8")
    stable = LIST.read_bytes() == again
    print(f"FILELIST_ENTRIES={len(rows)} DIFF_BYTES={DIFF.stat().st_size}")
    print(f"STABLE={stable}")
    print("FILELIST_STABLE_OK" if stable else "FILELIST_UNSTABLE")
    return 0 if stable else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/crosscheck_filelist_h.py =====
"""独立复核 H 路线文件清单：重新遍历目录，逐条比对路径/字节/sha256。

刻意不 import make_filelist_h.py，避免「两边用同一个错函数一起错」。
用法：python crosscheck_filelist_h.py
"""
from __future__ import annotations

import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
LIST = HERE / "文件清单.txt"
SKIP_NAMES = {"文件清单.txt", "new-files.diff"}
SKIP_DIRS = {"logs", ".godot", "__pycache__", "orig"}


def digest(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def main() -> int:
    actual = {}
    for p in HERE.rglob("*"):
        if not p.is_file() or p.name in SKIP_NAMES:
            continue
        rel = p.relative_to(HERE)
        if any(part in SKIP_DIRS for part in rel.parts):
            continue
        key = str(rel).replace("\\", "/")
        actual[key] = (p.stat().st_size, digest(p))

    declared = {}
    for ln in LIST.read_bytes().decode("utf-8").splitlines():
        if not ln or ln.startswith("#"):
            continue
        parts = ln.split("\t")
        if len(parts) != 3:
            print("BAD ROW", repr(ln))
            continue
        declared[parts[0]] = (int(parts[1]), parts[2])

    bad = [k for k, v in declared.items() if actual.get(k) != v]
    extra = sorted(set(actual) - set(declared))
    missing = sorted(set(declared) - set(actual))
    ok = not bad and not extra and not missing and len(declared) > 40
    print(f"ROWS={len(declared)} ACTUAL={len(actual)} "
          f"BAD={len(bad)} EXTRA={len(extra)} MISSING={len(missing)}")
    for k in bad[:10]:
        print("  MISMATCH", k)
    for k in extra[:10]:
        print("  EXTRA", k)
    for k in missing[:10]:
        print("  MISSING", k)
    print("CROSSCHECK_H_OK" if ok else "CROSSCHECK_H_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/tests/two_side_probe.gd =====
extends SceneTree
## H 路线：同一棵树、同一冻结状态的「双侧 3D」A/B 探针。
##
## 跨 Godot 进程逐像素对比不成立（全局 RNG 每次启动随机化，见
## tests/rng_probe.gd 与 引擎优化/compare_regression.py 的订正）。
## 这里在同一个进程里：
##   ① 实例化 main.tscn 后立刻 paused，隐藏 HUD / fx，只留 World；
##   ② 抓 off 帧（两人都是既有 2D 自绘）；
##   ③ 原地挂两套 3D 表现层（玩家 / 对手各读自己的 motion），
##      两个 Fighter 都切 draw_3d_override；
##   ④ 逐阶段分别 apply 动作，各抓一帧。
## 于是 A/B 差异只可能来自两个 3D 层与骨架驱动。
##
## 跑法（必须带窗口）：
##   H_2SIDE_DIR=<abs> godot --path . --resolution 1280x720 \
##     --quit-after 900 --script res://tests/two_side_probe.gd

const ArenaScene = preload("res://scenes/main.tscn")
const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
const MOTION_P := "res://data/motion_input.json"
const MOTION_F := "res://data/motion_input_foe.json"


class Driver:
	extends Node

	# 内部类有独立常量作用域，这里显式复制一份，不依赖作用域猜测。
	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 26
	const SHOTS := [
		{"name": "off", "p": "stance", "pf": 0, "f": "stance", "ff": 0},
		{"name": "both-stance", "p": "stance", "pf": 0, "f": "stance", "ff": 0},
		{"name": "player-jab6", "p": "jab", "pf": 6, "f": "stance", "ff": 0},
		{"name": "foe-cross11", "p": "stance", "pf": 0, "f": "cross", "ff": 11},
		{"name": "both-wave17", "p": "wave", "pf": 17, "f": "wave", "ff": 17},
	]

	var arena: Node2D
	var out_dir := ""
	var only := ""   # "" = 双侧；"player"/"foe" = 单侧隔离诊断
	var motion_p: Dictionary = {}
	var motion_f: Dictionary = {}
	var initialized := false
	var busy := false
	var stage := 0
	var wait := 0
	var player_ready := false
	var foe_ready := false
	var rows: Array = []
	var prims: Array = []
	var calls: Array = []

	func _avg(a: Array) -> float:
		if a.is_empty():
			return 0.0
		var s := 0.0
		for x in a:
			s += float(x)
		return s / float(a.size())

	func _snap(name: String) -> void:
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		var path := out_dir + "/h-" + name + ".png"
		var err := img.save_png(path)
		rows.append({
			"name": name, "path": path,
			"w": img.get_width(), "h": img.get_height(),
			"save_error": int(err),
			"prims_mean": _avg(prims),
			"draw_calls_mean": _avg(calls),
		})
		prims.clear()
		calls.clear()

	## 诊断：层里第一个 MeshInstance3D 的节点名能区分两份 GLB
	## （player_HI_skinned vs foe_HI_skinned）。
	func _first_mesh_name(layer) -> String:
		if layer == null or layer.sv == null:
			return ""
		var stack: Array = []
		for c in layer.sv.get_children():
			stack.append(c)
		while not stack.is_empty():
			var n = stack.pop_back()
			if n is MeshInstance3D:
				return String(n.name)
			for c in n.get_children():
				stack.append(c)
		return ""

	## 返回 mesh 节点名 + 资源路径 + 顶点数，用来认出实际挂的是哪份 GLB。
	func _mesh_signature(layer) -> String:
		if layer == null or layer.sv == null:
			return ""
		var stack: Array = []
		for c in layer.sv.get_children():
			stack.append(c)
		while not stack.is_empty():
			var n = stack.pop_back()
			if n is MeshInstance3D:
				var m: Mesh = n.mesh
				var verts := 0
				if m is ArrayMesh:
					var arr: Array = (m as ArrayMesh).surface_get_arrays(0)
					if arr.size() > Mesh.ARRAY_VERTEX:
						verts = arr[Mesh.ARRAY_VERTEX].size()
				var sig := "%s|%s|%d" % [n.name, m.resource_path, verts]
				# 贴图资源路径：若两层指向同一张，就是材质缓存串味。
				var mat: Material = n.get_active_material(0)
				if mat is BaseMaterial3D:
					var t: Texture2D = (mat as BaseMaterial3D).albedo_texture
					if t != null:
						sig += "|albedo=" + String(t.resource_path)
				return sig
			for c in n.get_children():
				stack.append(c)
		return ""

	func _attach_layers() -> void:
		if only != "foe":
			_attach_player()
		if only != "player":
			_attach_foe()

	func _attach_player() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		player_ready = lp.setup(motion_p)
		if player_ready:
			arena.layer_3d = lp
			arena.motion_3d = motion_p
			# arena.paused 让 _sync_3d_layer() 不跑，位置必须由探针显式给，
			# 否则层留在 (0,0) 被画到画布外（G 路线首版踩过）。
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true
			arena.player.queue_redraw()

	func _attach_foe() -> void:
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		foe_ready = lf.setup(motion_f)
		if foe_ready:
			arena.layer_3d_foe = lf
			arena.motion_3d_foe = motion_f
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true
			arena.enemy.queue_redraw()

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
			var pp: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_P))
			if pp is Dictionary:
				motion_p = pp
			var ff: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_F))
			if ff is Dictionary:
				motion_f = ff
		if wait >= WARM - 10:
			prims.append(Performance.get_monitor(
					Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))
			calls.append(Performance.get_monitor(
					Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME))

		if stage == 0:
			wait += 1
			if wait >= WARM:
				await _snap("off")
				_attach_layers()
				stage = 1
				wait = 0
		elif stage < SHOTS.size():
			wait += 1
			var spec: Dictionary = SHOTS[stage]
			if arena.layer_3d != null:
				arena.layer_3d.apply(String(spec["p"]), int(spec["pf"]))
			if arena.layer_3d_foe != null:
				arena.layer_3d_foe.apply(String(spec["f"]), int(spec["ff"]))
			if wait >= WARM:
				await _snap(String(spec["name"]))
				stage += 1
				wait = 0
		else:
			var payload := {
				"shots": rows,
				"player_layer_ready": player_ready,
				"foe_layer_ready": foe_ready,
				"bones": int(arena.layer_3d.drv.bone_names.size())
						if arena.layer_3d != null else 0,
				"foe_bones": int(arena.layer_3d_foe.drv.bone_names.size())
						if arena.layer_3d_foe != null else 0,
				"player_frames_applied": int(arena.layer_3d.frames_applied)
						if arena.layer_3d != null else 0,
				"foe_frames_applied": int(arena.layer_3d_foe.frames_applied)
						if arena.layer_3d_foe != null else 0,
				"player_tex_drawn": bool(arena.layer_3d.tex_drawn)
						if arena.layer_3d != null else false,
				"foe_tex_drawn": bool(arena.layer_3d_foe.tex_drawn)
						if arena.layer_3d_foe != null else false,
				"player_yaw": float(arena.layer_3d.view_yaw_deg)
						if arena.layer_3d != null else 0.0,
				"foe_yaw": float(arena.layer_3d_foe.view_yaw_deg)
						if arena.layer_3d_foe != null else 0.0,
				"foe_role": String(arena.layer_3d_foe.role_id)
						if arena.layer_3d_foe != null else "",
				"player_override": bool(arena.player.draw_3d_override),
				"enemy_override": bool(arena.enemy.draw_3d_override),
				"player_glb_path": String(arena.layer_3d.glb_path)
						if arena.layer_3d != null else "",
				"foe_glb_path": String(arena.layer_3d_foe.glb_path)
						if arena.layer_3d_foe != null else "",
				"player_mesh_name": _first_mesh_name(arena.layer_3d),
				"foe_mesh_name": _first_mesh_name(arena.layer_3d_foe),
				"player_mesh_sig": _mesh_signature(arena.layer_3d),
				"foe_mesh_sig": _mesh_signature(arena.layer_3d_foe),
				"sv_same": (arena.layer_3d != null
						and arena.layer_3d_foe != null
						and arena.layer_3d.sv == arena.layer_3d_foe.sv),
				"tex_same": (arena.layer_3d != null
						and arena.layer_3d_foe != null
						and arena.layer_3d.sv.get_texture()
						== arena.layer_3d_foe.sv.get_texture()),
				"use_3d_env": OS.get_environment("CARD_BOXER_3D"),
				"only": only,
			}
			var f := FileAccess.open(out_dir + "/ab_result.json",
					FileAccess.WRITE)
			if f != null:
				f.store_string(JSON.stringify(payload, "\t"))
				f.close()
			print("H2SIDE_JSON " + JSON.stringify(payload))
			get_tree().quit(0)
			return
		busy = false


func _init() -> void:
	var out_dir := OS.get_environment("H_2SIDE_DIR")
	if out_dir == "":
		print("H2SIDE_JSON " + JSON.stringify({"error": "H_2SIDE_DIR missing"}))
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	d.out_dir = out_dir
	d.only = OS.get_environment("H_2SIDE_ONLY")
	root.add_child(d)
	print("H2SIDE_START out=%s" % out_dir)


===== H/tests/vp_diag_probe.gd =====
extends SceneTree
## H 路线诊断：同一进程内隐藏单层，判定两个 SubViewport 是否串味。
##
## 跨进程逐像素对比不成立（全局 RNG 每次启动随机化）。这里在同一个
## 进程、同一棵树里抓 4 帧：both / player-hidden / foe-hidden / neither。
## 若隐藏 player 时右侧 ROI 也变了，就说明两个视口内容互相依赖。
##
## 跑法（必须带窗口）：
##   H_VP_DIR=<abs> godot --path . --resolution 1280x720 \
##     --quit-after 900 --script res://tests/vp_diag_probe.gd

const ArenaScene = preload("res://scenes/main.tscn")
const LayerScript = preload("res://scripts/fighter_3d_layer.gd")


class Driver:
	extends Node

	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 20
	const NAMES := ["off", "both", "player-hidden", "foe-hidden", "neither"]

	var arena: Node2D
	var out_dir := ""
	var motion_p: Dictionary = {}
	var motion_f: Dictionary = {}
	var initialized := false
	var busy := false
	var stage := 0
	var wait := 0
	var rows: Array = []
	var player_ready := false
	var foe_ready := false

	func _snap(name: String) -> void:
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		var path := out_dir + "/vp-" + name + ".png"
		var err := img.save_png(path)
		rows.append({"name": name, "path": path,
			"w": img.get_width(), "h": img.get_height(),
			"save_error": int(err)})

	func _attach() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		player_ready = lp.setup(motion_p)
		if player_ready:
			arena.layer_3d = lp
			arena.motion_3d = motion_p
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true
			arena.player.queue_redraw()
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		foe_ready = lf.setup(motion_f)
		if foe_ready:
			arena.layer_3d_foe = lf
			arena.motion_3d_foe = motion_f
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true
			arena.enemy.queue_redraw()

	func _set_vis(p: bool, f: bool) -> void:
		if arena.layer_3d != null:
			arena.layer_3d.visible = p
		if arena.layer_3d_foe != null:
			arena.layer_3d_foe.visible = f

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
			var pp: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_P))
			if pp is Dictionary:
				motion_p = pp
			var ff: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_F))
			if ff is Dictionary:
				motion_f = ff
		wait += 1
		if wait < WARM:
			busy = false
			return
		wait = 0
		if stage == 0:
			await _snap("off")
			_attach()
		elif stage == 1:
			await _snap("both")
			_set_vis(false, true)
		elif stage == 2:
			await _snap("player-hidden")
			_set_vis(true, false)
		elif stage == 3:
			await _snap("foe-hidden")
			_set_vis(false, false)
		elif stage == 4:
			await _snap("neither")
			var payload := {
				"shots": rows,
				"player_layer_ready": player_ready,
				"foe_layer_ready": foe_ready,
				"player_glb": String(arena.layer_3d.glb_path)
						if arena.layer_3d != null else "",
				"foe_glb": String(arena.layer_3d_foe.glb_path)
						if arena.layer_3d_foe != null else "",
			}
			var f := FileAccess.open(out_dir + "/vp_result.json",
					FileAccess.WRITE)
			if f != null:
				f.store_string(JSON.stringify(payload, "\t"))
				f.close()
			print("HVP_JSON " + JSON.stringify(payload))
			get_tree().quit(0)
			return
		stage += 1
		busy = false


func _init() -> void:
	var out_dir := OS.get_environment("H_VP_DIR")
	if out_dir == "":
		print("HVP_JSON " + JSON.stringify({"error": "H_VP_DIR missing"}))
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	d.out_dir = out_dir
	root.add_child(d)
	print("HVP_START out=%s" % out_dir)

