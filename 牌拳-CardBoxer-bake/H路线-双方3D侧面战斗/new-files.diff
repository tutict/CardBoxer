def sha(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def all_true(d: dict, key: str = "checks") -> bool:
    v = d.get(key, {})
    return isinstance(v, dict) and len(v) > 0 and all(v.values())


def txt(rel: str) -> str:
