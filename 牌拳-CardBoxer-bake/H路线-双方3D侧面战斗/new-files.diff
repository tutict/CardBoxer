===== H/run_vp_diag_h.py =====
"""H 路线：同进程隐藏层对照，判定两个 SubViewport 是否串味。

判据（全部同进程，无 RNG 噪声）：
  隐藏 player 时：左侧 ROI 应显著变化、右侧 ROI 应几乎不变；
  隐藏 foe 时：右侧 ROI 应显著变化、左侧 ROI 应几乎不变。
用法：python run_vp_diag_h.py
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import time
from pathlib import Path

from PIL import Image, ImageChops

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
OUTDIR = HERE / "shots" / "vp_diag"
LOGS = HERE / "logs"
OUT = HERE / "data" / "vp_diag_h.json"
ROI = HERE / "data" / "roi_h.json"
PROBE_SRC = HERE / "tests" / "vp_diag_probe.gd"
PROBE_DST = GAME / "tests" / "vp_diag_probe.gd"


def diff(a: Path, b: Path, box) -> dict:
    ia = Image.open(a).convert("RGB").crop(box)
    ib = Image.open(b).convert("RGB").crop(box)
    d = ImageChops.difference(ia, ib)
    changed = sum(1 for px in d.get_flattened_data() if sum(px) > 18)
    total = ia.width * ia.height
    return {"changed_px": changed, "total_px": total,
            "ratio": round(changed / total, 4)}


def main() -> int:
    assert GODOT.is_file() and PROBE_SRC.is_file() and ROI.is_file()
    OUTDIR.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(parents=True, exist_ok=True)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(PROBE_SRC, PROBE_DST)
    boxes = json.loads(ROI.read_text(encoding="utf-8"))["boxes"]
    left, right = boxes[0], boxes[1]

    env = os.environ.copy()
    env.pop("CARD_BOXER_3D", None)
    env["H_VP_DIR"] = str(OUTDIR)
    t0 = time.perf_counter()
    proc = subprocess.run(
        [str(GODOT), "--path", str(GAME), "--resolution", "1280x720",
         "--quit-after", "900", "--script", "res://tests/vp_diag_probe.gd"],
        env=env, capture_output=True, timeout=300, cwd=str(GAME))
    text = (proc.stdout + b"\n--- STDERR ---\n"
            + proc.stderr).decode("utf-8", "replace")
    (LOGS / "godot_vp_diag.log").write_text(text, encoding="utf-8")
    marker = "HVP_JSON "
    line = next((l for l in text.splitlines() if l.startswith(marker)), None)
    payload = json.loads(line[len(marker):]) if line else {"error": "no marker"}
    rows = payload.get("shots", [])
    by = {r["name"]: Path(r["path"]) for r in rows}
    has_gl = "OpenGL API" in text
    errors = text.count("SCRIPT ERROR") + text.count("Parse Error")

    res = {}
    for hidden, untouched_side, changed_side in (
            ("player-hidden", right, left),
            ("foe-hidden", left, right)):
        res[f"{hidden}_untouched"] = diff(by["both"], by[hidden],
                                          untouched_side)
        res[f"{hidden}_changed"] = diff(by["both"], by[hidden], changed_side)

    checks = {
        "rc": proc.returncode == 0,
        "has_opengl": has_gl,
        "no_errors": errors == 0,
        "no_payload_error": "error" not in payload,
        "five_frames": len(rows) == 5,
        "all_png_ok": all(r.get("save_error") == 0
                          and r.get("w") == 1280 and r.get("h") == 720
                          and Path(r.get("path", "")).is_file() for r in rows),
        "both_layers_ready": (payload.get("player_layer_ready") is True
                              and payload.get("foe_layer_ready") is True),
        # 隐藏 player：右侧（对手）不受影响，左侧显著变化
        "hide_player_right_untouched": (
            res["player-hidden_untouched"]["ratio"] < 0.02),
        "hide_player_left_changed": (
            res["player-hidden_changed"]["ratio"] > 0.10),
        # 隐藏 foe：左侧（玩家）不受影响，右侧显著变化
        "hide_foe_left_untouched": (
            res["foe-hidden_untouched"]["ratio"] < 0.02),
        "hide_foe_right_changed": (
            res["foe-hidden_changed"]["ratio"] > 0.10),
    }
    report = {"run": {"seconds": round(time.perf_counter() - t0, 3),
                      "returncode": proc.returncode, "has_opengl": has_gl,
                      "script_errors": errors},
              "payload": payload, "roi": {"left": left, "right": right},
              "diffs": res, "checks": checks,
              "failed": [k for k, v in checks.items() if not v],
              "ok": all(checks.values())}
    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print(f"RUN {report['run']['seconds']}s rc={proc.returncode} "
          f"gl={has_gl} errors={errors}")
    for k, v in res.items():
        print(f"DIFF {k:<28} {v['changed_px']:>6}/{v['total_px']} "
              f"ratio={v['ratio']}")
    for k, v in checks.items():
        if not v:
            print("  FAIL", k)
    print("VP_DIAG_OK" if report["ok"] else "VP_DIAG_SUSPICIOUS")
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/make_isolate_zoom_h.py =====
"""把同进程两帧里各自的 3D 角色裁出来并排放大，做最终视觉定性。

vp-foe-hidden.png 只剩玩家层（左侧），vp-player-hidden.png 只剩对手层（右侧）。
用 diag_roi_h.py 自动定位的 ROI，不手填坐标。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
VP = HERE / "shots" / "vp_diag"
OUT = HERE / "boards" / "H-同进程单角色特写.png"
ROI = HERE / "data" / "roi_h.json"
FONT = Path(r"C:\Windows\Fonts\msyh.ttc")


def main() -> int:
    boxes = json.loads(ROI.read_text(encoding="utf-8"))["boxes"]
    left, right = boxes[0], boxes[1]
    w = min(left[2] - left[0], right[2] - right[0])
    h = min(left[3] - left[1], right[3] - right[1])
    def centered(box):
        cx, cy = (box[0] + box[2]) // 2, (box[1] + box[3]) // 2
        return (cx - w // 2, cy - h // 2,
                cx - w // 2 + w, cy - h // 2 + h)
    a = Image.open(VP / "vp-foe-hidden.png").convert("RGB").crop(
        centered(left))
    b = Image.open(VP / "vp-player-hidden.png").convert("RGB").crop(
        centered(right))
    z = 2
    W, H = w * z, h * z
    pad, label = 24, 40
    canvas = Image.new("RGB", (2 * W + 3 * pad, H + label + 2 * pad),
                       (20, 24, 34))
    d = ImageDraw.Draw(canvas)
    f = ImageFont.truetype(str(FONT), 22) if FONT.is_file() \
        else ImageFont.load_default()
    canvas.paste(a.resize((W, H), Image.LANCZOS), (pad, pad))
    canvas.paste(b.resize((W, H), Image.LANCZOS), (2 * pad + W, pad))
    d.text((pad + 6, pad + H + 6), "玩家 V4b（仅玩家层可见）",
           font=f, fill=(160, 225, 205))
    d.text((2 * pad + W + 6, pad + H + 6), "对手怪（仅对手层可见）",
           font=f, fill=(160, 225, 205))
    OUT.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(OUT)
    print("WROTE", OUT.name, OUT.stat().st_size, "B",
          "roi_size", (w, h))
    print("ISOLATE_ZOOM_OK" if OUT.stat().st_size > 10000
          else "ISOLATE_ZOOM_FAILED")
    return 0 if OUT.stat().st_size > 10000 else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/diag_identity_h.py =====
"""H 路线视觉诊断附录：定量核对「左右两个 3D 角色是不是同一张脸」。

盘上已知：两份 GLB 的 mesh 名 / 顶点数 / bbox / 三张 PBR 的 sha256
全都不同（diag_glb_pair_h.py），Godot 里读回的 mesh_sig / SubViewport /
ViewportTexture 也各自独立（data/two_side_ab.json）。但 h-both-stance.png
里左右两个角色看起来高度雷同，必须用数字把「串味 bug」与「造型雷同」
分开，不能靠肉眼下结论。

口径订正（第一版的缺陷）：ROI 里包含擂台绳索 / 观众席 / 灯光，
水平镜像后背景必然错位，所以「镜像 ROI 差异率 0.8667」只能证明
**两帧不是同一张图**，不能证明两个角色长得不同。这一版把该判据
改名并加 scope_note；真正针对渲染的证据改为两侧 ROI 平均亮度。

输出 data/identity_h.json。本脚本只读，不改任何源码或归档。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops, ImageStat

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
VP = HERE / "shots" / "vp_diag"
OUT = HERE / "data" / "identity_h.json"

P_TEX = GAME / "assets" / "3d" / "player-rigged_texture_pbr_20250901.png"
F_TEX = GAME / "assets" / "3d" / "foe-rigged_texture_pbr_20250901.png"
P_SHOT = VP / "vp-foe-hidden.png"       # 对手层隐藏 → 只剩下玩家（左）
F_SHOT = VP / "vp-player-hidden.png"    # 玩家层隐藏 → 只剩下对手（右）

SCOPE_NOTE = (
    "ROI 含擂台绳索/观众席/灯光，水平镜像后背景必然错位；"
    "镜像 ROI 差异率只证明两帧非同一张图，不作角色造型差异证据。"
    "造型区分度是看图判断，不用像素指标硬撑。")


def thumb_mae(a: Image.Image, b: Image.Image) -> float:
    d = ImageChops.difference(a, b)
    return round(sum(ImageStat.Stat(d).mean) / 3.0, 4)


def roi_mean(path: Path, box) -> list[float]:
    im = Image.open(path).convert("RGB").crop(box)
    return [round(v, 2) for v in ImageStat.Stat(im).mean]


def roi_diff(box_a, box_b, mirror_b: bool) -> dict:
    ia = Image.open(P_SHOT).convert("RGB").crop(box_a)
    ib = Image.open(F_SHOT).convert("RGB").crop(box_b)
    w = min(ia.width, ib.width)
    h = min(ia.height, ib.height)

    def center(im):
        cx, cy = (im.width - w) // 2, (im.height - h) // 2
        return im.crop((cx, cy, cx + w, cy + h))

    a = center(ia)
    b = center(ib)
    if mirror_b:
        b = b.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
    d = ImageChops.difference(a, b)
    changed = sum(1 for px in d.get_flattened_data() if sum(px) > 18)
    total = w * h
    return {"size": [w, h], "changed_px": changed, "total_px": total,
            "ratio": round(changed / total, 4),
            "mae": round(sum(ImageStat.Stat(d).mean) / 3.0, 4)}


def main() -> int:
    boxes = json.loads((HERE / "data" / "roi_h.json").read_text(
        encoding="utf-8"))["boxes"]
    pair = json.loads((HERE / "data" / "glb_pair_h.json").read_text(
        encoding="utf-8"))["pair"]

    tex_a = Image.open(P_TEX).convert("RGB").resize(
        (64, 64), Image.LANCZOS)
    tex_b = Image.open(F_TEX).convert("RGB").resize(
        (64, 64), Image.LANCZOS)
    tex_mae = thumb_mae(tex_a, tex_b)

    mirrored = roi_diff(boxes[0], boxes[1], True)
    raw = roi_diff(boxes[0], boxes[1], False)
    roi_means = {
        "player": roi_mean(P_SHOT, boxes[0]),
        "foe": roi_mean(F_SHOT, boxes[1]),
    }
    lum = {k: round(sum(v) / 3.0, 2) for k, v in roi_means.items()}

    out = {
        "basecolor_thumb_mae": tex_mae,
        "basecolor_mean_rgb": {
            "player": [round(v, 2) for v in ImageStat.Stat(tex_a).mean],
            "foe": [round(v, 2) for v in ImageStat.Stat(tex_b).mean]},
        "roi_mean_rgb": roi_means,
        "roi_mean_luminance": lum,
        "roi_mirrored": mirrored,
        "roi_unmirrored": raw,
        "roi_scope_note": SCOPE_NOTE,
        "primary_identity_evidence": (
            "GLB 顶点数/bbox/三张 PBR sha256 不同 + Godot 读回 "
            "mesh_sig/SubViewport/ViewportTexture 各自独立"),
        "glb_vertex_counts": {
            "player": pair["player"]["verts"],
            "foe": pair["foe"]["verts"]},
        "glb_bbox_x_span": {
            "player": round(pair["player"]["pos_max"][0]
                            - pair["player"]["pos_min"][0], 6),
            "foe": round(pair["foe"]["pos_max"][0]
                         - pair["foe"]["pos_min"][0], 6)},
    }
    out["checks"] = {
        "basecolor_not_identical": tex_mae > 5.0,
        "frames_not_identical_including_background": mirrored["ratio"] > 0.20,
        "render_brightness_differs": abs(lum["player"] - lum["foe"]) > 5.0,
        "vertex_counts_differ": (out["glb_vertex_counts"]["player"]
                                 != out["glb_vertex_counts"]["foe"]),
        "bbox_spans_differ": (out["glb_bbox_x_span"]["player"]
                              != out["glb_bbox_x_span"]["foe"]),
        "scope_note_present": "背景" in SCOPE_NOTE,
    }
    out["ok"] = all(out["checks"].values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("BASECOLOR_THUMB_MAE", tex_mae)
    print("MEAN_RGB", out["basecolor_mean_rgb"])
    print("ROI_MEAN_RGB", roi_means, "LUM", lum)
    print("ROI_MIRRORED", mirrored)
    print("ROI_UNMIRRORED", raw)
    print("VERTS", out["glb_vertex_counts"], "BBOX_X",
          out["glb_bbox_x_span"])
    for k, v in out["checks"].items():
        print("CHECK", k, v)
    print("IDENTITY_H_OK" if out["ok"] else "IDENTITY_H_SUSPICIOUS")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


