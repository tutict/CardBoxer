===== H/make_foe_motion_h.py =====
"""H 路线 P0：证明 apose_points 口径，并为对手怪生成自己的 motion_input。

F 的 RigDriver 用 motion["apose_points"] 当**旋转中心 hv**（米，Blender
(x, z)），而 global_rest 从各自 GLB 的 Skeleton3D 读回。两个模型的 13 骨
rest 不同（对手怪更矮更宽），所以旋转中心必须各用各的骨架，否则会绕
错误的位置转。

先按固定规则从玩家 rig 重算 apose_points，与 F 的 motion_input.json
逐项对账（这是对规则的证明）；同一函数再从对手怪 rig 生成 foe 版。
除 apose_points 外其余键（stance / cards / mapping / bones / chain /
px_to_m / source / joint_names）逐项保持不变。
"""
from __future__ import annotations

import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
PROBE = HERE / "data" / "blend_probe_h.json"
SRC = BAKE / "F路线-Godot驱动层" / "data" / "motion_input.json"
OUT_FOE = HERE / "data" / "motion_input_foe.json"
OUT_REPORT = HERE / "data" / "apose_crosscheck_h.json"


def xz(v: list[float]) -> list[float]:
    return [round(float(v[0]), 6), round(float(v[2]), 6)]


def apose_from_rig(rig: dict) -> dict:
    b = {x["name"]: x for x in rig["bones"]}
    need = ["hips", "spine", "chest", "neck", "head",
            "forearm_f", "forearm_b", "shin_f", "shin_b",
            "thigh_f", "thigh_b"]
    assert all(n in b for n in need), sorted(b)
    out = {
        "A": xz(b["hips"]["head"]),
        "B": xz(b["spine"]["head"]),
        "C": xz(b["chest"]["head"]),
        "D": xz(b["neck"]["head"]),
        "E": xz(b["head"]["head"]),
        "F": xz(b["head"]["tail"]),
        "f_elbow": xz(b["forearm_f"]["head"]),
        "f_hand": xz(b["forearm_f"]["tail"]),
        "b_elbow": xz(b["forearm_b"]["head"]),
        "b_hand": xz(b["forearm_b"]["tail"]),
        "f_knee": xz(b["shin_f"]["head"]),
        "f_foot": xz(b["shin_f"]["tail"]),
        "b_knee": xz(b["shin_b"]["head"]),
        "b_foot": xz(b["shin_b"]["tail"]),
        "tf_head": xz(b["thigh_f"]["head"]),
        "tb_head": xz(b["thigh_b"]["head"]),
    }
    # 三个语义别名（make_points 用的是 2D frame joints，这里只为结构一致）
    out["hip"] = out["A"]
    out["shoulder"] = out["D"]
    out["head"] = out["F"]
    return out


def main() -> int:
    probe = json.loads(PROBE.read_text(encoding="utf-8"))
    src = json.loads(SRC.read_text(encoding="utf-8"))
    player_rig = probe["blends"]["player"]["rigs"][0]
    foe_rig = probe["blends"]["foe"]["rigs"][0]

    rebuilt = apose_from_rig(player_rig)
    expect = {k: [round(float(x), 6) for x in v]
              for k, v in src["apose_points"].items()}
    rows = []
    for k in sorted(expect):
        got = rebuilt.get(k)
        diff = (max(abs(a - b) for a, b in zip(got, expect[k]))
                if got else None)
        rows.append({"key": k, "rebuilt": got, "expected": expect[k],
                     "max_abs_diff": diff})
    worst = max((9.9 if r["max_abs_diff"] is None
                 else r["max_abs_diff"]) for r in rows)
    same_keys = set(rebuilt) == set(expect)
    checks = {
        "apose_key_set_identical": same_keys,
        "player_rebuild_matches_F": worst <= 1e-4,
        "foe_rest_differs_from_player": (
            foe_rig["bones"] != player_rig["bones"]),
        "foe_apose_not_equal_player": None,
    }
    foe_apose = apose_from_rig(foe_rig)
    checks["foe_apose_not_equal_player"] = foe_apose != rebuilt

    # 只换 apose_points 一个键；其余（含 source/joint_names/stance/cards/
    # mapping/bones/chain/px_to_m）逐项保持原值，真相来源不被改写。
    foe = dict(src)
    foe["apose_points"] = foe_apose
    report = {
        "rule": "apose[u] = Blender bone.head_local/tail_local (x, z)",
        "player_worst_abs_diff": worst,
        "rows": rows,
        "foe_apose": foe_apose,
        "keys_other_than_apose_identical": all(
            foe[k] == src[k] for k in src if k != "apose_points"),
        "checks": checks,
        "failed": [k for k, v in checks.items() if not v],
        "ok": (all(checks.values())
               and all(foe[k] == src[k] for k in src if k != "apose_points")),
    }
    OUT_REPORT.parent.mkdir(parents=True, exist_ok=True)
    OUT_REPORT.write_text(json.dumps(report, ensure_ascii=False, indent=2)
                          + "\n", encoding="utf-8")
    for r in rows:
        print(f"{r['key']:<10} rebuilt={str(r['rebuilt']):<24} "
              f"expected={str(r['expected']):<24} diff={r['max_abs_diff']}")
    print("WORST", worst, "SAME_KEYS", same_keys)
    for k, v in checks.items():
        print("CHECK", k, v)
    if report["ok"]:
        OUT_FOE.write_text(json.dumps(foe, ensure_ascii=False,
                                      separators=(",", ":"))
                           + "\n", encoding="utf-8")
        print("WROTE", OUT_FOE.name, OUT_FOE.stat().st_size, "B")
        print("APOSE_FOE_MOTION_OK")
        return 0
    print("APOSE_FOE_MOTION_FAILED")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/build_foe_rigged_h.py =====
"""H 路线 P1：给对手怪高模补平滑 skin，导出 Godot 能驱动的 GLB。

链路与 F 路线 build_rigged_glb.py 同构：
  A 路线 .blend 的 a_continuous_shell（3 壳 / ARMATURE_AUTO 平滑权重）
  → DATA_TRANSFER 回传 node_0 原高模 → 加 ARMATURE modifier
  → export_apply=False 只导出「高模 + 13 骨」。

不能直接用 node_0 自带的 13 组权重：那是 11-08 的**刚性权重**
（拓扑修复探针V1 实测 35° 驱动右臂撕裂），A 路线正是用
SURFACE_DEFORM 绕开它。这里回传的是代理壳的平滑权重。

只读 A 路线 .blend，不回写任何归档。
用法：blender.exe -b --python build_foe_rigged_h.py
"""
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
import bpy

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
BLEND = BAKE / "A路线-资产重做" / "对手怪-可变形连续壳.blend"
OUT_GLB = HERE / "foe-rigged.glb"
OUT_JSON = HERE / "data" / "foe_rigged_build.json"


def log(*a):
    print(*a, flush=True)


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def textures(obj) -> list[dict]:
    out = []
    for slot in obj.material_slots:
        mat = slot.material
        if mat and mat.use_nodes:
            for n in mat.node_tree.nodes:
                if n.type == "TEX_IMAGE" and n.image:
                    out.append({"image": n.image.name,
                                "size": list(n.image.size)})
    return sorted(out, key=lambda d: d["image"])


def fresh_copy(src, name):
    obj = src.copy()
    obj.data = src.data.copy()
    bpy.context.scene.collection.objects.link(obj)
    obj.name = name
    for m in list(obj.modifiers):
        obj.modifiers.remove(m)
    obj.vertex_groups.clear()
    obj.parent = None
    obj.hide_render = True
    return obj


def main() -> int:
    assert BLEND.is_file(), BLEND
    blend_sha = sha256(BLEND)
    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    scene = bpy.context.scene

    src = next(o for o in scene.objects
               if o.type == "MESH"
               and any(m.type == "SURFACE_DEFORM" for m in o.modifiers))
    shell = next(m for m in src.modifiers
                 if m.type == "SURFACE_DEFORM").target
    rig = next(o for o in scene.objects if o.type == "ARMATURE")

    src_uv = len(src.data.uv_layers)
    src_tex = textures(src)
    bone_names = [b.name for b in rig.data.bones]
    shell_groups = [g.name for g in shell.vertex_groups]
    log("OPEN", src.name, len(src.data.vertices), "verts /",
        shell.name, len(shell.data.vertices), "verts /",
        rig.name, len(bone_names), "bones")
    assert set(bone_names) == set(shell_groups), (bone_names, shell_groups)

    final = fresh_copy(src, "foe_HI_skinned")
    for name in bone_names:
        final.vertex_groups.new(name=name)

    mod = final.modifiers.new("weights_from_continuous_shell",
                              "DATA_TRANSFER")
    mod.object = shell
    mod.use_vert_data = True
    mod.data_types_verts = {"VGROUP_WEIGHTS"}
    mod.vert_mapping = "POLYINTERP_NEAREST"
    mod.layers_vgroup_select_src = "ALL"
    mod.layers_vgroup_select_dst = "NAME"
    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    bpy.context.view_layer.objects.active = final
    bpy.ops.object.modifier_apply(modifier=mod.name)

    arm_mod = final.modifiers.new("foe_rig", "ARMATURE")
    arm_mod.object = rig

    covered = sum(1 for v in final.data.vertices
                  if any(g.weight > 1e-6 for g in v.groups))
    total = len(final.data.vertices)
    coverage = covered / total
    log("WEIGHTS", covered, "/", total, round(coverage * 100, 4), "%")
    assets = {
        "uv_layers": len(final.data.uv_layers),
        "materials": len(final.data.materials),
        "textures": textures(final),
        "uv_same": len(final.data.uv_layers) == src_uv,
        "textures_same": textures(final) == src_tex,
    }
    log("ASSETS", assets)
    assert assets["uv_same"] and assets["textures_same"]
    assert coverage > 0.99, covered

    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    rig.select_set(True)
    bpy.context.view_layer.objects.active = final
    result = bpy.ops.export_scene.gltf(
        filepath=str(OUT_GLB),
        export_format="GLB",
        use_selection=True,
        export_apply=False,          # 关键：不烘焙 ARMATURE，保留 skin
        export_skins=True,
        export_animations=False,
        export_materials="EXPORT",
        export_yup=True,
        export_cameras=False,
        export_lights=False,
    )
    log("EXPORT", list(result), OUT_GLB.stat().st_size, "B")
    assert list(result) == ["FINISHED"]
    assert OUT_GLB.is_file() and OUT_GLB.stat().st_size > 1_000_000

    report = {
        "blender": bpy.app.version_string,
        "source_blend": str(BLEND),
        "source_blend_sha256": blend_sha,
        "source": {"object": src.name, "verts": len(src.data.vertices),
                   "uv_layers": src_uv, "textures": src_tex,
                   "vertex_groups_before": len(src.vertex_groups)},
        "weight_source": {"object": shell.name,
                          "verts": len(shell.data.vertices),
                          "groups": shell_groups},
        "rig": {"object": rig.name, "bones": bone_names},
        "skinned": {"object": final.name, "verts": total,
                    "weighted_verts": covered,
                    "coverage_pct": round(coverage * 100, 4),
                    "assets": assets,
                    "modifiers": [{"name": m.name, "type": m.type}
                                  for m in final.modifiers]},
        "export": {"file": OUT_GLB.name,
                   "bytes": OUT_GLB.stat().st_size,
                   "sha256": sha256(OUT_GLB),
                   "export_apply": False,
                   "export_skins": True,
                   "operator_result": list(result)},
    }
    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
    OUT_JSON.write_text(json.dumps(report, ensure_ascii=False, indent=2)
                        + "\n", encoding="utf-8")
    log("FOE_RIGGED_GLB_OK", report["skinned"]["coverage_pct"], "%")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== H/inspect_foe_glb_h.py =====
"""纯 Python 复核 foe-rigged.glb：skin 真的挂在高模上、贴图零重编码。

不依赖 Blender；解析 GLB 的 JSON + BIN chunk，与
F 路线 player-rigged.glb（骨名口径）和
对手怪Blender建模V1/artifact_03.glb（原始 PBR 字节）对照。
导出器警告「Armature must be the parent of skinned mesh」必须由这里的
node.skin / JOINTS_0 实据判定有没有造成实际损害。
"""
from __future__ import annotations

import hashlib
import json
import struct
from pathlib import Path

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
GLB = HERE / "foe-rigged.glb"
PLAYER = BAKE / "F路线-Godot驱动层" / "player-rigged.glb"
SOURCE = BAKE / "对手怪Blender建模V1" / "artifact_03.glb"
OUT = HERE / "data" / "foe_gltf_inspection.json"


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def parse(path: Path):
    data = path.read_bytes()
    assert struct.unpack_from("<I", data, 0)[0] == 0x46546C67, path
    version, length = struct.unpack_from("<II", data, 4)
    assert version == 2 and length == len(data)
    off, chunks = 12, []
    while off < len(data):
        clen, ctype = struct.unpack_from("<I4s", data, off)
        off += 8
        chunks.append((ctype, data[off:off + clen]))
        off += clen
    js = json.loads(next(p for t, p in chunks if t == b"JSON").decode("utf-8"))
    binary = next(p for t, p in chunks if t == b"BIN\x00")
    return js, binary, len(data)


def image_blobs(js, binary):
    out = []
    for i, im in enumerate(js.get("images", [])):
        bv = js["bufferViews"][im["bufferView"]]
        off = bv.get("byteOffset", 0)
        blob = binary[off:off + bv["byteLength"]]
        out.append({"index": i, "bytes": len(blob), "sha256": sha(blob),
                    "name": im.get("name")})
    return out


def summarize(path: Path) -> dict:
    js, binary, size = parse(path)
    prims = []
    for mi, mesh in enumerate(js.get("meshes", [])):
        for pi, prim in enumerate(mesh.get("primitives", [])):
            acc = js["accessors"][prim["attributes"]["POSITION"]]
            prims.append({
                "mesh": mi, "primitive": pi,
                "attributes": sorted(prim["attributes"].keys()),
                "verts": acc["count"],
                "has_joints": "JOINTS_0" in prim["attributes"],
                "has_weights": "WEIGHTS_0" in prim["attributes"],
                "pos_min": acc.get("min"), "pos_max": acc.get("max"),
            })
    skinned_nodes = [
        {"node": i, "name": n.get("name"),
         "skin": n.get("skin"), "mesh": n.get("mesh")}
        for i, n in enumerate(js.get("nodes", []))
        if "skin" in n]
    skins = [{"joints": len(s.get("joints", [])),
              "has_inverse_bind": "inverseBindMatrices" in s}
             for s in js.get("skins", [])]
    return {
        "file": path.name, "bytes": size, "sha256": sha(path.read_bytes()),
        "counts": {k: len(js.get(k, [])) for k in
                   ("scenes", "nodes", "meshes", "materials", "textures",
                    "images", "skins", "animations", "accessors")},
        "primitives": prims, "skinned_nodes": skinned_nodes, "skins": skins,
        "images": image_blobs(js, binary),
        "joint_node_names": [js["nodes"][j].get("name")
                             for j in js.get("skins", [{}])[0].get("joints", [])]
        if js.get("skins") else [],
    }


def main() -> int:
    for p in (GLB, PLAYER, SOURCE):
        assert p.is_file(), p
    foe = summarize(GLB)
    player = summarize(PLAYER)
    source = summarize(SOURCE)
    hi = [p for p in foe["primitives"]
          if p["has_joints"] and p["has_weights"] and p["verts"] > 50000]
    phi = [p for p in player["primitives"]
           if p["has_joints"] and p["has_weights"] and p["verts"] > 50000]
    # 判据订正 2026-11-11：第一版写死 highpoly_verts == 64024（.blend 值）
    # 报红。glTF 导出器会按 UV seam / 法线拆分顶点，F 玩家同样如此：
    # .blend 57,901 → GLB 57,934（+33）。这里实测 +35，属同一现象。
    # 因此退役「等于源顶点数」，改判「拆分增量在 0..100 且总量 > 6 万」，
    # 并把两个增量都记进 verdict 供复算。
    split_delta = (hi[0]["verts"] - 64024) if hi else None
    player_split_delta = (phi[0]["verts"] - 57901) if phi else None
    verdict = {
        "highpoly_has_skin": bool(hi),
        "highpoly_verts": hi[0]["verts"] if hi else None,
        "blend_highpoly_verts": 64024,
        "vertex_split_delta": split_delta,
        "player_glb_verts": phi[0]["verts"] if phi else None,
        "player_blend_verts": 57901,
        "player_vertex_split_delta": player_split_delta,
        "skinned_nodes": len(foe["skinned_nodes"]),
        "skin_joints": foe["skins"][0]["joints"] if foe["skins"] else 0,
        "has_inverse_bind": bool(foe["skins"]
                                 and foe["skins"][0]["has_inverse_bind"]),
        "zero_animations": foe["counts"]["animations"] == 0,
        "three_images": foe["counts"]["images"] == 3,
        "images_zero_reencode": all(
            any(i["sha256"] == r["sha256"] for r in source["images"])
            for i in foe["images"]),
        "joint_names_same_as_player": (
            foe["joint_node_names"] == player["joint_node_names"]),
        "source_highpoly_has_no_skin": not any(
            p["has_joints"] and p["verts"] > 50000
            for p in source["primitives"]),
    }
    checks = {
        "highpoly_has_skin": verdict["highpoly_has_skin"],
        "highpoly_verts_split_ok": (
            split_delta is not None and 0 <= split_delta <= 100
            and verdict["highpoly_verts"] > 60000),
        "player_split_delta_positive": (
            player_split_delta is not None and 0 < player_split_delta <= 100),
        "one_skinned_node": verdict["skinned_nodes"] >= 1,
        "skin_joints_ge_13": verdict["skin_joints"] >= 13,
        "inverse_bind_present": verdict["has_inverse_bind"],
        "zero_animations": verdict["zero_animations"],
        "three_images": verdict["three_images"],
        "images_zero_reencode": verdict["images_zero_reencode"],
        "joint_names_same_as_player": verdict["joint_names_same_as_player"],
        "source_highpoly_has_no_skin": verdict["source_highpoly_has_no_skin"],
    }
    out = {"foe": foe, "player_joint_names": player["joint_node_names"],
           "source": {"file": SOURCE.name, "bytes": source["bytes"],
                      "images": source["images"],
                      "primitives": source["primitives"]},
           "verdict": verdict, "checks": checks,
           "failed": [k for k, v in checks.items() if not v],
           "ok": all(checks.values())}
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("VERDICT", json.dumps(verdict, ensure_ascii=False))
    print("SKINNED_NODES", foe["skinned_nodes"])
    print("JOINTS", foe["joint_node_names"])
    print("PRIMS", [(p["verts"], p["has_joints"], p["has_weights"])
                    for p in foe["primitives"]])
    for k, v in checks.items():
        print("CHECK", k, v)
    print("FOE_GLTF_OK" if out["ok"] else "FOE_GLTF_FAILED")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== H/install_assets_h.py =====
"""H 路线 P2：把 foe-rigged.glb 与 foe 版 motion 装进可运行游戏工程。

只读 H 工作区产物，二进制复制，逐项 sha256 核对；不改任何既有文件。
Godot editor 导入可 headless（渲染才需要窗口）。
用法：python install_assets_h.py
"""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import time
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
LOGS = HERE / "logs"
OUT = HERE / "data" / "install_assets_h.json"

SOURCES = [
    (HERE / "foe-rigged.glb", "assets/3d/foe-rigged.glb"),
    (HERE / "data" / "motion_input_foe.json",
     "data/motion_input_foe.json"),
]


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd: list[str], env: dict, timeout: int, log: Path):
    t0 = time.perf_counter()
    try:
        r = subprocess.run(cmd, env=env, capture_output=True, timeout=timeout)
        code, out, err = r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired as exc:
        code = -1
        out = exc.stdout or b""
        err = (exc.stderr or b"") + b"\n=== TIMEOUT ===\n"
    text = (out + b"\n=== STDERR ===\n" + err).decode("utf-8", "replace")
    log.write_text(text, encoding="utf-8")
    return round(time.perf_counter() - t0, 3), code, text


def main() -> int:
    assert GODOT.is_file(), GODOT
    LOGS.mkdir(parents=True, exist_ok=True)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    (GAME / "assets" / "3d").mkdir(parents=True, exist_ok=True)

    copies = []
    for src, rel in SOURCES:
        assert src.is_file(), src
        dst = GAME / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        a, b = sha256(src), sha256(dst)
        copies.append({"src": str(src), "dst": str(dst), "rel": rel,
                       "bytes": dst.stat().st_size, "sha256": a,
                       "identical": a == b})
    env = os.environ.copy()
    dt, rc, text = run(
        [str(GODOT), "--headless", "--editor", "--quit",
         "--path", str(GAME)],
        env, 300, LOGS / "godot_editor_import_game_h.log")
    errors = text.count("SCRIPT ERROR") + text.count("Parse Error")

    d3 = GAME / "assets" / "3d"
    generated = []
    for p in sorted(d3.rglob("*")):
        if p.is_file() and p.name.startswith("foe-rigged"):
            row = {"rel": str(p.relative_to(GAME)).replace("\\", "/"),
                   "bytes": p.stat().st_size, "sha256": sha256(p)}
            if p.suffix.lower() == ".png":
                with Image.open(p) as im:
                    row["size"] = [im.width, im.height]
            generated.append(row)
    pngs = [g for g in generated if g["rel"].endswith(".png")]

    checks = {
        "two_copies_identical": all(c["identical"] for c in copies),
        "import_rc": rc == 0,
        "import_no_parse_errors": errors == 0,
        "glb_import_stamp": (d3 / "foe-rigged.glb.import").is_file(),
        "three_pbr_extracted": len(pngs) == 3,
        "pbr_all_4096": all(g.get("size") == [4096, 4096] for g in pngs),
        "foe_motion_in_game": (GAME / "data" / "motion_input_foe.json").is_file(),
        "player_glb_untouched": (
            sha256(d3 / "player-rigged.glb")
            == sha256(HERE.parent / "F路线-Godot驱动层" / "player-rigged.glb")),
    }
    ok = all(checks.values())
    OUT.write_text(json.dumps({
        "import": {"seconds": dt, "returncode": rc, "errors": errors},
        "copies": copies, "generated": generated,
        "checks": checks, "failed": [k for k, v in checks.items() if not v],
        "ok": ok,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    for c in copies:
        print(f"COPY {c['rel']:40s} {c['bytes']:>10} B "
              f"sha={c['sha256'][:12]} identical={c['identical']}")
    print(f"IMPORT rc={rc} {dt}s errors={errors} "
          f"generated={len(generated)} pngs={len(pngs)}")
    for k, v in checks.items():
        print("CHECK", k, v)
    print("INSTALL_ASSETS_H_OK" if ok else "INSTALL_ASSETS_H_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


