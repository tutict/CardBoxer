SHAPE mi_root_keys ['apose_points', 'bones', 'cards', 'chain', 'joint_names', 'mapping', 'px_to_m', 'source', 'stance']
SHAPE mif_root_keys ['apose_points', 'bones', 'cards', 'chain', 'joint_names', 'mapping', 'px_to_m', 'source', 'stance']
SHAPE cm_root_keys ['cards', 'motions', 'rhythm', 'stance', 'units', 'warnings']
SHAPE mi_first_card jab
SHAPE mi_first_card_keys ['frames', 'track']
SHAPE mi_first_frame_keys ['b_elbow', 'b_foot', 'b_hand', 'b_knee', 'f_elbow', 'f_foot', 'f_hand', 'f_knee', 'head', 'hip', 'shoulder']
SHAPE cm_first_frame_keys ['b_elbow', 'b_foot', 'b_hand', 'b_knee', 'f', 'f_elbow', 'f_foot', 'f_hand', 'f_knee', 'head', 'hip', 'k', 'lean', 'phase', 'shoulder', 'torso_deg']
SHAPE joint_names ['hip', 'shoulder', 'head', 'f_elbow', 'f_hand', 'b_elbow', 'b_hand', 'f_knee', 'f_foot', 'b_knee', 'b_foot']
CMP mi/cm {'same_keys': True, 'mismatches': 0, 'first': []}
CMP mi/mif {'same_keys': True, 'mismatches': 0, 'first': []}
CARDS {'hybrid_tracks': 15, 'mi_cards': 15, 'hybrid_only': [], 'mi_only': [], 'frame_counts_match': True}
SER motion_input.json bytes 72940 crlf 0 lf 1 head '{"source":"baked2.json","joint_names":["hip","shoulder","head","f_elbow","f_hand","b_elbow","b_hand","f_knee","f_foot","b_knee","b_foot"],"stance":{"hip":[0.0,-'
SER motion_input_foe.json bytes 72938 crlf 0 lf 1 head '{"source":"baked2.json","joint_names":["hip","shoulder","head","f_elbow","f_hand","b_elbow","b_hand","f_knee","f_foot","b_knee","b_foot"],"stance":{"hip":[0.0,-'
SER card_motion.json bytes 226918 crlf 16079 lf 16079 head '{\r\n "units": "game px; origin at the feet; +x forward; -y up",\r\n "rhythm": "hold=CONSTANT, snap=LINEAR, ease=BEZIER",\r\n "stance": {\r\n  "hip": [\r\n   0.0,\r\n   -80'
CHECK mi_track_is_11_joints True
CHECK three_tables_11joints_identical True
CHECK hybrid_card_keys_match_mi True
CHECK hybrid_frame_counts_match True
CHECK mi_and_mif_same_schema True
LAYOUT_PROBE_OK
