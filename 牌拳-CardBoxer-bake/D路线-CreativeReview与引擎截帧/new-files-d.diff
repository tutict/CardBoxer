+    copy_ok = sha256(PROBE / "assets" / "foe-full.glb") == sha256(src_glb)
+    game_glb = [p for p in GAME.rglob("*")
+                if p.is_file() and p.suffix.lower() in (".glb", ".gltf")]
+    logs = ["godot_render_3d.log", "godot_editor_import_d.log"]
