"""I 路线收口：在 I 改动后的游戏树上跑 15 套引擎内自检。

口径与 H 路线 run_all_checks_h.py 完全一致（同一批 res:// 脚本、
同一套 OK/FAIL 判定），输出落到 I/logs/checks 与 I/data，不覆盖 H 归档。
用法：python run_all_checks_i.py
"""
from __future__ import annotations

import json
import subprocess
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
