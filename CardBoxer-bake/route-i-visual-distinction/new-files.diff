===== I/crosscheck_filelist_i.py =====
"""独立复核 I 路线文件清单：重新遍历目录，逐条比对路径/字节/sha256。

刻意不 import make_filelist_i.py，避免「两边用同一个错函数一起错」。
用法：python crosscheck_filelist_i.py
"""
from __future__ import annotations

import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
LIST = HERE / "文件清单.txt"
SKIP_NAMES = {"文件清单.txt", "new-files.diff"}
SKIP_DIRS = {"logs", ".godot", "__pycache__", "orig"}


def digest(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def main() -> int:
    actual = {}
    for p in HERE.rglob("*"):
        if not p.is_file() or p.name in SKIP_NAMES:
            continue
        rel = p.relative_to(HERE)
        if any(part in SKIP_DIRS for part in rel.parts):
            continue
        key = str(rel).replace("\\", "/")
        actual[key] = (p.stat().st_size, digest(p))

    declared = {}
    for ln in LIST.read_bytes().decode("utf-8").splitlines():
        if not ln or ln.startswith("#"):
            continue
        parts = ln.split("\t")
        if len(parts) != 3:
            print("BAD ROW", repr(ln))
            continue
        declared[parts[0]] = (int(parts[1]), parts[2])

    bad = [k for k, v in declared.items() if actual.get(k) != v]
    extra = sorted(set(actual) - set(declared))
    missing = sorted(set(declared) - set(actual))
    ok = not bad and not extra and not missing and len(declared) > 40
    print(f"ROWS={len(declared)} ACTUAL={len(actual)} "
          f"BAD={len(bad)} EXTRA={len(extra)} MISSING={len(missing)}")
    for k in bad[:10]:
        print("  MISMATCH", k)
    for k in extra[:10]:
        print("  EXTRA", k)
    for k in missing[:10]:
        print("  MISSING", k)
    print("CROSSCHECK_I_OK" if ok else "CROSSCHECK_I_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== I/diag_leak_i.py =====
"""I 路线：定位「玩家 ROI 在 on/plain 之间变化」到底落在哪。

零操作对照已证明同状态逐像素 0，所以这不是抖动。
输出：变化像素的行/列直方图、10×10 热块 top10、变化像素的平均色差，
并画一张放大差分热图 boards/I-玩家侧泄漏热图.png。

诚实口径：本脚本只定位，不粉饰。若机制仍不明，验证记录里写「未定位」。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops, ImageDraw, ImageEnhance

HERE = Path(__file__).resolve().parent
H = HERE.parent / "H路线-双方3D侧面战斗"
SHOTS = HERE / "shots" / "visual_ab"
OUT = HERE / "data" / "player_leak_i.json"
BOARD = HERE / "boards" / "I-玩家侧泄漏热图.png"
THR = 18
ROI = json.loads((H / "data" / "roi_h.json").read_text(
    encoding="utf-8"))["boxes"][0]


def main() -> int:
    a = Image.open(SHOTS / "vis-on.png").convert("RGB").crop(ROI)
    b = Image.open(SHOTS / "vis-plain.png").convert("RGB").crop(ROI)
    d = ImageChops.difference(a, b)
    w, h = a.size
    ap = list(a.get_flattened_data())
    bp = list(b.get_flattened_data())
    dp = list(d.get_flattened_data())
    rows = [0] * h
    cols = [0] * w
    blocks = {}
    deltas = []
    for idx, px in enumerate(dp):
        if sum(px) <= THR:
            continue
        y, x = divmod(idx, w)
        rows[y] += 1
        cols[x] += 1
        key = (y // 10, x // 10)
        blocks[key] = blocks.get(key, 0) + 1
        deltas.append([ap[idx][c] - bp[idx][c] for c in range(3)])
    span = [i for i, v in enumerate(rows) if v > 0]
    cspan = [i for i, v in enumerate(cols) if v > 0]
    mean_delta = ([round(sum(v[c] for v in deltas) / len(deltas), 2)
                   for c in range(3)] if deltas else [0, 0, 0])
    top = sorted(blocks.items(), key=lambda kv: -kv[1])[:10]
    out = {
        "roi": ROI, "size": [w, h], "threshold_sum_rgb": THR,
        "changed_px": len(deltas),
        "changed_ratio": round(len(deltas) / (w * h), 4),
        "mean_delta_on_minus_plain": mean_delta,
        "row_span": [min(span), max(span)] if span else [],
        "col_span": [min(cspan), max(cspan)] if cspan else [],
        "top_10px_blocks": [{"block": [k[1] * 10, k[0] * 10],
                             "changed_px": v} for k, v in top],
        "max_row": max(rows) if rows else 0,
        "max_col": max(cols) if cols else 0,
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    # 热图：差分放大 + 原图并列
    z = 3
    heat = ImageEnhance.Brightness(d).enhance(3.0)
    canvas = Image.new("RGB", (2 * w * z + 60, h * z + 60), (20, 24, 34))
    canvas.paste(a.resize((w * z, h * z), Image.LANCZOS), (20, 20))
    canvas.paste(heat.resize((w * z, h * z), Image.LANCZOS),
                 (w * z + 40, 20))
    dr = ImageDraw.Draw(canvas)
    dr.text((20, h * z + 26), "玩家 ROI · on", fill=(160, 225, 205))
    dr.text((w * z + 40, h * z + 26), "差分 ×3（亮 = 变化）",
            fill=(240, 180, 150))
    BOARD.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(BOARD)
    print("CHANGED", out["changed_px"], "RATIO", out["changed_ratio"])
    print("MEAN_DELTA", mean_delta, "ROW_SPAN", out["row_span"],
          "COL_SPAN", out["col_span"])
    print("TOP_BLOCKS", out["top_10px_blocks"][:5])
    print("WROTE", BOARD.name, BOARD.stat().st_size, "B")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== I/diag_rootcause_i.py =====
"""I 路线 P0 汇总：把三条独立证据合成一条可复算的根因结论。

1. 贴图：UV 岛（非黑区）亮度差 70.99，玩家亮、对手暗（texture_i.json）。
2. 材质：两份 GLB 在 Godot 里都是 StandardMaterial3D，metallic=1.0 /
   roughness=1.0 乘数 + 独立 metallicRoughnessTexture，只有贴图内容不同
   （material_i.json）。
3. 渲染：H 路线同进程 vp_diag 两帧里，角色主体亮度 95.02 vs 106.2，
   对手反而更亮 11.18 —— 贴图差异被渲染链吃掉甚至反转。

结论：造型撞车之外，「贴图暗却看不出暗」是渲染链问题（四盏固定方向
高强度灯 + 金属度乘数 1.0 让 albedo 不参与漫反射）。因此**不需要重做
3D 模型**，表现层（tint / metallic / 灯光 / 轮廓）就能把两人分开。

输出 data/rootcause_i.json。只读，不改任何资产或源码。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageStat

HERE = Path(__file__).resolve().parent
H = HERE.parent / "H路线-双方3D侧面战斗"
OUT = HERE / "data" / "rootcause_i.json"
# H 路线自动定位的两个角色 ROI（取中间主体区域，避开大部分背景）
SUBJECT = {"player": (380, 300, 468, 525),
           "foe": (812, 300, 902, 525)}
SHOTS = {"player": H / "shots" / "vp_diag" / "vp-foe-hidden.png",
         "foe": H / "shots" / "vp_diag" / "vp-player-hidden.png"}


def luma(path: Path, box) -> tuple[list[float], float]:
    im = Image.open(path).convert("RGB").crop(box)
    m = [round(v, 2) for v in ImageStat.Stat(im).mean]
    return m, round(sum(m) / 3.0, 2)


def main() -> int:
    tex = json.loads((HERE / "data" / "texture_i.json").read_text(
        encoding="utf-8"))
    mat = json.loads((HERE / "data" / "material_i.json").read_text(
        encoding="utf-8"))
    surfaces = mat["standard_surfaces"]
    lit_gap = tex["deltas"]["mean_lit_luma_player_minus_foe"]
    lit_ratio_gap = tex["deltas"]["lit_ratio_player_minus_foe"]

    subject = {}
    for k, p in SHOTS.items():
        rgb, lum = luma(p, SUBJECT[k])
        subject[k] = {"rgb": rgb, "luma": lum, "box": list(SUBJECT[k]),
                      "source": str(p)}
    render_gap = round(subject["player"]["luma"]
                       - subject["foe"]["luma"], 2)

    metal = {k: [s.get("metallic") for s in v]
             for k, v in surfaces.items()}
    rough = {k: [s.get("roughness") for s in v]
             for k, v in surfaces.items()}
    tex_paths = {k: [s.get("metallic_texture", "") for s in v]
                 for k, v in surfaces.items()}

    out = {
        "texture_lit_luma_gap": lit_gap,
        "texture_black_fill_ratio_gap": lit_ratio_gap,
        "hypothesis_falsified": tex["hypothesis_falsified"],
        "material_multipliers": {"metallic": metal, "roughness": rough},
        "metallic_textures": tex_paths,
        "render_subject": subject,
        "render_luma_gap_player_minus_foe": render_gap,
    }
    out["checks"] = {
        "texture_gap_is_real": lit_gap > 50.0,
        "black_fill_ruled_out": abs(lit_ratio_gap) < 0.10
                                and tex["hypothesis_falsified"] is True,
        "both_materials_standard_and_metallic": all(
            v == [1.0] for v in metal.values())
            and all(len(v) > 0 for v in surfaces.values()),
        "both_have_metallic_texture": all(
            all(bool(t) for t in v) for v in tex_paths.values()),
        "render_gap_flat_or_inverted": render_gap < 20.0,
    }
    out["root_cause"] = (
        "四盏固定方向高强度灯 + metallic 乘数 1.0 抑制 albedo 漫反射，"
        "把贴图 70.99 的亮度差吃成渲染 -11.18；属渲染链，不是贴图也不是拓扑"
        if all(out["checks"].values()) else
        "三条证据未同时成立，根因待查，不得据此动表现层")
    out["decision"] = (
        "表现层可修：tint + 降 metallic + 降灯能量 + 加宽轮廓；"
        "不重做 3D 模型（重做要重跑 Voxel/绑骨/GLB/rest 全链）"
        if all(out["checks"].values()) else "先补诊断，不动手")
    out["ok"] = all(out["checks"].values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("TEXTURE_LIT_GAP", lit_gap, "BLACK_FILL_GAP", lit_ratio_gap)
    print("METALLIC", metal, "ROUGHNESS", rough)
    print("RENDER_SUBJECT", {k: v["luma"] for k, v in subject.items()},
          "GAP", render_gap)
    print("ROOT_CAUSE", out["root_cause"])
    print("DECISION", out["decision"])
    for k, v in out["checks"].items():
        print("CHECK", k, v)
    print("ROOTCAUSE_I_OK" if out["ok"] else "ROOTCAUSE_I_INCONCLUSIVE")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== I/diag_texture_i.py =====
"""I 路线 P0 根因诊断：贴图均值差 3.3 倍，为什么渲染只差 9.27 亮度？

原假设：4096² basecolor 里 UV 岛之外有大片黑填充，整图均值被黑区拉低。
实测证伪：非黑区（UV 岛）亮度差 70.99，与整图 70.66 同量级，
黑填充占比只差 3.1%。所以「贴图暗」是真的，抹平发生在渲染链，
不在贴图。这个负结果保留在 data/texture_i.json，不放宽阈值粉饰。

用 256×256 LANCZOS 抽样（4096² 全逐像素太慢，抽样足够判分布），
分别算：全图均值、非近黑像素占比、只看非近黑区域的均值、红蓝偏色。
输出 data/texture_i.json。只读，不改资产。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
OUT = HERE / "data" / "texture_i.json"
TEX = {
    "player": GAME / "assets/3d" /
              "player-rigged_texture_pbr_20250901.png",
    "foe": GAME / "assets/3d" /
           "foe-rigged_texture_pbr_20250901.png",
}
NEAR_BLACK = 30   # sum(R,G,B) < 30 视为 UV 岛外的黑填充


def analyse(path: Path) -> dict:
    im = Image.open(path).convert("RGB")
    orig_size = list(im.size)
    px = list(im.resize((256, 256), Image.LANCZOS).getdata())
    n = len(px)
    mean_all = [round(sum(p[i] for p in px) / n, 2) for i in range(3)]
    lit = [p for p in px if sum(p) >= NEAR_BLACK]
    dark = n - len(lit)
    mean_lit = ([round(sum(p[i] for p in lit) / len(lit), 2)
                 for i in range(3)] if lit else [0.0, 0.0, 0.0])
    return {
        "file": path.name, "orig_size": orig_size, "bytes": path.stat().st_size,
        "sample": [256, 256],
        "mean_all_rgb": mean_all,
        "mean_all_luma": round(sum(mean_all) / 3.0, 2),
        "near_black_px": dark, "lit_px": len(lit),
        "lit_ratio": round(len(lit) / n, 4),
        "mean_lit_rgb": mean_lit,
        "mean_lit_luma": round(sum(mean_lit) / 3.0, 2),
        "red_minus_blue": round(mean_all[0] - mean_all[2], 2),
    }


def main() -> int:
    rows = {k: analyse(v) for k, v in TEX.items()}
    out = {"near_black_threshold_sum_rgb": NEAR_BLACK, "textures": rows}
    out["deltas"] = {
        "mean_all_luma_player_minus_foe": round(
            rows["player"]["mean_all_luma"]
            - rows["foe"]["mean_all_luma"], 2),
        "mean_lit_luma_player_minus_foe": round(
            rows["player"]["mean_lit_luma"]
            - rows["foe"]["mean_lit_luma"], 2),
        "lit_ratio_player_minus_foe": round(
            rows["player"]["lit_ratio"] - rows["foe"]["lit_ratio"], 4),
    }
    # 原假设（黑填充拉低整图均值）已被实测证伪：UV 岛亮度差 70.99
    # 与整图 70.66 同量级，黑填充仅差 3.1%。这里把「证伪」本身当结果，
    # 不放宽阈值假装假设成立；根因转查材质/光照，见 rootcause_i.json。
    d = out["deltas"]
    checks = {
        "full_image_luma_gap_is_large": (
            d["mean_all_luma_player_minus_foe"] > 50.0),
        "uv_island_gap_same_order": (
            abs(d["mean_lit_luma_player_minus_foe"])
            > abs(d["mean_all_luma_player_minus_foe"]) * 0.9),
        "black_fill_not_the_cause": (
            abs(d["lit_ratio_player_minus_foe"]) < 0.10),
        "both_are_4096": all(
            r["orig_size"] == [4096, 4096] for r in rows.values()),
    }
    falsified = (checks["uv_island_gap_same_order"]
                 and checks["black_fill_not_the_cause"])
    out["hypothesis_falsified"] = falsified
    out["checks"] = checks
    out["root_cause"] = (
        "贴图确实整体暗（UV 岛亮度差 70.99），黑填充只差 3.1%；"
        "渲染亮度差被抹平的原因不在贴图，转查材质/光照"
        if falsified else
        "UV 岛外的黑填充主导整图均值差，需按非黑区重新评估")
    out["ok"] = all(checks.values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for k, r in rows.items():
        print(k, "mean_all", r["mean_all_rgb"], "lit_ratio", r["lit_ratio"],
              "mean_lit", r["mean_lit_rgb"])
    print("DELTAS", d)
    print("ROOT_CAUSE", out["root_cause"])
    for k, v in out["checks"].items():
        print("CHECK", k, v)
    print("TEXTURE_I_OK" if out["ok"] else "TEXTURE_I_INCONCLUSIVE")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== I/diag_visual_i.py =====
"""I 路线 P3：把四帧同进程 A/B 量化成可复算的区分度指标。

base   = 无 3D 层（纯背景）
on     = foe 视觉启用
plain  = set_foe_visual(false)（H 原样）
again  = 再次启用（验证可反复切换）

角色掩膜用 sum(|frame - base|) > 18 造：这样亮度只统计角色像素，
不被擂台背景稀释（H 路线 ROI 均值的教训）。
输出 data/visual_diag_i.json；只读 PNG，不改源码或资产。
"""
from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageChops, ImageStat

HERE = Path(__file__).resolve().parent
H = HERE.parent / "H路线-双方3D侧面战斗"
SHOTS = HERE / "shots" / "visual_ab"
OUT = HERE / "data" / "visual_diag_i.json"
THR = 18

ROI = json.loads((H / "data" / "roi_h.json").read_text(
    encoding="utf-8"))["boxes"]
LEFT, RIGHT = ROI[0], ROI[1]
# H 的 ROI 只有 126/128 px 宽，角色加宽后会被裁断，宽度比恒为 1.0。
# 用更宽的窗口专门量轮廓宽度（仍以 base 帧作背景参考）。
WIDE_FOE = (730, 280, 985, 545)


def load(tag: str) -> Image.Image:
    return Image.open(SHOTS / f"vis-{tag}.png").convert("RGB")


def diff(a: Image.Image, b: Image.Image, box) -> dict:
    ia, ib = a.crop(box), b.crop(box)
    d = ImageChops.difference(ia, ib)
    changed = sum(1 for px in d.get_flattened_data() if sum(px) > THR)
    total = ia.width * ia.height
    return {"changed_px": changed, "total_px": total,
            "ratio": round(changed / total, 4),
            "mae": round(sum(ImageStat.Stat(d).mean) / 3.0, 4)}


def mask_stats(frame: Image.Image, base: Image.Image, box) -> dict:
    fa, ba = frame.crop(box), base.crop(box)
    d = ImageChops.difference(fa, ba)
    fp = list(fa.get_flattened_data())
    dp = list(d.get_flattened_data())
    w, h = fa.size
    hits = [i for i, px in enumerate(dp) if sum(px) > THR]
    if not hits:
        return {"mask_px": 0, "luma": 0.0, "rgb": [0, 0, 0],
                "width_px": 0, "red_minus_blue": 0.0}
    rgb = [round(sum(fp[i][c] for i in hits) / len(hits), 2)
           for c in range(3)]
    cols = [i % w for i in hits]
    return {
        "mask_px": len(hits),
        "rgb": rgb,
        "luma": round(sum(rgb) / 3.0, 2),
        "red_minus_blue": round(rgb[0] - rgb[2], 2),
        "width_px": max(cols) - min(cols) + 1,
        "mask_ratio": round(len(hits) / (w * h), 4),
    }


def main() -> int:
    imgs = {t: load(t) for t in
            ("base", "on", "on-repeat", "plain", "again")}
    out = {"threshold_sum_rgb": THR, "left_roi": LEFT, "right_roi": RIGHT}
    out["diffs"] = {
        # 零操作对照：同状态两帧。若这里的 changed_px > 0，
        # 后面 on_vs_plain 的玩家侧差异就不能全算到视觉开关头上。
        "player_roi_noop": diff(imgs["on"], imgs["on-repeat"], LEFT),
        "foe_roi_noop": diff(imgs["on"], imgs["on-repeat"], RIGHT),
        "player_roi_on_vs_plain": diff(imgs["on"], imgs["plain"], LEFT),
        "foe_roi_on_vs_plain": diff(imgs["on"], imgs["plain"], RIGHT),
        "player_roi_on_vs_base": diff(imgs["on"], imgs["base"], LEFT),
        "foe_roi_on_vs_again": diff(imgs["on"], imgs["again"], RIGHT),
        "full_frame_on_vs_plain": diff(
            imgs["on"], imgs["plain"], (0, 0, 1280, 720)),
    }
    out["masks"] = {
        "player_on": mask_stats(imgs["on"], imgs["base"], LEFT),
        "player_plain": mask_stats(imgs["plain"], imgs["base"], LEFT),
        "foe_on": mask_stats(imgs["on"], imgs["base"], RIGHT),
        "foe_plain": mask_stats(imgs["plain"], imgs["base"], RIGHT),
        "foe_on_wide": mask_stats(imgs["on"], imgs["base"], WIDE_FOE),
        "foe_plain_wide": mask_stats(imgs["plain"], imgs["base"],
                                     WIDE_FOE),
    }
    m = out["masks"]
    out["metrics"] = {
        "luma_gap_player_minus_foe_on": round(
            m["player_on"]["luma"] - m["foe_on"]["luma"], 2),
        "luma_gap_player_minus_foe_plain": round(
            m["player_plain"]["luma"] - m["foe_plain"]["luma"], 2),
        "foe_luma_drop_on_vs_plain": round(
            m["foe_plain"]["luma"] - m["foe_on"]["luma"], 2),
        "red_blue_shift_delta": round(
            (m["player_on"]["red_minus_blue"]
             - m["foe_on"]["red_minus_blue"])
            - (m["player_plain"]["red_minus_blue"]
               - m["foe_plain"]["red_minus_blue"]), 2),
        "foe_width_ratio_on_over_plain": round(
            m["foe_on"]["width_px"] / max(1, m["foe_plain"]["width_px"]), 4),
        "player_luma_change_on_vs_plain": round(
            m["player_on"]["luma"] - m["player_plain"]["luma"], 2),
        "foe_width_ratio_wide": round(
            m["foe_on_wide"]["width_px"]
            / max(1, m["foe_plain_wide"]["width_px"]), 4),
    }
    d = out["diffs"]
    q = out["metrics"]
    spec = json.loads((HERE / "data" / "visual_diff_spec.json").read_text(
        encoding="utf-8"))["targets"]
    checks = {
        "noop_frames_identical": (
            d["player_roi_noop"]["changed_px"] == 0
            and d["foe_roi_noop"]["changed_px"] == 0),
        "player_roi_pixel_identical": (
            d["player_roi_on_vs_plain"]["changed_px"]
            == spec["player_roi_changed_px"]),
        "player_luma_unchanged": abs(
            q["player_luma_change_on_vs_plain"]) < 0.01,
        "foe_roi_changed": d["foe_roi_on_vs_plain"]["ratio"] > 0.30,
        "luma_gap_above_target": (
            q["luma_gap_player_minus_foe_on"]
            >= spec["min_luma_gap_player_minus_foe"]),
        "foe_substantially_darker": q["foe_luma_drop_on_vs_plain"] > 50.0,
        "color_shift_visible": (
            abs(q["red_blue_shift_delta"])
            >= spec["min_abs_red_blue_shift"]),
        "repeat_switch_deterministic": (
            d["foe_roi_on_vs_again"]["changed_px"] == 0),
        "wide_roi_wider_than_plain": (
            q["foe_width_ratio_wide"]
            >= spec["min_subject_width_ratio"]),
    }
    out["checks"] = checks
    out["failed"] = [k for k, v in checks.items() if not v]
    out["ok"] = all(checks.values())
    out["wide_foe_roi"] = list(WIDE_FOE)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for k, v in out["diffs"].items():
        print("DIFF", k, v)
    for k, v in m.items():
        print("MASK", k, "luma", v["luma"], "w", v["width_px"],
              "px", v["mask_px"], "rb", v["red_minus_blue"])
    print("METRICS", out["metrics"])
    for k, v in checks.items():
        print("CHECK", k, v)
    print("VISUAL_DIAG_I_OK" if out["ok"] else "VISUAL_DIAG_I_FAILED")
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== I/make_baseline_i.py =====
"""I 路线 P0：备份「H 完成态」的可运行游戏工程，写逐文件 size+sha256 基线。

二进制复制；排除 .godot/ 与 __pycache__/。
用法：python make_baseline_i.py
"""
from __future__ import annotations

import hashlib
import json
import shutil
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
ORIG = HERE / "orig" / "pre-visual"
BASELINE = HERE / "baseline_i.json"
EXCLUDE_DIRS = {".godot", "__pycache__"}


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def game_files() -> list[Path]:
    out = []
    for p in sorted(GAME.rglob("*")):
        if not p.is_file():
            continue
        rel = p.relative_to(GAME)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        out.append(p)
    return out


def main() -> int:
    files = game_files()
    rows = []
    for p in files:
        rel = p.relative_to(GAME)
        dst = ORIG / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, dst)
        rows.append({"rel": str(rel).replace("\\", "/"),
                     "size": p.stat().st_size,
                     "sha256": sha256(p)})
    mismatch = []
    for row in rows:
        q = ORIG / row["rel"]
        if not q.is_file() or q.stat().st_size != row["size"] \
                or sha256(q) != row["sha256"]:
            mismatch.append(row["rel"])
    payload = {
        "game": str(GAME), "count": len(rows),
        "backup": str(ORIG), "backup_verified": not mismatch,
        "backup_mismatch": mismatch, "files": rows,
    }
    BASELINE.write_text(json.dumps(payload, ensure_ascii=False, indent=2)
                        + "\n", encoding="utf-8")
    print(f"BASELINE_FILES={len(rows)} BACKUP_VERIFIED={not mismatch} "
          f"MISMATCH={len(mismatch)}")
    print("BASELINE_I_OK" if not mismatch else "BASELINE_I_FAILED")
    return 0 if not mismatch else 1


if __name__ == "__main__":
    raise SystemExit(main())


