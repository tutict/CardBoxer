              "overrides", r.get("player_overrides"),
              r.get("foe_overrides"))
    for k, v in checks.items():
        print("CHECK", k, v)
    print("LIGHT_ISOLATION_I_OK" if ok else "LIGHT_ISOLATION_I_FAILED")
    return 0 if ok else 1


