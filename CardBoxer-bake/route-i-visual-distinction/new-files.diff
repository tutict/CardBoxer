def j(rel: str) -> dict:
    return json.loads((HERE / rel).read_text(encoding="utf-8"))


def sha(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def game_rels() -> set[str]:
    out = set()
    for p in GAME.rglob("*"):
        if not p.is_file():
            continue
        rel = p.relative_to(GAME)
        if any(part in (".godot", "__pycache__") for part in rel.parts):
            continue
        out.add(str(rel).replace("\\", "/"))
    return out


def filelist_actual() -> dict[str, tuple[int, str]]:
    skip = {"logs", ".godot", "__pycache__", "orig"}
    names = {"文件清单.txt", "new-files.diff"}
    out = {}
    for p in HERE.rglob("*"):
        if not p.is_file() or p.name in names:
            continue
        rel = p.relative_to(HERE)
        if any(part in skip for part in rel.parts):
            continue
        out[str(rel).replace("\\", "/")] = (p.stat().st_size, sha(p))
    return out


def main() -> int:
    spec = j("data/visual_diff_spec.json")
    baseline = j("baseline_i.json")
    rootcause = j("data/rootcause_i.json")
    texture = j("data/texture_i.json")
    material = j("data/material_i.json")
    v3 = j("data/patch_visual_v3_i.json")
    final = j("data/patch_visual_final_i.json")
    ab = j("data/visual_ab_i.json")
    diag = j("data/visual_diag_i.json")
    r1 = j("data/visual_diag_r1_failed.json")
    off = j("data/off_switch_i.json")
    allc = j("data/all_checks_i.json")
    static = j("data/static_ab_i.json")
    light = j("data/light_isolation_i.json")
    v1 = j("data/v1-failed/visual_diag_i.json")
    v2 = j("data/v2-failed/player_leak_i.json")

    src = LAYER.read_text(encoding="utf-8")
    tint = spec["canvas_tint"]
    tint_lit = "vec3(%s)" % ", ".join(f"{v:.2f}" for v in tint)
    sx, sy = (spec["silhouette"]["draw_scale_x"],
              spec["silhouette"]["draw_scale_y"])
    targets = spec["targets"]
    base_map = {r["rel"]: r["sha256"] for r in baseline["files"]}
    now = game_rels()
    changed = sorted(r for r, h in base_map.items()
                     if r in now and sha(GAME / r) != h)
    missing = sorted(r for r in base_map if r not in now)

    m = diag["metrics"]
    d = diag["diffs"]
    od = off["diffs"]
    c: dict[str, bool] = {}

    # A 源码形状 ---------------------------------------------------
    c["source_scale_matches_spec"] = (
        f"const FOE_DRAW_SCALE_X := {sx:.2f}" in src)
    c["source_scale_y_matches_spec"] = (
        f"const FOE_DRAW_SCALE_Y := {sy:.2f}" in src)
    c["source_tint_matches_spec"] = tint_lit in src
    c["source_has_canvas_shader"] = "shader_type canvas_item" in src
    c["source_canvas_mat_set_and_cleared"] = (
        "material = _foe_canvas_mat" in src and "material = null" in src)
    c["source_no_surface_override"] = (
        "set_surface_override_material" not in src)
    c["source_no_3d_material_duplicate"] = (
        "(base as StandardMaterial3D).duplicate()" not in src)
    c["source_no_light_energy_write"] = (
        'l.light_energy = float(row["energy"])' not in src)
    c["source_retired_constants_absent"] = all(
        n not in src for n in spec["material"]["retired_constants_absent"])
    c["source_off_switch_present"] = (
        '"CARD_BOXER_FOE_VISUAL"' in src and '!= "none"' in src)
    c["source_off_switch_scoped_to_foe"] = (
        'if p_role == "foe" and OS.get_environment(' in src)
    c["source_player_draw_path_identity_shape"] = all(
        s in src for s in (
            "FOE_DRAW_SCALE_X if foe_visual else 1.0",
            "FOE_DRAW_SCALE_Y if foe_visual else 1.0"))
    c["source_G_shape_preserved"] = all(s in src for s in [
        "const DEFAULT_SIDE_YAW := 55.0",
        "drv.apply_frame(c, f)", "_apply_stance_bias()"])
    c["source_collect_meshes_for_diagnostics"] = (
        "func _collect_meshes" in src)

    # B 基线对账 ---------------------------------------------------
    c["baseline_backup_verified"] = (baseline["backup_verified"] is True
                                     and not baseline["backup_mismatch"])
    c["baseline_only_layer_changed"] = (
        changed == ["scripts/fighter_3d_layer.gd"] and not missing)
    c["arena_sha_matches_baseline"] = (
        sha(ARENA) == base_map["scripts/arena.gd"])
    c["fighter_sha_matches_baseline"] = (
        sha(FIGHTER) == base_map["scripts/fighter.gd"])
    c["layer_sha_matches_final_report"] = (
        sha(LAYER) == final["sha256_after"]["scripts/fighter_3d_layer.gd"])

    # C 规格与负结果 -----------------------------------------------
    c["spec_revision_is_2"] = spec.get("revision") == 2
    c["spec_width_target_not_relaxed"] = (
        targets["min_subject_width_ratio"] == 1.1)
    c["spec_retired_constants_named"] = (
        spec["material"]["retired_constants_absent"]
        == ["FOE_TINT", "FOE_METALLIC_MULT", "FOE_CANVAS_TINT"])
    c["spec_off_targets_present"] = all(
        targets.get(k) is True for k in (
            "off_switch_disables_visual_layer",
            "off_state_same_process_pixel_identical",
            "default_off_pixel_identical"))
    c["r1_negative_result_kept_false"] = (
        r1.get("ok") is False
        and r1.get("checks", {}).get("wide_roi_wider_than_plain") is False
        and r1["metrics"]["foe_width_ratio_wide"] < 1.1)
    c["v1_negative_result_kept"] = (
        abs(v1["metrics"].get("player_luma_change_on_vs_plain", 0.0)) > 5.0)
    c["v2_negative_result_kept"] = v2.get("changed_px", 0) > 1000
    c["v3_patch_report_ok"] = v3.get("ok") is True
    c["final_patch_report_ok"] = final.get("ok") is True
    c["rootcause_points_to_render_chain"] = (
        rootcause.get("hypothesis_falsified") is True
        and "metallic" in rootcause.get("root_cause", "")
        and abs(rootcause["render_luma_gap_player_minus_foe"]) < 20.0)
    c["texture_gap_is_real"] = (
        texture["deltas"]["mean_lit_luma_player_minus_foe"] > 60.0)
    c["material_probe_ran"] = material.get("ok") is True

    # D 同进程 A/B --------------------------------------------------
    c["visual_ab_ok"] = ab.get("ok") is True
    c["visual_diag_ok"] = diag.get("ok") is True
    c["visual_diag_all_checks_true"] = all(diag["checks"].values())
    c["player_roi_pixel_identical"] = (
        d["player_roi_on_vs_plain"]["changed_px"]
        == targets["player_roi_changed_px"])
    c["noop_frames_identical"] = (
        d["player_roi_noop"]["changed_px"] == 0
        and d["foe_roi_noop"]["changed_px"] == 0)
    c["repeat_switch_deterministic"] = (
        d["foe_roi_on_vs_again"]["changed_px"] == 0)
    c["luma_gap_above_target"] = (
        m["luma_gap_player_minus_foe_on"]
        >= targets["min_luma_gap_player_minus_foe"])
    c["width_ratio_above_target"] = (
        m["foe_width_ratio_wide"] >= targets["min_subject_width_ratio"])
    c["color_shift_above_target"] = (
        abs(m["red_blue_shift_delta"])
        >= targets["min_abs_red_blue_shift"])
    c["foe_luma_drop_substantial"] = m["foe_luma_drop_on_vs_plain"] > 50.0
    c["player_luma_unchanged"] = (
        abs(m["player_luma_change_on_vs_plain"]) < 0.01)
    c["full_frame_change_is_scoped"] = abs(
        d["full_frame_on_vs_plain"]["changed_px"]
        - d["foe_roi_on_vs_plain"]["changed_px"]) < 2000
    roi_h = json.loads((H / "data" / "roi_h.json").read_text(
        encoding="utf-8"))["boxes"]
    c["width_uses_wide_roi"] = (
        (diag.get("wide_foe_roi", [0, 0, 0, 0])[2]
         - diag.get("wide_foe_roi", [0, 0, 0, 0])[0])
        > (roi_h[1][2] - roi_h[1][0]))
    c["light_isolation_ran"] = (light.get("ok") is True
                                and light.get(
                                    "player_lights_equal_but_pixels_changed")
                                is True)

    # E 可逆开关与回归 ---------------------------------------------
    c["off_switch_all_checks_true"] = all(off["checks"].values())
    c["off_switch_ok"] = off.get("ok") is True
    c["off_configure_did_not_enable"] = (
        off["payload"].get("foe_initial_visual") is False
        and off["payload"].get("env_visual_none") == "none")
    c["off_state_stable_and_restorable"] = (
        od["off1_vs_off2_full"]["changed_px"] == 0
        and od["off1_vs_restored_full"]["changed_px"] == 0)
    c["switch_has_teeth"] = (
        od["off1_vs_forced_foe_roi"]["ratio"] > 0.30)
    c["off_player_roi_never_changes"] = (
        od["off1_vs_forced_player_roi"]["changed_px"] == 0)
    c["all_checks_15_green"] = (
        allc["result"] == "ALL GREEN" and allc["total"] == 15
        and not allc["failed"] and len(allc["checks"]) == 15)
    c["static_ab_zero_pixels"] = (
        static["changed_pixels"] == 0 and static.get("ok") is True)

    # F 交付清单 ---------------------------------------------------
    c["filelist_present"] = LIST.is_file()
    declared = {}
    if LIST.is_file():
        for ln in LIST.read_bytes().decode("utf-8").splitlines():
            if not ln or ln.startswith("#"):
                continue
            p = ln.split("\t")
            if len(p) == 3:
                declared[p[0]] = (int(p[1]), p[2])
    actual = filelist_actual()
    c["filelist_populated"] = len(declared) > 40
    c["filelist_self_consistent"] = (
        bool(declared) and declared == actual)
    boards = ["I-视觉区分A-B.png", "I-r1-宽度未达标.png",
              "I-V1失败-全局变暗.png", "I-V2失败-玩家侧变暗.png",
              "I-玩家侧泄漏热图.png"]
    c["boards_present"] = all(
        (HERE / "boards" / b).is_file()
        and (HERE / "boards" / b).stat().st_size > 50000 for b in boards)

    failed = [k for k, v in c.items() if not v]
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps({"checks": c, "failed": failed,
                               "ok": not failed},
                              ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for k, v in c.items():
        print("CHECK", k, v)
    print(f"VERIFY_I {len(c) - len(failed)}/{len(c)} failed={len(failed)}")
    for k in failed:
        print("  FAILED", k)
    print("I_VERIFIED" if not failed else "I_NOT_VERIFIED")
    return 0 if not failed else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== I/tests/light_isolation_probe.gd =====
extends SceneTree
## I 路线诊断：on/plain 两态里，两个 SubViewport 的灯能量各是多少。
## 用来判定「玩家侧跟着变暗」是代码 bug 还是多 SubViewport 光照串扰。
## 跑法：godot --path . --resolution 1280x720 --quit-after 900 \
##        --script res://tests/light_isolation_probe.gd

const ArenaScene = preload("res://scenes/main.tscn")


class Driver:
	extends Node

	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 20

	var arena: Node2D
	var stage := 0
	var wait := 0
	var busy := false
	var initialized := false
	var rows: Array = []

	func _lights(layer) -> Array:
		var out: Array = []
		if layer == null or layer.sv == null:
			return out
		for c in layer.sv.get_children():
			if c is DirectionalLight3D:
				var l := c as DirectionalLight3D
				out.append({"energy": snappedf(l.light_energy, 0.0001),
					"r": snappedf(l.light_color.r, 0.0001),
					"g": snappedf(l.light_color.g, 0.0001),
					"b": snappedf(l.light_color.b, 0.0001)})
		return out

	func _overrides(layer) -> int:
		var n := 0
		if layer == null:
			return n
		for row in layer._mesh_rows:
			var mi: MeshInstance3D = row["mi"]
			if mi.get_surface_override_material(int(row["surface"])) != null:
				n += 1
		return n

	func _attach() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		if lp.setup(JSON.parse_string(
				FileAccess.get_file_as_string(MOTION_P))):
			arena.layer_3d = lp
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		if lf.setup(JSON.parse_string(
				FileAccess.get_file_as_string(MOTION_F))):
			arena.layer_3d_foe = lf
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true

	func _record(tag: String) -> void:
		rows.append({
			"tag": tag,
			"player_lights": _lights(arena.layer_3d),
			"foe_lights": _lights(arena.layer_3d_foe),
			"player_overrides": _overrides(arena.layer_3d),
			"foe_overrides": _overrides(arena.layer_3d_foe),
			"player_state": arena.layer_3d.visual_state()
					if arena.layer_3d != null else {},
			"foe_state": arena.layer_3d_foe.visual_state()
					if arena.layer_3d_foe != null else {},
		})

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
		wait += 1
		if wait < WARM:
			busy = false
			return
		wait = 0
		if stage == 0:
			_attach()
			_record("on")
		elif stage == 1:
			arena.layer_3d_foe.set_foe_visual(false)
			_record("plain")
		elif stage == 2:
			arena.layer_3d_foe.set_foe_visual(true)
			_record("again")
			print("ILIGHT_JSON " + JSON.stringify({"rows": rows}))
			get_tree().quit(0)
			return
		stage += 1
		busy = false


func _init() -> void:
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	root.add_child(d)


===== I/tests/material_probe.gd =====
extends SceneTree
## I 路线 P0：读回两份 GLB 在 Godot 里的真实材质参数。
## 目的：确认能否用 StandardMaterial3D.duplicate() 做运行时 tint，
## 而不是靠猜 GLB 导入后是什么材质类。
##
## 跑法：godot --headless --path . --script res://tests/material_probe.gd

const PLAYER_GLB := "res://assets/3d/player-rigged.glb"
const FOE_GLB := "res://assets/3d/foe-rigged.glb"


func _collect(n: Node, out: Array) -> void:
	if n is MeshInstance3D:
		out.append(n)
	for c in n.get_children():
		_collect(c, out)


func _info(res_path: String) -> Dictionary:
	var res := load(res_path)
	if res == null or not (res is PackedScene):
		return {"path": res_path, "error": "load failed"}
	var inst: Node = (res as PackedScene).instantiate()
	var meshes: Array = []
	_collect(inst, meshes)
	var rows: Array = []
	for m in meshes:
		var mi := m as MeshInstance3D
		var mesh := mi.mesh
		if mesh == null:
			rows.append({"mesh": mi.name, "error": "null mesh"})
			continue
		for i in range(mesh.get_surface_count()):
			var mat: Material = mesh.surface_get_material(i)
			var d := {
				"mesh": String(mi.name), "surface": i,
				"material_class": mat.get_class() if mat != null else "null",
			}
			if mat is StandardMaterial3D:
				var sm := mat as StandardMaterial3D
				d["albedo_color"] = [sm.albedo_color.r, sm.albedo_color.g,
					sm.albedo_color.b, sm.albedo_color.a]
				d["albedo_texture"] = (sm.albedo_texture.resource_path
					if sm.albedo_texture != null else "")
				d["metallic"] = sm.metallic
				d["roughness"] = sm.roughness
				d["metallic_texture"] = (sm.metallic_texture.resource_path
					if sm.metallic_texture != null else "")
				d["normal_texture"] = (sm.normal_texture.resource_path
					if sm.normal_texture != null else "")
			rows.append(d)
	return {"path": res_path, "surfaces": rows}


func _init() -> void:
	var out := {"player": _info(PLAYER_GLB), "foe": _info(FOE_GLB)}
	print("IMAT_JSON " + JSON.stringify(out))
	quit(0)


===== I/tests/off_switch_probe.gd =====
extends SceneTree
## I 路线：证明 CARD_BOXER_FOE_VISUAL=none 真的让 foe 层退回 H 原样。
##
## 同进程同树五帧（跨进程整帧像素等价已退役，见 H 路线记录）：
##   base     = 无 3D 层（纯背景，用来造角色掩膜）
##   off1     = 挂两层，env=none，configure("foe") 不得启用视觉层
##   off2     = 同状态再截一帧（零操作对照）
##   forced   = 手动 set_foe_visual(true)，证明本进程视觉层功能完好
##   restored = set_foe_visual(false)，证明能逐像素还原到 off1
##
## 跑法（必须带窗口）：
##   CARD_BOXER_FOE_VISUAL=none I_OFF_DIR=<abs> godot --path . \
##     --resolution 1280x720 --quit-after 900 \
##     --script res://tests/off_switch_probe.gd

const ArenaScene = preload("res://scenes/main.tscn")


class Driver:
	extends Node

	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 20

	var arena: Node2D
	var out_dir := ""
	var motion_p: Dictionary = {}
	var motion_f: Dictionary = {}
	var initialized := false
	var busy := false
	var stage := 0
	var wait := 0
	var rows: Array = []
	var states: Array = []
	var player_ready := false
	var foe_ready := false
	var foe_initial_visual := true

	func _snap(name: String) -> void:
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		var path := out_dir + "/off-" + name + ".png"
		var err := img.save_png(path)
		rows.append({"name": name, "path": path,
			"w": img.get_width(), "h": img.get_height(),
			"save_error": int(err)})

	func _attach() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		player_ready = lp.setup(motion_p)
		if player_ready:
			arena.layer_3d = lp
			arena.motion_3d = motion_p
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true
			arena.player.queue_redraw()
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		foe_ready = lf.setup(motion_f)
		if foe_ready:
			arena.layer_3d_foe = lf
			arena.motion_3d_foe = motion_f
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true
			arena.enemy.queue_redraw()
		foe_initial_visual = bool(lf.visual_state().get("foe_visual", true))

	func _record_state(tag: String) -> void:
		var s := {}
		if arena.layer_3d_foe != null:
			s = arena.layer_3d_foe.visual_state()
		s["tag"] = tag
		states.append(s)

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
			var pp: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_P))
			if pp is Dictionary:
				motion_p = pp
			var ff: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_F))
			if ff is Dictionary:
				motion_f = ff
		wait += 1
		if wait < WARM:
			busy = false
			return
		wait = 0
		if stage == 0:
			await _snap("base")
			_attach()
			_record_state("off1")
		elif stage == 1:
			await _snap("off1")
		elif stage == 2:
			await _snap("off2")
			arena.layer_3d_foe.set_foe_visual(true)
			_record_state("forced")
		elif stage == 3:
			await _snap("forced")
			arena.layer_3d_foe.set_foe_visual(false)
			_record_state("restored")
		elif stage == 4:
			await _snap("restored")
			var payload := {
				"shots": rows, "states": states,
				"player_layer_ready": player_ready,
				"foe_layer_ready": foe_ready,
				"foe_initial_visual": foe_initial_visual,
				"player_visual_state": arena.layer_3d.visual_state()
						if arena.layer_3d != null else {},
				"env_visual_none": OS.get_environment(
						"CARD_BOXER_FOE_VISUAL"),
			}
			var f := FileAccess.open(out_dir + "/off_result.json",
					FileAccess.WRITE)
			if f != null:
				f.store_string(JSON.stringify(payload, "\t"))
				f.close()
			print("IOFF_JSON " + JSON.stringify(payload))
			get_tree().quit(0)
			return
		stage += 1
		busy = false


func _init() -> void:
	var out_dir := OS.get_environment("I_OFF_DIR")
	if out_dir == "":
		print("IOFF_JSON " + JSON.stringify({"error": "I_OFF_DIR missing"}))
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	d.out_dir = out_dir
	root.add_child(d)
	print("IOFF_START out=%s" % out_dir)


===== I/tests/visual_diff_probe.gd =====
extends SceneTree
## I 路线：同进程同树 A/B，证明「对手侧视觉区分」生效且玩家侧零变化。
##
## 四帧（都在同一进程、同一棵树）：
##   base  = 无 3D 层（纯背景，用来造角色掩膜）
##   on    = 两层 + foe 视觉启用
##   plain = set_foe_visual(false)（H 路线原样）
##   again = set_foe_visual(true)（可反复切换 / 还原）
## 跨进程整帧像素等价不成立（RNG 随机化），所以 A/B 必须同进程。
##
## 跑法（必须带窗口）：
##   I_VIS_DIR=<abs> godot --path . --resolution 1280x720 \
##     --quit-after 900 --script res://tests/visual_diff_probe.gd

const ArenaScene = preload("res://scenes/main.tscn")


class Driver:
	extends Node

	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 20
	const NAMES := ["base", "on", "on-repeat", "plain", "again"]

	var arena: Node2D
	var out_dir := ""
	var motion_p: Dictionary = {}
	var motion_f: Dictionary = {}
	var initialized := false
	var busy := false
	var stage := 0
	var wait := 0
	var rows: Array = []
	var states: Array = []
	var player_ready := false
	var foe_ready := false

	func _snap(name: String) -> void:
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		var path := out_dir + "/vis-" + name + ".png"
		var err := img.save_png(path)
		var vp := RenderingServer.get_rendering_info(
			RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME)
		var dc := RenderingServer.get_rendering_info(
			RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME)
		rows.append({"name": name, "path": path,
			"w": img.get_width(), "h": img.get_height(),
			"save_error": int(err), "prims": float(vp),
			"draw_calls": float(dc)})

	func _attach() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		player_ready = lp.setup(motion_p)
		if player_ready:
			arena.layer_3d = lp
			arena.motion_3d = motion_p
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true
			arena.player.queue_redraw()
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		foe_ready = lf.setup(motion_f)
		if foe_ready:
			arena.layer_3d_foe = lf
			arena.motion_3d_foe = motion_f
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true
			arena.enemy.queue_redraw()

	func _record_state(tag: String) -> void:
		var s := {}
		if arena.layer_3d_foe != null:
			s = arena.layer_3d_foe.visual_state()
		s["tag"] = tag
		states.append(s)

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
			var pp: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_P))
			if pp is Dictionary:
				motion_p = pp
			var ff: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_F))
			if ff is Dictionary:
				motion_f = ff
		wait += 1
		if wait < WARM:
			busy = false
			return
		wait = 0
		if stage == 0:
			await _snap("base")
			_attach()
			_record_state("on")
		elif stage == 1:
			await _snap("on")
			# 零操作对照：同状态再截一帧，区分帧间抖动与真串扰。
		elif stage == 2:
			await _snap("on-repeat")
			arena.layer_3d_foe.set_foe_visual(false)
			_record_state("plain")
		elif stage == 3:
			await _snap("plain")
			arena.layer_3d_foe.set_foe_visual(true)
			_record_state("again")
		elif stage == 4:
			await _snap("again")
			var payload := {
				"shots": rows, "states": states,
				"player_layer_ready": player_ready,
				"foe_layer_ready": foe_ready,
				"player_visual_state": arena.layer_3d.visual_state()
						if arena.layer_3d != null else {},
				"env_visual_none": OS.get_environment(
						"CARD_BOXER_FOE_VISUAL"),
			}
			var f := FileAccess.open(out_dir + "/vis_result.json",
					FileAccess.WRITE)
			if f != null:
				f.store_string(JSON.stringify(payload, "\t"))
				f.close()
			print("IVIS_JSON " + JSON.stringify(payload))
			get_tree().quit(0)
			return
		stage += 1
		busy = false


func _init() -> void:
	var out_dir := OS.get_environment("I_VIS_DIR")
	if out_dir == "":
		print("IVIS_JSON " + JSON.stringify({"error": "I_VIS_DIR missing"}))
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	d.out_dir = out_dir
	root.add_child(d)
	print("IVIS_START out=%s" % out_dir)


