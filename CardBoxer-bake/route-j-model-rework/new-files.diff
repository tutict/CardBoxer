        "# 格式: 相对路径<TAB>字节<TAB>sha256",
        "# 排除: 本清单 / new-files.diff / logs / orig / shots / boards / data",
        "# shots / boards / data 的 sha256 见 new-files.diff 末尾对账段",
        "",
    ]
    rows = []
    for p in entries():
        rel = str(p.relative_to(HERE)).replace("\\", "/")
        rows.append(f"{rel}\t{p.stat().st_size}\t{sha256(p)}")
    LIST.write_bytes(("\n".join(header + rows) + "\n").encode("utf-8"))

    parts = []
    for p in scripts:
        parts.append(f"===== J/{p.name} =====\n"
                     + p.read_text(encoding="utf-8"))
    for p in tests:
        parts.append(f"===== J/tests/{p.name} =====\n"
                     + p.read_text(encoding="utf-8"))
    parts.append("===== J/J路线-造型规格.txt =====\n"
                 + (HERE / "J路线-造型规格.txt").read_text(
                     encoding="utf-8"))
    parts.append("===== J/J路线-负结果与方向订正.txt =====\n"
                 + (HERE / "J路线-负结果与方向订正.txt").read_text(
                     encoding="utf-8"))
    for rel in DATA_FILES:
        p = HERE / rel
        if p.is_file():
            parts.append(f"===== J/{rel} =====\n"
                         + p.read_text(encoding="utf-8"))

    # ── 工程状态对账：证明 r1 手术没有留在可运行工程里 ──────────
    install = json.loads((HERE / "data" / "install_j.json").read_text(
        encoding="utf-8"))
    rollback = json.loads((HERE / "data" / "rollback_j.json").read_text(
        encoding="utf-8"))
    glb = GAME / "assets" / "3d" / "foe-rigged.glb"
    layer = GAME / "scripts" / "fighter_3d_layer.gd"
    arena = GAME / "scripts" / "arena.gd"
    fighter = GAME / "scripts" / "fighter.gd"
    backup_glb = HERE / "orig" / "pre-shape" / "foe-rigged.glb"
    state = {
        "game_glb_sha256": sha256(glb),
        "i_baseline_glb_sha256": install["before"]["glb_sha256"],
        "r1_surgery_glb_sha256": install["after"]["glb_sha256"],
        "backup_glb_sha256": sha256(backup_glb),
        "game_glb_equals_i_baseline": (
            sha256(glb) == install["before"]["glb_sha256"]),
        "game_glb_differs_from_r1": (
            sha256(glb) != install["after"]["glb_sha256"]),
        "rollback_ok": rollback["ok"],
        "rollback_checks": rollback["checks"],
        "source_sha256": {
            "scripts/fighter_3d_layer.gd": sha256(layer),
            "scripts/arena.gd": sha256(arena),
            "scripts/fighter.gd": sha256(fighter),
        },
        "j_route_source_diff_count": 0,
    }
    parts.append("===== 工程状态 sha256 对账 =====\n"
                 + json.dumps(state, ensure_ascii=False, indent=2))
    # 其余静态产物（板子 / 截帧 / 大 GLB）只记大小与哈希，不塞进 diff。
    assets = []
    for d in ("boards", "shots", "data", "orig"):
        for p in sorted((HERE / d).rglob("*")):
            if p.is_file():
                assets.append({
                    "path": str(p.relative_to(HERE)).replace("\\", "/"),
                    "bytes": p.stat().st_size, "sha256": sha256(p)})
    parts.append("===== 其余产物 sha256（不含正文） =====\n"
                 + json.dumps(assets, ensure_ascii=False, indent=2))
    DIFF.write_bytes(("\n\n".join(parts) + "\n").encode("utf-8"))

    again = ("\n".join(header + [
        f"{str(p.relative_to(HERE)).replace(chr(92), '/')}\t"
        f"{p.stat().st_size}\t{sha256(p)}" for p in entries()
    ]) + "\n").encode("utf-8")
    stable = LIST.read_bytes() == again
    assert DIFF.is_file() and DIFF.stat().st_size > 10000, \
        f"new-files.diff missing or too small: {DIFF}"
    assert state["game_glb_equals_i_baseline"] and \
        state["game_glb_differs_from_r1"] and state["rollback_ok"], \
        "工程未回到 I 基线，禁止收口"
    print(f"FILELIST_ENTRIES={len(rows)} DIFF_BYTES={DIFF.stat().st_size} "
          f"SCRIPTS={len(scripts)} TESTS={len(tests)}")
    print(f"GAME_GLB_RESTORED={state['game_glb_equals_i_baseline']} "
          f"R1_NOT_PRESENT={state['game_glb_differs_from_r1']}")
    print(f"STABLE={stable}")
    print("FILELIST_J_STABLE_OK" if stable else "FILELIST_J_UNSTABLE")
    return 0 if stable else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== J/probe_recolor_j.py =====
"""J 路线 r2 探针：离线模拟 foe 层 canvas shader 的「语义重绘」效果。

不改游戏源码、不改资产。只对 v1 已截帧的 foe SubViewport RGBA 图做逐像素
变换，模拟把 shader 挂到 foe 层本地 material 后会得到什么，用来判断
「表现层语义重绘」这条链值不值得接线。

三档对照：
  C0 现状      = I 路线 tint vec3(0.42, 0.30, 0.28)
  C1 暗钢覆面  = C0 + 近白高光压成炭黑/铁锈红 + 青色压成低饱和暗青
  C2 工业警示  = C1 + 原近白区域叠加工业橙/黑斜向警示条纹

判据口径沿用 diag_motif_j.py：角色掩膜 = alpha > 127。
输出：boards/J-语义重绘探针.png、data/recolor_probe_j.json。
用法：python probe_recolor_j.py
"""
from __future__ import annotations

import json
import math
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
SRC = HERE / "shots" / "asset_v1" / "j-sv-foe.png"
PLAYER = HERE / "shots" / "asset_v1" / "j-sv-player.png"
BOARD = HERE / "boards" / "J-语义重绘探针.png"
OUT = HERE / "data" / "recolor_probe_j.json"
FONT = Path(r"C:\Windows\Fonts\msyh.ttc")

TINT = (0.42, 0.30, 0.28)          # 与 FOE_CANVAS_SHADER_CODE 一致
CHARCOAL = (34, 30, 30)
RUST = (104, 48, 34)
DARK_CYAN = (26, 62, 70)
WARN_ORANGE = (196, 122, 32)


def near_white(r, g, b):
    return r > 200 and g > 200 and b > 200


def cyan(r, g, b):
    return b > 120 and g > 120 and r < g - 20


def hot_red(r, g, b):
    return r > 140 and g < r * 0.62 and b < r * 0.62


def tint(rgb, mul):
    return tuple(int(min(255, v * m)) for v, m in zip(rgb, mul))


def recolor(mode: str, src: Image.Image) -> Image.Image:
    im = src.convert("RGBA")
    px = list(im.getdata())
    w, h = im.size
    out = []
    for i, (r, g, b, a) in enumerate(px):
        if a <= 127:
            out.append((r, g, b, a))
            continue
        base = tint((r, g, b), TINT)
        if mode == "C0":
            out.append((*base, a))
            continue
        x, y = i % w, i // w
        luma = (r * 0.2126 + g * 0.7152 + b * 0.0722) / 255.0
        is_highlight = near_white(r, g, b) or luma > 0.74
        if is_highlight:
            # 高光不再是「白衫」，改写成炭黑 + 铁锈红的斑驳金属。
            t = 0.5 + 0.5 * math.sin((x + y) * 0.11)
            c = tuple(int(CHARCOAL[k] * (1 - t) + RUST[k] * t)
                      for k in range(3))
            if mode == "C2" and ((x + y) // 14) % 2 == 0:
                c = WARN_ORANGE
            out.append((*c, a))
        elif cyan(r, g, b):
            # 青云纹不再发光，只留极少量低饱和暗青（以太结晶感）。
            out.append((*DARK_CYAN, a))
        elif hot_red(r, g, b):
            # 红色头花并入铁锈红，不再是高饱和花饰。
            out.append((*RUST, a))
        else:
            out.append((*base, a))
    res = Image.new("RGBA", (w, h))
    res.putdata(out)
    return res


def stats(im: Image.Image) -> dict:
    px = list(im.convert("RGBA").getdata())
    inner = [(r, g, b) for r, g, b, a in px if a > 127]
    n = len(inner)
    nw = sum(1 for c in inner if near_white(*c))
    cy = sum(1 for c in inner if cyan(*c))
    hr = sum(1 for c in inner if hot_red(*c))
    warn = sum(1 for r, g, b in inner
               if r > 150 and 80 < g < 170 and b < 90)
    mean = [round(sum(c[k] for c in inner) / n, 2) for k in range(3)]
    return {
        "mask_px": n, "near_white_ratio": round(nw / n, 6),
        "cyan_ratio": round(cy / n, 6), "hot_red_ratio": round(hr / n, 6),
        "warning_orange_ratio": round(warn / n, 6),
        "mean_rgb": mean,
    }


def main() -> int:
    src = Image.open(SRC)
    modes = ("C0", "C1", "C2")
    images = {m: recolor(m, src) for m in modes}
    st = {"source": stats(src)}
    st.update({m: stats(images[m]) for m in modes})
    st["player_reference"] = stats(Image.open(PLAYER))

    pad, cell_w, cell_h, label = 18, 300, 375, 56
    W = pad * 4 + 4 * cell_w
    H = pad * 2 + cell_h + label
    canvas = Image.new("RGB", (W, H), (20, 24, 34))
    d = ImageDraw.Draw(canvas)
    f = ImageFont.truetype(str(FONT), 15) if FONT.is_file() \
        else ImageFont.load_default()
    titles = {
        "source": ("v1 原图 (无 tint)", st["source"]),
        "C0": ("C0 现状 tint", st["C0"]),
        "C1": ("C1 暗钢覆面", st["C1"]),
        "C2": ("C2 工业警示", st["C2"]),
    }
    order = ("source", "C0", "C1", "C2")
    for i, key in enumerate(order):
        im = src if key == "source" else images[key]
        x = pad + i * (cell_w + pad)
        # 贴到浅底以看清透明区之外的角色轮廓
        tile = Image.new("RGB", (cell_w, cell_h), (232, 232, 236))
        shown = im.convert("RGBA").resize((cell_w, cell_h), Image.LANCZOS)
        tile.paste(shown, (0, 0), shown)
        canvas.paste(tile, (x, pad))
        title, s = titles[key]
        d.text((x + 2, pad + cell_h + 4), title, font=f,
               fill=(225, 230, 245))
        d.text((x + 2, pad + cell_h + 22),
               f"white {s['near_white_ratio']:.4f}  "
               f"cyan {s['cyan_ratio']:.4f}", font=f,
               fill=(170, 190, 215))
        d.text((x + 2, pad + cell_h + 38),
               f"orange {s['warning_orange_ratio']:.4f}  "
               f"mean {s['mean_rgb'][0]:.0f}/{s['mean_rgb'][1]:.0f}/"
               f"{s['mean_rgb'][2]:.0f}", font=f, fill=(170, 190, 215))
    BOARD.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(BOARD)

    # 订正（实测）：I 路线的 tint 已经把 foe 的近白 / 青特征清零，
    # 所以「再加一层语义重绘」没有可消除的目标；三档掩膜像素数完全相同，
    # 说明 canvas 层无论怎么调色都改不了剪影。这是本探针最重要的结论。
    checks = {
        "source_is_rgba_with_alpha": src.mode == "RGBA",
        "source_has_high_white": st["source"]["near_white_ratio"] > 0.10,
        "i_route_tint_already_removes_white": (
            st["C0"]["near_white_ratio"] <= 0.02),
        "i_route_tint_already_removes_cyan": (
            st["C0"]["cyan_ratio"] <= 0.005),
        "c1_removes_white": st["C1"]["near_white_ratio"] <= 0.02,
        "c2_removes_white": st["C2"]["near_white_ratio"] <= 0.02,
        "c1_removes_cyan": st["C1"]["cyan_ratio"] <= 0.005,
        "c2_adds_warning_color": (
            st["C2"]["warning_orange_ratio"]
            > st["C1"]["warning_orange_ratio"] + 0.01),
        "c1_darker_than_c0": (sum(st["C1"]["mean_rgb"])
                              < sum(st["C0"]["mean_rgb"])),
        "all_modes_keep_identical_silhouette": (
            len({st[k]["mask_px"] for k in
                 ("source", "C0", "C1", "C2")}) == 1),
        "player_reference_unchanged": (
            st["player_reference"]["mask_px"] > 0),
        "board_written": BOARD.is_file()
                         and BOARD.stat().st_size > 50000,
    }
    report = {
        "source": str(SRC), "tint": list(TINT),
        "stats": st, "board": str(BOARD),
        "board_bytes": BOARD.stat().st_size,
        "conclusion": (
            "I 路线 canvas tint 已把 foe 掩膜内近白/青特征清零；"
            "C1/C2 相对 C0 只改颜色，角色掩膜像素数逐档相同，"
            "证明 2D canvas 层无法改变剪影。C2 的橙黑警示条纹能把白衫"
            "下摆的色彩语义换成工业条幅，观感改善明显，但披风/头饰/"
            "站姿形状不变：表现层链是低成本观感改进，不是根治。"
            "要根治几何同源仍需精确删壳或重生成 3D。"),
        "checks": checks,
        "failed": [k for k, v in checks.items() if not v],
        "ok": all(checks.values()),
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    for k, v in st.items():
        print("STATS", k, v)
    for k, v in checks.items():
        print("CHECK", k, v)
    print("RECOLOR_PROBE_J_OK" if report["ok"]
          else "RECOLOR_PROBE_J_FAILED")
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== J/probe_shells_j.py =====
"""J 路线 P1：壳级剪影手术可行性探针（Blender 5.2.3 headless）。

只读 A 路线 .blend，按面连通把 2,809 个壳分组，算每壳空间位置，
判断能否按「区域规则」精确筛出 V4b 同源部件（头冠 / 披风 / 长衫下摆）。
并渲一张按区域上色的分类图，让规则可被看图证伪。

用法：
  blender.exe -b --python probe_shells_j.py
"""
from __future__ import annotations

import json
import sys
from collections import defaultdict
from pathlib import Path

sys.dont_write_bytecode = True
import bpy

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
BLEND = BAKE / "A路线-资产重做" / "对手怪-可变形连续壳.blend"
OUT = HERE / "data" / "shells_j.json"
BOARD = HERE / "boards" / "J-壳分类上色.png"


def classify(c, lo, hi) -> str:
    """c=(cx,cy,cz), lo/hi=bbox。Z-up，模型归一到 z∈[0,1.72]。"""
    cx, cy, cz = c
    zx, zy, zz = (hi[i] - lo[i] for i in range(3))
    if cz > 1.48:
        return "HEAD_TOP"          # 头冠 / 发髻 / 头盔顶
    if cz > 1.30:
        return "HEAD"
    # 背后大片垂布：用局部 y 极值 + 纵向跨度判定，泛化不依赖固定朝向
    if zz > 0.55 and (zy > 0.35 or zx > 0.55) and cz < 1.35:
        return "CAPE_OR_PANEL"    # 披风 / 长条布片
    if cz < 0.95 and zz > 0.25 and abs(cx) < 0.40:
        return "SKIRT"            # 长衫下摆 / 腰裙
    if cz < 0.42:
        return "BOOTS"
    return "BODY"


def main() -> int:
    assert BLEND.is_file(), BLEND
    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    obj = next(o for o in bpy.context.scene.objects
               if o.type == "MESH"
               and any(m.type == "SURFACE_DEFORM" for m in o.modifiers))
    mesh = obj.data
    nv, npoly = len(mesh.vertices), len(mesh.polygons)
    parent = list(range(nv))

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for p in mesh.polygons:
        vs = p.vertices
        v0 = vs[0]
        for v in vs[1:]:
            union(v0, v)

    verts = defaultdict(list)
    for v in mesh.vertices:
        verts[find(v.index)].append(v.index)

    co = [tuple(v.co) for v in mesh.vertices]
    rows = []
    for root, ids in verts.items():
        xs = [co[i][0] for i in ids]
        ys = [co[i][1] for i in ids]
        zs = [co[i][2] for i in ids]
        lo = [min(xs), min(ys), min(zs)]
        hi = [max(xs), max(ys), max(zs)]
        c = [sum(xs) / len(xs), sum(ys) / len(ys), sum(zs) / len(zs)]
        rows.append({"root": root, "verts": len(ids),
                     "lo": [round(v, 4) for v in lo],
                     "hi": [round(v, 4) for v in hi],
                     "centroid": [round(v, 4) for v in c],
                     "region": classify(c, lo, hi)})

    by_region = defaultdict(lambda: {"shells": 0, "verts": 0})
    for r in rows:
        b = by_region[r["region"]]
        b["shells"] += 1
        b["verts"] += r["verts"]
    top = sorted(rows, key=lambda r: -r["verts"])[:20]

    # 按区域上色：给每个 polygon 指定 material_index，Workbench MATERIAL 着色。
    palette = {
        "HEAD_TOP": (1.0, 0.15, 0.15, 1.0),
        "HEAD": (1.0, 0.55, 0.10, 1.0),
        "CAPE_OR_PANEL": (0.20, 0.45, 1.0, 1.0),
        "SKIRT": (0.15, 0.95, 0.35, 1.0),
        "BOOTS": (0.85, 0.35, 0.95, 1.0),
        "BODY": (0.75, 0.75, 0.75, 1.0),
    }
    names = list(palette)
    mesh.materials.clear()
    for n in names:
        m = bpy.data.materials.new("J_REGION_" + n)
        m.diffuse_color = palette[n]
        mesh.materials.append(m)
    region_of = {r["root"]: r["region"] for r in rows}
    for p in mesh.polygons:
        p.material_index = names.index(region_of[find(p.vertices[0])])

    scene = bpy.context.scene
    scene.render.engine = "BLENDER_WORKBENCH"
    scene.display.shading.light = "FLAT"
    scene.display.shading.color_type = "MATERIAL"
    scene.render.film_transparent = True
    scene.render.resolution_x = 768
    scene.render.resolution_y = 768
    cam_data = bpy.data.cameras.new("J_CAM")
    cam_data.type = "ORTHO"
    cam_data.ortho_scale = 2.1
    cam = bpy.data.objects.new("J_CAM", cam_data)
    scene.collection.objects.link(cam)
    cam.location = (0.0, -4.0, 0.95)
    cam.rotation_euler = (1.5707963, 0.0, 0.0)
    scene.camera = cam
    BOARD.parent.mkdir(parents=True, exist_ok=True)
    scene.render.filepath = str(BOARD)
    bpy.ops.render.render(write_still=True)

    payload = {
        "source_blend": str(BLEND),
        "object": obj.name, "verts": nv, "polygons": npoly,
        "shells": len(rows),
        "by_region": dict(by_region),
        "top20": top,
        "board": str(BOARD),
        "board_bytes": BOARD.stat().st_size if BOARD.is_file() else 0,
        "checks": {
            "opened": nv > 60000,
            "shell_count_matches_2809": len(rows) == 2809,
            "has_head_region": by_region["HEAD_TOP"]["verts"] > 0,
            "has_skirt_region": by_region["SKIRT"]["verts"] > 0,
            "has_cape_region": by_region["CAPE_OR_PANEL"]["verts"] > 0,
            "board_written": BOARD.is_file()
                             and BOARD.stat().st_size > 10000,
        },
    }
    payload["failed"] = [k for k, v in payload["checks"].items() if not v]
    payload["ok"] = not payload["failed"]
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("SHELLS", len(rows), "VERTS", nv)
    for k, v in by_region.items():
        print("REGION", k, v)
    for k, v in payload["checks"].items():
        print("CHECK", k, v)
    print("SHELLS_J_OK" if payload["ok"] else "SHELLS_J_FAILED")
    return 0 if payload["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== J/rollback_shape_j.py =====
"""J 路线 r1 负结果后：把工程 foe-rigged.glb 逐字节还原并重新导入。

回滚不是「删掉失败产物」——失败的 GLB / 截帧 / 报告全部留在 J 目录，
只把可运行工程恢复到 I 路线验收时的状态，并用 sha256 证明。

用法：python rollback_shape_j.py
"""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
DST = GAME / "assets" / "3d" / "foe-rigged.glb"
IMPORT = DST.with_suffix(".glb.import")
ORIG = HERE / "orig" / "pre-shape"
OUT = HERE / "data" / "rollback_j.json"
LOG = HERE / "logs" / "godot_reimport_rollback_j.log"
INSTALL = HERE / "data" / "install_j.json"


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def main() -> int:
    before_expected = json.loads(INSTALL.read_text(
        encoding="utf-8"))["before"]
    assert (ORIG / "foe-rigged.glb").is_file()
    shutil.copyfile(ORIG / "foe-rigged.glb", DST)
    now = {"glb_bytes": DST.stat().st_size,
           "glb_sha256": sha256(DST),
           "import_sha256": sha256(IMPORT)}
    env = os.environ.copy()
    env.pop("CARD_BOXER_3D", None)
    env.pop("CARD_BOXER_FOE_VISUAL", None)
    t0 = time.perf_counter()
    proc = subprocess.run(
        [str(GODOT), "--headless", "--path", str(GAME), "--import"],
        env=env, capture_output=True, timeout=300, cwd=str(GAME))
    text = (proc.stdout + b"\n--- STDERR ---\n"
            + proc.stderr).decode("utf-8", "replace")
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text(text, encoding="utf-8")
    errors = text.count("SCRIPT ERROR") + text.count("Parse Error")
    checks = {
        "glb_sha_matches_i_baseline": (
            now["glb_sha256"] == before_expected["glb_sha256"]),
        "glb_size_matches": (
            now["glb_bytes"] == before_expected["glb_bytes"]),
        "import_file_untouched": (
            now["import_sha256"] == before_expected["import_sha256"]),
        "backup_still_intact": (
            sha256(ORIG / "foe-rigged.glb")
            == before_expected["glb_sha256"]),
        "reimport_rc0": proc.returncode == 0,
        "no_script_errors": errors == 0,
    }
    ok = all(checks.values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps({
        "restored": str(DST), "from": str(ORIG / "foe-rigged.glb"),
        "expected": before_expected, "actual": now,
        "reimport": {"seconds": round(time.perf_counter() - t0, 3),
                     "returncode": proc.returncode,
                     "script_errors": errors},
        "checks": checks, "failed": [k for k, v in checks.items()
                                     if not v], "ok": ok,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("RESTORED", now["glb_bytes"], now["glb_sha256"][:16])
    for k, v in checks.items():
        print("CHECK", k, v)
    print("ROLLBACK_J_OK" if ok else "ROLLBACK_J_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


