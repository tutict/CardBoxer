===== J/build_foe_shape_j.py =====
"""J 路线 P2：壳级「去同源」手术 + 重导带 skin 的 foe GLB。

关键决策（比 A 候选里预估的全链重跑更省，且有实证支撑）：
  * 不增删顶点、不改拓扑、不改材质槽、不改 UV 层数、不改骨架 rest。
  * 权重先按 H 路线 DATA_TRANSFER 回传并 apply；**之后**才对 final 的
    顶点坐标与 UV 做手术。权重数组已固定，改坐标不会再影响
    POLYINTERP_NEAREST 的空间映射。
  * 因此 Voxel 连续壳 / 13 骨绑定 / SURFACE_DEFORM / motion_input_foe
    全都不用重跑，只需重导 GLB + 替换工程资产 + Godot 重新导入。

手术对象（来自 probe_shells_j.py 的区域规则，2,809 壳）：
  SKIRT          长衫下摆  → 缩短 + 收窄成工装围裙，UV 改到暗钢区
  CAPE_OR_PANEL  黑披风    → 收窄 + 缩短成破损背布，UV 改到暗钢区
  HEAD_TOP 小壳  头冠/结晶/红花 → 向头盔中心收拢，UV 改到暗钢区
大壳（头盔本体 / 躯干 / 靴子）一律不动，避免「没头」。

只读 A 路线 .blend；产物全落 J 目录，不回写任何归档、不动游戏工程。
用法：blender.exe -b --python build_foe_shape_j.py
"""
from __future__ import annotations

import hashlib
import json
import sys
from collections import defaultdict
from pathlib import Path

sys.dont_write_bytecode = True
import bpy

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
BLEND = BAKE / "A路线-资产重做" / "对手怪-可变形连续壳.blend"
OUT_GLB = HERE / "foe-rigged-v2.glb"
OUT_JSON = HERE / "data" / "build_shape_j.json"

UV_PATCH = (0.10, 0.88)     # foe 贴图左上均匀深灰区（v=1 为图像顶）
UV_SPAN = 0.018
SKIRT_Z, SKIRT_SQUEEZE, SKIRT_NARROW = 0.95, 0.45, 0.72
CAPE_Z, CAPE_SQUEEZE, CAPE_NARROW, CAPE_FLATTEN = 0.85, 0.50, 0.55, 0.60
HEAD_SMALL_SHELL_MAX = 200
HEAD_PULL_X, HEAD_DROP_Z = 0.45, 0.12


def log(*a):
    print(*a, flush=True)


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def textures(obj) -> list[dict]:
    out = []
    for slot in obj.material_slots:
        mat = slot.material
        if mat and mat.use_nodes:
            for n in mat.node_tree.nodes:
                if n.type == "TEX_IMAGE" and n.image:
                    out.append({"image": n.image.name,
                                "size": list(n.image.size)})
    return sorted(out, key=lambda d: d["image"])


def fresh_copy(src, name):
    obj = src.copy()
    obj.data = src.data.copy()
    bpy.context.scene.collection.objects.link(obj)
    obj.name = name
    for m in list(obj.modifiers):
        obj.modifiers.remove(m)
    obj.vertex_groups.clear()
    obj.parent = None
    obj.hide_render = True
    return obj


def classify(c, lo, hi) -> str:
    cx, cy, cz = c
    zx, zy, zz = (hi[i] - lo[i] for i in range(3))
    if cz > 1.48:
        return "HEAD_TOP"
    if cz > 1.30:
        return "HEAD"
    if zz > 0.55 and (zy > 0.35 or zx > 0.55) and cz < 1.35:
        return "CAPE_OR_PANEL"
    if cz < 0.95 and zz > 0.25 and abs(cx) < 0.40:
        return "SKIRT"
    if cz < 0.42:
        return "BOOTS"
    return "BODY"


def shell_map(mesh) -> dict[int, dict]:
    """按面连通分组；返回 root -> {verts, region, ...}。"""
    nv = len(mesh.vertices)
    parent = list(range(nv))

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for p in mesh.polygons:
        vs = p.vertices
        for v in vs[1:]:
            union(vs[0], v)
    groups = defaultdict(list)
    co = [tuple(v.co) for v in mesh.vertices]
    for v in mesh.vertices:
        groups[find(v.index)].append(v.index)
    out = {}
    for root, ids in groups.items():
        xs = [co[i][0] for i in ids]
        ys = [co[i][1] for i in ids]
        zs = [co[i][2] for i in ids]
        lo = [min(xs), min(ys), min(zs)]
        hi = [max(xs), max(ys), max(zs)]
        c = [sum(xs) / len(xs), sum(ys) / len(ys), sum(zs) / len(zs)]
        out[root] = {"ids": ids, "verts": len(ids),
                     "region": classify(c, lo, hi),
                     "centroid": c}
    return out, find


def patch_uv_sample(image) -> list[float]:
    """读回 UV patch 区域的线性均值，证明目标色块确实是暗钢区。"""
    w, h = image.size
    acc = [0.0, 0.0, 0.0]
    n = 0
    for i in range(8):
        for k in range(8):
            u = UV_PATCH[0] + UV_SPAN * (i + 0.5) / 8.0
            v = UV_PATCH[1] + UV_SPAN * (k + 0.5) / 8.0
            x = min(w - 1, int(u * w))
            y = min(h - 1, int((1.0 - v) * h))
            idx = (y * w + x) * 4
            for c in range(3):
                acc[c] += image.pixels[idx + c]
            n += 1
    return [round(a / n, 4) for a in acc]


def main() -> int:
    assert BLEND.is_file(), BLEND
    blend_sha = sha256(BLEND)
    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    scene = bpy.context.scene

    src = next(o for o in scene.objects
               if o.type == "MESH"
               and any(m.type == "SURFACE_DEFORM" for m in o.modifiers))
    shell = next(m for m in src.modifiers
                 if m.type == "SURFACE_DEFORM").target
    rig = next(o for o in scene.objects if o.type == "ARMATURE")
    bone_names = [b.name for b in rig.data.bones]
    shell_groups = [g.name for g in shell.vertex_groups]
    assert set(bone_names) == set(shell_groups)
    src_uv = len(src.data.uv_layers)
    src_tex = textures(src)

    # ── 1. 权重先回传并 apply（此时坐标仍是 H 原样）────────────
    final = fresh_copy(src, "foe_HI_skinned_V2")
    for name in bone_names:
        final.vertex_groups.new(name=name)
    mod = final.modifiers.new("weights_from_continuous_shell",
                              "DATA_TRANSFER")
    mod.object = shell
    mod.use_vert_data = True
    mod.data_types_verts = {"VGROUP_WEIGHTS"}
    mod.vert_mapping = "POLYINTERP_NEAREST"
    mod.layers_vgroup_select_src = "ALL"
    mod.layers_vgroup_select_dst = "NAME"
    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    bpy.context.view_layer.objects.active = final
    bpy.ops.object.modifier_apply(modifier=mod.name)
    covered_before = sum(1 for v in final.data.vertices
                         if any(g.weight > 1e-6 for g in v.groups))
    total = len(final.data.vertices)

    # ── 2. 顶点 / UV 手术（权重已固定，改坐标不再影响映射）──────
    groups, find = shell_map(final.data)
    targets: dict[str, list[int]] = defaultdict(list)
    for root, info in groups.items():
        reg = info["region"]
        if reg in ("SKIRT", "CAPE_OR_PANEL"):
            targets[reg].extend(info["ids"])
        elif (reg == "HEAD_TOP"
              and info["verts"] <= HEAD_SMALL_SHELL_MAX
              and info["centroid"][2] > 1.50):
            targets["HEAD_ORNAMENT"].extend(info["ids"])
    target_ids = set()
    for ids in targets.values():
        target_ids.update(ids)

    moved = 0
    for v in final.data.vertices:
        if v.index not in target_ids:
            continue
        root = find(v.index)
        reg = groups[root]["region"]
        x, y, z = v.co
        if reg == "SKIRT":
            v.co = (x * SKIRT_NARROW, y,
                    SKIRT_Z + (z - SKIRT_Z) * SKIRT_SQUEEZE)
        elif reg == "CAPE_OR_PANEL":
            v.co = (x * CAPE_NARROW, y * CAPE_FLATTEN,
                    CAPE_Z + (z - CAPE_Z) * CAPE_SQUEEZE)
        elif reg == "HEAD_TOP":
            v.co = (x * HEAD_PULL_X, y, z - HEAD_DROP_Z)
        moved += 1

    uv_layer = final.data.uv_layers.active
    assert uv_layer is not None, "no UV layer"
    uv_fixed = 0
    for p in final.data.polygons:
        if p.vertices[0] not in target_ids:
            continue
        for li in p.loop_indices:
            uv_layer.data[li].uv = (
                UV_PATCH[0] + UV_SPAN * 0.5,
                UV_PATCH[1] + UV_SPAN * 0.5)
            uv_fixed += 1

    # ── 3. 校验：结构一件没变 ──────────────────────────────────
    covered_after = sum(1 for v in final.data.vertices
                        if any(g.weight > 1e-6 for g in v.groups))
    arm_mod = final.modifiers.new("foe_rig", "ARMATURE")
    arm_mod.object = rig
    assets = {"uv_layers": len(final.data.uv_layers),
              "materials": len(final.data.materials),
              "textures": textures(final),
              "uv_same": len(final.data.uv_layers) == src_uv,
              "textures_same": textures(final) == src_tex}
    assert assets["uv_same"] and assets["textures_same"]
    # A 路线记录的就是 64,006/64,024 = 99.9719%（18 个顶点在代理壳
    # 外拿不到权重），不是 100%。关键 invariants 是「手术前后覆盖数
    # 逐字节相同」与「覆盖 > 99%」，不是覆盖到每一个顶点。
    assert covered_before == covered_after, \
        (covered_before, covered_after)
    assert covered_before > 0.99 * total, (covered_before, total)
    assert len(final.data.vertices) == len(src.data.vertices) == total
    assert len(final.data.polygons) == len(src.data.polygons)

    base_img = next(n.image for n in
                    final.material_slots[0].material.node_tree.nodes
                    if n.type == "TEX_IMAGE" and n.image
                    and "normal" not in n.image.name.lower()
                    and "roughness" not in n.image.name.lower())
    patch_rgb = patch_uv_sample(base_img)
    assert max(patch_rgb) < 0.35, patch_rgb

    # ── 4. 导出 ────────────────────────────────────────────────
    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    rig.select_set(True)
    bpy.context.view_layer.objects.active = final
    result = bpy.ops.export_scene.gltf(
        filepath=str(OUT_GLB), export_format="GLB",
        use_selection=True, export_apply=False,
        export_skins=True, export_animations=False,
        export_materials="EXPORT", export_yup=True,
        export_cameras=False, export_lights=False)
    assert list(result) == ["FINISHED"]
    assert OUT_GLB.is_file() and OUT_GLB.stat().st_size > 1_000_000

    report = {
        "blender": bpy.app.version_string,
        "source_blend": str(BLEND), "source_blend_sha256": blend_sha,
        "source": {"object": src.name, "verts": len(src.data.vertices),
                   "polygons": len(src.data.polygons),
                   "uv_layers": src_uv, "textures": src_tex},
        "rig": {"bones": bone_names},
        "shells": len(groups),
        "surgery": {
            "params": {
                "SKIRT": [SKIRT_Z, SKIRT_SQUEEZE, SKIRT_NARROW],
                "CAPE": [CAPE_Z, CAPE_SQUEEZE, CAPE_NARROW,
                         CAPE_FLATTEN],
                "HEAD": [HEAD_SMALL_SHELL_MAX, HEAD_PULL_X,
                         HEAD_DROP_Z],
                "uv_patch": list(UV_PATCH), "uv_span": UV_SPAN},
            "target_verts": {k: len(v) for k, v in targets.items()},
            "moved_verts": moved, "uv_loops_rewritten": uv_fixed,
            "uv_patch_linear_rgb": patch_rgb},
        "integrity": {
            "verts_before": total, "verts_after": len(final.data.vertices),
            "polygons_before": len(src.data.polygons),
            "polygons_after": len(final.data.polygons),
            "uv_layers": assets["uv_layers"],
            "materials": assets["materials"],
            "textures_same": assets["textures_same"],
            "weighted_before": covered_before,
            "weighted_after": covered_after},
        "export": {"file": OUT_GLB.name,
                   "bytes": OUT_GLB.stat().st_size,
                   "sha256": sha256(OUT_GLB),
                   "export_apply": False, "export_skins": True},
    }
    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
    OUT_JSON.write_text(json.dumps(report, ensure_ascii=False, indent=2)
                        + "\n", encoding="utf-8")
    log("SURGERY", report["surgery"]["target_verts"],
        "moved", moved, "uv_loops", uv_fixed)
    log("INTEGRITY", report["integrity"])
    log("EXPORT", OUT_GLB.stat().st_size, "B", sha256(OUT_GLB)[:16])
    log("FOE_SHAPE_J_OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== J/diag_motif_j.py =====
"""J 路线 r2：定位「同源观感」在贴图还是在几何，并量化 J-01~J-04 基线。

背景（r1 负结果后必须重新问的问题）：
  * r1 用壳级顶点压缩做「去同源」手术，把黑披风撕成尖刺碎片，
    白衫下摆 / 青云纹 / 青结晶头冠 / 红花一个都没消掉。已回滚。
  * diag_texture_pair_j.py 已经预警过：foe baseColor 整体是暗灰重装，
    512 缩略近白占比 0.0%，player 才是大面积白衫青云纹。
    若渲染里 foe 侧仍有纯白长条 + 亮青云纹，则同源不是「造型整体同源」。

本脚本只读，回答三件事：
  A. 4096² 贴图上，近白 / 青 / 高饱和暖红特征像素有多少、聚在哪几个 UV 区。
  B. v1 引擎内 SubViewport 角色掩膜里，这些特征占多少（J-02/J-03 基线）。
  C. 两侧正视剪影 IoU 与肩宽/身高比（J-01 基线），确定剪影本来是否已可分。

输出：data/motif_baseline_j.json、boards/J-同源元素定位.png。
用法：python diag_motif_j.py
"""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
V1 = HERE / "shots" / "asset_v1"
BOARD = HERE / "boards" / "J-同源元素定位.png"
OUT = HERE / "data" / "motif_baseline_j.json"
FONT = Path(r"C:\Windows\Fonts\msyh.ttc")

TEX = {
    "player": "player-rigged_texture_pbr_20250901.png",
    "foe": "foe-rigged_texture_pbr_20250901.png",
}
SV = {"player": "j-sv-player.png", "foe": "j-sv-foe.png"}
GRID = 4
TILE = 1024


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def is_near_white(r, g, b):
    return r > 200 and g > 200 and b > 200


def is_cyan(r, g, b):
    return b > 120 and g > 120 and r < g - 20


def is_hot_red(r, g, b):
    return r > 140 and g < r * 0.62 and b < r * 0.62


def texture_features(path: Path) -> dict:
    im = Image.open(path).convert("RGB")
    small = im.resize((TILE, TILE), Image.LANCZOS)
    px = list(small.getdata())
    n = len(px)
    counts = {"near_white": 0, "cyan": 0, "hot_red": 0}
    grid = [[0] * GRID for _ in range(GRID)]
    cell_px = TILE // GRID
    for i, (r, g, b) in enumerate(px):
        hit = (is_near_white(r, g, b) or is_cyan(r, g, b)
               or is_hot_red(r, g, b))
        if is_near_white(r, g, b):
            counts["near_white"] += 1
        if is_cyan(r, g, b):
            counts["cyan"] += 1
        if is_hot_red(r, g, b):
            counts["hot_red"] += 1
        if hit:
            grid[(i // TILE) // cell_px][(i % TILE) // cell_px] += 1
    return {
        "file": path.name, "orig_size": list(im.size),
        "sha256": sha256(path), "analyzed_size": [TILE, TILE],
        "counts": counts,
        "ratios": {k: round(v / n, 6) for k, v in counts.items()},
        "motif_grid": grid,
        "grid_max": max(max(row) for row in grid),
    }


def character_mask(im: Image.Image) -> list[bool]:
    """从 SubViewport PNG 提取角色掩膜：优先 alpha，否则按非近白背景。"""
    w, h = im.size
    if im.mode == "RGBA":
        a = list(im.getchannel("A").getdata())
        alpha_min, alpha_max = min(a), max(a)
        if alpha_max - alpha_min > 32:
            return [v > 127 for v in a], "alpha>127", [alpha_min, alpha_max]
    rgb = list(im.convert("RGB").getdata())
    # 背景是纯白（或近白）；角色像素取「明显偏离白」的。
    out = [not (r > 246 and g > 246 and b > 246) for r, g, b in rgb]
    return out, "not_near_white_bg", None


def silhouette_stats(im: Image.Image) -> dict:
    w, h = im.size
    mask, mask_kind, alpha_range = character_mask(im)
    rows = [mask[y * w:(y + 1) * w] for y in range(h)]
    ys = [y for y, row in enumerate(rows) if any(row)]
    xs = [x for row in rows for x, v in enumerate(row) if v]
    if not ys or not xs:
        return {"mask_kind": mask_kind, "error": "empty mask"}
    x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)
    height = y1 - y0 + 1
    # 肩宽：顶部 15%~32% 区间内的最大行宽（避开头部与手臂下垂）。
    band = [sum(row) for row in rows[y0 + int(height * 0.15):
                                     y0 + int(height * 0.32)]]
    shoulder = max(band) if band else 0
    rgb = list(im.convert("RGB").getdata())
    inner = [rgb[i] for i, m in enumerate(mask) if m]
    nw = sum(1 for r, g, b in inner if is_near_white(r, g, b))
    cy = sum(1 for r, g, b in inner if is_cyan(r, g, b))
    hr = sum(1 for r, g, b in inner if is_hot_red(r, g, b))
    return {
        "size": [w, h], "mask_kind": mask_kind,
        "alpha_range": alpha_range, "mask_px": len(inner),
        "bbox": [x0, y0, x1 + 1, y1 + 1], "height_px": height,
        "shoulder_px": shoulder,
        "shoulder_over_height": round(shoulder / height, 5),
        "near_white_ratio": round(nw / len(inner), 6),
        "cyan_ratio": round(cy / len(inner), 6),
        "hot_red_ratio": round(hr / len(inner), 6),
        "near_white_px": nw, "cyan_px": cy, "hot_red_px": hr,
    }


def iou_from_bbox(a: dict, b: dict) -> float:
    """按各自 bbox 归一化到 256 高后的外接框 IoU（上界，不是像素 IoU）。"""
    aw = a["bbox"][2] - a["bbox"][0]
    ah = a["bbox"][3] - a["bbox"][1]
    bw = b["bbox"][2] - b["bbox"][0]
    bh = b["bbox"][3] - b["bbox"][1]
    s = 256 / max(ah, bh)
    ia = aw * s * 256
    ib = bw * s * 256
    inter = min(aw, bw) * s * 256
    return round(inter / (ia + ib - inter), 5)


def main() -> int:
    tex = {k: texture_features(GAME / "assets" / "3d" / name)
           for k, name in TEX.items()}
    sv = {k: silhouette_stats(Image.open(V1 / name))
          for k, name in SV.items()}
    iou = iou_from_bbox(sv["player"], sv["foe"])
    shoulder_delta = abs(sv["player"]["shoulder_over_height"]
                         - sv["foe"]["shoulder_over_height"])
    silhouette_separable = (iou <= 0.60 or shoulder_delta >= 0.15)

    # 板：贴图上把 motif 网格画出来 + 两侧 SV 缩略并排。
    pad, cell, label = 20, 256, 44
    W = pad * 3 + 2 * cell
    H = pad * 3 + cell + 2 * label + 260
    canvas = Image.new("RGB", (W, H), (24, 28, 38))
    d = ImageDraw.Draw(canvas)
    f = ImageFont.truetype(str(FONT), 16) if FONT.is_file() \
        else ImageFont.load_default()
    for i, k in enumerate(("player", "foe")):
        x = pad + i * (cell + pad)
        im = Image.open(GAME / "assets" / "3d" / TEX[k]).convert("RGB")
        canvas.paste(im.resize((cell, cell), Image.LANCZOS), (x, pad))
        g = tex[k]["motif_grid"]
        gmax = max(1, tex[k]["grid_max"])
        for gy in range(GRID):
            for gx in range(GRID):
                v = g[gy][gx] / gmax
                d.rectangle(
                    [x + gx * cell / GRID, pad + gy * cell / GRID,
                     x + (gx + 1) * cell / GRID - 2,
                     pad + (gy + 1) * cell / GRID - 2],
                    outline=(int(60 + 195 * v), int(210 - 130 * v), 90),
                    width=2)
        d.text((x + 4, pad + cell + 6),
               f"{k} · near_white={tex[k]['ratios']['near_white']} "
               f"cyan={tex[k]['ratios']['cyan']}", font=f,
               fill=(200, 210, 230))
        sv_im = Image.open(V1 / SV[k]).convert("RGB")
        sy = pad + cell + label + 8
        canvas.paste(sv_im.resize((130, 160), Image.LANCZOS), (x, sy))
