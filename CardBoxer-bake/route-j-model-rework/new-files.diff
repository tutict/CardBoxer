"""J 路线 P0c：跑引擎内资产读回探针，把两侧 SubViewport 内容落盘。

用法：python run_asset_probe_j.py
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
GAME = Path(r"C:\Users\tutic\Desktop\学习资料\牌拳-CardBoxer")
GODOT = Path(r"C:\Users\tutic\Documents\godot\Godot_v4.5-stable_win64_console.exe")
OUTDIR = HERE / "shots" / "asset_probe"
SRC = HERE / "tests" / "asset_probe_j.gd"
DST = GAME / "tests" / "asset_probe_j.gd"
OUT = HERE / "data" / "asset_probe_j.json"
LOG = HERE / "logs" / "godot_asset_probe_j.log"


def main() -> int:
    assert GODOT.is_file() and SRC.is_file()
    OUTDIR.mkdir(parents=True, exist_ok=True)
    DST.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SRC, DST)
    env = os.environ.copy()
    env.pop("CARD_BOXER_3D", None)
    env.pop("CARD_BOXER_FOE_VISUAL", None)
    env["J_ASSET_DIR"] = str(OUTDIR)
    t0 = time.perf_counter()
    try:
        proc = subprocess.run(
            [str(GODOT), "--path", str(GAME), "--resolution", "1280x720",
             "--quit-after", "900", "--script",
             "res://tests/asset_probe_j.gd"],
            env=env, capture_output=True, timeout=300, cwd=str(GAME))
        rc = proc.returncode
        text = (proc.stdout + b"\n--- STDERR ---\n"
                + proc.stderr).decode("utf-8", "replace")
    except subprocess.TimeoutExpired as exc:
        rc = -1
        text = ((exc.stdout or b"") + b"\n--- TIMEOUT ---\n").decode(
            "utf-8", "replace")
    dt = round(time.perf_counter() - t0, 3)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text(text, encoding="utf-8")
    marker = "JASSET_JSON "
    line = next((l for l in text.splitlines()
                 if l.startswith(marker)), None)
    payload = json.loads(line[len(marker):]) if line else {"error": "no marker"}
    errors = text.count("SCRIPT ERROR") + text.count("Parse Error")
    foe = payload.get("foe", {})
    player = payload.get("player", {})
    fmesh = foe.get("meshes", [{}])
    pmesh = player.get("meshes", [{}])
    checks = {
        "rc": rc == 0,
        "has_opengl": "OpenGL API" in text,
        "no_script_errors": errors == 0,
        "no_payload_error": "error" not in payload,
        "three_shots": len(payload.get("shots", [])) == 3,
        "all_png_ok": all(r.get("save_error") == 0
                          and Path(r.get("path", "")).is_file()
                          for r in payload.get("shots", [])),
        "both_sv_png_written": all(
            (OUTDIR / f"j-sv-{role}.png").is_file()
            for role in ("foe", "player")),
        "sv_rids_differ": (
            foe.get("tex_instance_id") != player.get("tex_instance_id")
            and foe.get("sv_instance_id") != player.get("sv_instance_id")),
        "glb_paths_differ": foe.get("glb_path") != player.get("glb_path"),
        "foe_mesh_verts": fmesh[0].get("verts") if fmesh else 0,
        "player_mesh_verts": pmesh[0].get("verts") if pmesh else 0,
        "albedo_paths_differ": (
            fmesh[0].get("albedo") != pmesh[0].get("albedo")
            if fmesh and pmesh else False),
    }
    # 数值型字段只作事实记录，不参与布尔判据。
    bool_checks = {k: v for k, v in checks.items() if isinstance(v, bool)}
    ok = all(bool_checks.values())
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps({
        "run": {"seconds": dt, "returncode": rc, "script_errors": errors},
        "payload": payload, "checks": checks,
        "bool_failed": [k for k, v in bool_checks.items() if not v],
        "ok": ok,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"RUN {dt}s rc={rc} errors={errors}")
    for role in ("foe", "player"):
        d = payload.get(role, {})
        print("LAYER", role, "glb", d.get("glb_path"),
              "sv_rid", d.get("sv_rid"), "tex_rid", d.get("tex_rid"),
              "meshes", d.get("meshes"))
    for k, v in checks.items():
        print("CHECK", k, v)
    print("ASSET_PROBE_J_OK" if ok else "ASSET_PROBE_J_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== J/tests/asset_probe_j.gd =====
extends SceneTree
## J 路线 P0c：引擎内读回两侧 3D 层的真实资产，定位「同源」是资产还是渲染。
##
## 同进程三帧：
##   base      = 无 3D 层
##   foe-only  = 只挂 foe 层
##   both      = 再挂 player 层
## 每帧额外把各层 SubViewport 的 ViewportTexture 单独存成 PNG，
## 这样「2D 合成后看到什么」与「SubViewport 里到底渲了什么」能分开判。
##
## 跑法（必须带窗口）：
##   J_ASSET_DIR=<abs> godot --path . --resolution 1280x720 \
##     --quit-after 900 --script res://tests/asset_probe_j.gd

const ArenaScene = preload("res://scenes/main.tscn")


class Driver:
	extends Node

	const LayerScript = preload("res://scripts/fighter_3d_layer.gd")
	const MOTION_P := "res://data/motion_input.json"
	const MOTION_F := "res://data/motion_input_foe.json"
	const WARM := 20

	var arena: Node2D
	var out_dir := ""
	var motion_p: Dictionary = {}
	var motion_f: Dictionary = {}
	var initialized := false
	var busy := false
	var stage := 0
	var wait := 0
	var rows: Array = []

	func _snap(name: String) -> void:
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		var path := out_dir + "/j-" + name + ".png"
		var err := img.save_png(path)
		rows.append({"name": name, "path": path,
			"w": img.get_width(), "h": img.get_height(),
			"save_error": int(err)})

	func _mesh_info(layer) -> Dictionary:
		var out := {"glb_path": String(layer.glb_path),
			"role": String(layer.role_id),
			"sv_instance_id": 0, "tex_instance_id": 0,
			"sv_size": [0, 0], "meshes": []}
		if layer.sv == null:
			return out
		# Godot 4.5 的 SubViewport / ViewportTexture 都不是 CanvasItem，
		# 没有 get_rid()；用 Object.get_instance_id() 判「是否同一个对象」。
		out["sv_instance_id"] = int(layer.sv.get_instance_id())
		out["sv_size"] = [layer.sv.size.x, layer.sv.size.y]
		# layer 是无类型参数，:= 推不出 get_texture() 的返回类型；
		# 用无类型 var，后面判空即可（GDScript Parse Error 实测踩到）。
		var t = layer.sv.get_texture()
		if t != null:
			out["tex_instance_id"] = int(t.get_instance_id())
			var im = t.get_image()
			if im != null:
				var p := out_dir + "/j-sv-" + String(layer.role_id) + ".png"
				out["sv_png"] = p
				out["sv_png_error"] = int(im.save_png(p))
		_collect(layer.sv, out["meshes"], String(layer.role_id))
		return out

	func _collect(n: Node, rows: Array, role: String) -> void:
		if n is MeshInstance3D:
			var mi := n as MeshInstance3D
			var row := {"name": mi.name, "surfaces": 0,
				"verts": 0, "albedo": "", "material": ""}
			if mi.mesh != null:
				row["surfaces"] = mi.mesh.get_surface_count()
				var arr = mi.mesh.surface_get_arrays(0)
				if arr.size() > Mesh.ARRAY_VERTEX and arr[Mesh.ARRAY_VERTEX] != null:
					row["verts"] = arr[Mesh.ARRAY_VERTEX].size()
				var m = mi.mesh.surface_get_material(0)
				if m != null:
					row["material"] = m.get_class()
					if m is StandardMaterial3D:
						var sm := m as StandardMaterial3D
						if sm.albedo_texture != null:
							row["albedo"] = sm.albedo_texture.resource_path
							# 直接读回引擎里这张贴图的像素，排除「磁盘 PNG 是暗的、
							# 但 .godot 导入缓存串成玩家亮图」这一假设。
							var ai = sm.albedo_texture.get_image()
							if ai != null:
								var p := out_dir + "/j-albedo-" + role + ".png"
								row["albedo_png"] = p
								row["albedo_png_error"] = int(ai.save_png(p))
								var acc := Vector3.ZERO
								var steps := 16
								for gy in range(steps):
									for gx in range(steps):
										var px := ai.get_pixel(
											int(float(gx) * ai.get_width() / steps),
											int(float(gy) * ai.get_height() / steps))
										acc += Vector3(px.r, px.g, px.b)
								acc /= float(steps * steps)
								row["albedo_sample_mean"] = [acc.x, acc.y, acc.z]
						row["albedo_color"] = [
							sm.albedo_color.r, sm.albedo_color.g,
							sm.albedo_color.b]
			rows.append(row)
		for c in n.get_children():
			_collect(c, rows, role)

	func _attach_foe() -> void:
		var lf := LayerScript.new()
		lf.configure("foe", LayerScript.FOE_GLB_PATH,
				LayerScript.DEFAULT_FOE_YAW, false)
		arena.world.add_child(lf)
		if lf.setup(motion_f):
			arena.layer_3d_foe = lf
			arena.motion_3d_foe = motion_f
			lf.position = arena.enemy.position + arena.enemy.visual_shift
			arena.enemy.draw_3d_override = true

	func _attach_player() -> void:
		var lp := LayerScript.new()
		arena.world.add_child(lp)
		if lp.setup(motion_p):
			arena.layer_3d = lp
			arena.motion_3d = motion_p
			lp.position = arena.player.position + arena.player.visual_shift
			arena.player.draw_3d_override = true

	func _process(_d: float) -> void:
		if busy:
			return
		busy = true
		if not initialized:
			initialized = true
			arena.paused = true
			for c in arena.get_children():
				if c.name != "World":
					c.visible = false
			var pp: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_P))
			if pp is Dictionary:
				motion_p = pp
			var ff: Variant = JSON.parse_string(
					FileAccess.get_file_as_string(MOTION_F))
			if ff is Dictionary:
				motion_f = ff
		wait += 1
		if wait < WARM:
			busy = false
			return
		wait = 0
		if stage == 0:
			await _snap("base")
			_attach_foe()
		elif stage == 1:
			await _snap("foe-only")
			_attach_player()
		elif stage == 2:
			await _snap("both")
			var payload := {
				"shots": rows,
				"foe": _mesh_info(arena.layer_3d_foe)
						if arena.layer_3d_foe != null else {},
				"player": _mesh_info(arena.layer_3d)
						if arena.layer_3d != null else {},
			}
			var f := FileAccess.open(out_dir + "/j_asset_result.json",
					FileAccess.WRITE)
			if f != null:
				f.store_string(JSON.stringify(payload, "\t"))
				f.close()
			print("JASSET_JSON " + JSON.stringify(payload))
			get_tree().quit(0)
			return
		stage += 1
		busy = false


func _init() -> void:
	var out_dir := OS.get_environment("J_ASSET_DIR")
	if out_dir == "":
		print("JASSET_JSON " + JSON.stringify({"error": "J_ASSET_DIR missing"}))
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	var inst: Node2D = (ArenaScene as PackedScene).instantiate()
	root.add_child(inst)
	var d := Driver.new()
	d.arena = inst
	d.out_dir = out_dir
	root.add_child(d)
	print("JASSET_START out=%s" % out_dir)


===== J/J路线-造型规格.txt =====
《牌拳》J 路线 · 对手怪造型重做规格（根治同源观感）
日期：2026-11-12
依据：11-07 对手怪造型规格.txt / 2D 概念图 / 11-08 图生 3D 负结果 /
      I 路线 data/shape_root_j.json 与引擎内资产读回

====================================================================
0. 诊断先行：同源到底同源在哪（本轮实证，不靠肉眼下结论）
====================================================================

| 证据 | 数值 / 事实 | 排除什么 |
|---|---|---|
| GLB 结构 | game_foe 64,059 顶点 / skin 1 / bbox 1.216869×1.72×0.720506；game_player 57,934 / bbox 1.254475×1.72×0.769385 | 不是同一份几何被复用 |
| 贴图 | foe baseColor 均值 [33.17,32.22,31.39]、近白占比 **0.0**、青色 0.119%；player 均值 [109.86,103.47,95.37]、近白 14.815%、青色 1.741% | 贴图不是同一张 |
| 引擎内读回 | foe 层 `foe_HI_skinned` 64,059 顶点、albedo=`foe-rigged_texture_pbr_20250901.png`；player 层 `player_HI_skinned` 57,934、albedo 玩家图；两层 ViewportTexture / SubViewport 对象 ID 都不同 | 不是视口串味、不是资源引用错 |
| 11-11 只挂 foe 层隔离帧 | 右侧是深灰覆面重装怪（与 11-08 概念图一致） | 3D 链路本身画得出怪人 |
| 11-12 SubViewport 原图 | 重装怪身上**仍带**白/浅色长衫下摆、青色云纹、黑披风、青结晶头冠与红色头花 | **造型层真同源**：11-08 image-to-3D 把 V4b 的服装元素一起生成进去了 |

结论：I 路线的 `canvas_item` tint 只把颜色拉成「亮银 vs 暗棕」，
没有动剪影。要根治必须换掉造型部件，重做几何或至少重绘 UV 图案。
这不是渲染 bug，改灯/材质/Shader 都解决不了。

====================================================================
1. 必须消除的 V4b 同源元素（逐项可复算）
====================================================================

1. 白色 / 浅色长衫下摆（两条长条布 + 青色云纹）
2. 青色云纹 / 浪花图案
3. 黑色长披风（及明黄披肩）
4. 双环发髻、青结晶头冠、红色头花、长发飘带
5. 太极圆牌 / 金绳结 / 红流苏
6. 纤细四肢与「二游少女」头身比

====================================================================
2. 必须出现的盗洞暴徒语言（11-07 规格继承，不撤销）
====================================================================

| 部位 | 要求 |
|---|---|
| 头 | 覆面 / 工业全面罩 / 焊接头盔，无露肤、无表情眼、无发饰 |
| 躯干 | 宽肩厚躯、改装施工辅助动力外骨骼、非制式拼装板甲 |
| 肩 | 单侧青色以太结晶（小面积，唯一高饱和冷色）、铆钉 / 管线 / 补丁 |
| 腰腿 | 破损工装围裙或警示条幅（**不是**长衫下摆）、厚底重工靴 |
| 配色 | 炭黑 / 铁锈红 / 工业橙黄警示条纹为主，青色只作点缀 |
| 禁令 | 不画武器、不做性化二创、不复刻具体 IP 角色 |

====================================================================
3. 可复算验收判据（最终引擎内截帧，不写死阈值来源）
====================================================================

| 编号 | 判据 | 口径 |
|---|---|---|
| J-01 | 敌我剪影可分 | 同相机同尺度正视剪影 IoU ≤ 0.60，或肩宽/身高差 ≥ 0.15 |
| J-02 | 白衫下摆消失 | 对手角色掩膜内近白像素（RGB 均 > 200）占比 ≤ 2% |
| J-03 | 青云纹消失 | 对手角色掩膜内青色特征像素占比 ≤ 0.5% |
| J-04 | 覆面成立 | 头部 ROI 内不存在红花/双环/长发高饱和暖色团 |
| J-05 | 玩家侧零变化 | 同进程 A/B 玩家 ROI changed_px = 0 |
| J-06 | 可逆 / 零污染 | `CARD_BOXER_FOE_VISUAL=none` 与 H 原样逐像素一致；不设 `CARD_BOXER_3D` 时 `CHANGED_PIXELS=0` |
| J-07 | 驱动链不断 | 13 骨 + skin、72/73 帧可驱动、`motion_input_foe.json` 按新 rest 重建 |
| J-08 | 全量回归 | 15 套引擎内自检全绿 |

