只读，不写游戏工程、不改任何归档。用法：python diag_shape_root.py
"""
from __future__ import annotations

import hashlib
import json
import struct
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
