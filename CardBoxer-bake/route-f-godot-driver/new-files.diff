===== build_rigged_glb.py =====
"""阶段 2：给玩家高模补 skin，导出 Godot 能驱动的 GLB。

E 路线的 player-full.glb 里 57,934 顶点高模没有 JOINTS_0/WEIGHTS_0，
只有 14,070 顶点的 Voxel 代理壳挂了 13 骨 skin；Godot 里转骨架只会动
那层溶蚀灰壳。这里把代理壳的 ARMATURE_AUTO 平滑权重用 Data Transfer
回传原高模，再加 ARMATURE modifier，导出只含「高模 + 13 骨」的 GLB。

复用拓扑修复探针V1 已验证的链（对手怪上覆盖 99.97%），不重新 Voxel：
E 路线交付的 .blend 里代理壳已经是 3 壳 + 14,062/14,070 权重。

只读 E 路线 .blend，不回写任何归档，不改游戏源码。
用法：blender.exe -b --python build_rigged_glb.py
"""
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
import bpy

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
E = BAKE / "E路线-玩家3D绑骨"
BLEND = E / "玩家V4b-可变形连续壳.blend"
OUT_GLB = HERE / "player-rigged.glb"
OUT_JSON = HERE / "data" / "rigged_build.json"


def log(*a):
    print(*a, flush=True)


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def texture_inventory(obj) -> list[dict]:
    out = []
    for slot in obj.material_slots:
        mat = slot.material
        if mat and mat.use_nodes:
            for n in mat.node_tree.nodes:
                if n.type == "TEX_IMAGE" and n.image:
                    out.append({"image": n.image.name,
                                "size": list(n.image.size)})
    return out


def fresh_copy(src, name):
    obj = src.copy()
    obj.data = src.data.copy()
    bpy.context.scene.collection.objects.link(obj)
    obj.name = name
    for m in list(obj.modifiers):
        obj.modifiers.remove(m)
    obj.vertex_groups.clear()
    obj.parent = None
    obj.hide_render = True
    return obj


def main() -> int:
    assert BLEND.is_file(), BLEND
    blend_sha = sha256(BLEND)
    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    scene = bpy.context.scene

    src = next(o for o in scene.objects
               if o.type == "MESH"
               and any(m.type == "SURFACE_DEFORM" for m in o.modifiers))
    shell = next(m for m in src.modifiers
                 if m.type == "SURFACE_DEFORM").target
    rig = next(o for o in scene.objects if o.type == "ARMATURE")

    src_uv = len(src.data.uv_layers)
    src_tex = texture_inventory(src)
    bone_names = [b.name for b in rig.data.bones]
    shell_groups = [g.name for g in shell.vertex_groups]
    log("OPEN", src.name, len(src.data.vertices), "verts /",
        shell.name, len(shell.data.vertices), "verts /",
        rig.name, len(bone_names), "bones")
    log("SHELL_GROUPS", shell_groups)
    assert set(bone_names) == set(shell_groups), (
        bone_names, shell_groups)

    final = fresh_copy(src, "player_HI_skinned")
    for name in bone_names:
        final.vertex_groups.new(name=name)

    mod = final.modifiers.new("weights_from_continuous_shell",
                              "DATA_TRANSFER")
    mod.object = shell
    mod.use_vert_data = True
    mod.data_types_verts = {"VGROUP_WEIGHTS"}
    mod.vert_mapping = "POLYINTERP_NEAREST"
    mod.layers_vgroup_select_src = "ALL"
    mod.layers_vgroup_select_dst = "NAME"
    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    bpy.context.view_layer.objects.active = final
    bpy.ops.object.modifier_apply(modifier=mod.name)

    arm_mod = final.modifiers.new("player_rig", "ARMATURE")
    arm_mod.object = rig

    covered = sum(1 for v in final.data.vertices
                  if any(g.weight > 1e-6 for g in v.groups))
    total = len(final.data.vertices)
    log("WEIGHTS", covered, "/", total,
        round(covered / total * 100, 4), "%")
    assets = {
        "uv_layers": len(final.data.uv_layers),
        "materials": len(final.data.materials),
        "textures": texture_inventory(final),
        "uv_same": len(final.data.uv_layers) == src_uv,
        "textures_same": texture_inventory(final) == src_tex,
    }
    log("ASSETS", assets)
    assert assets["uv_same"] and assets["textures_same"]
    assert covered / total > 0.99, covered

    # 只导出高模 + 骨架；原高模/代理壳/相机/灯都不选。
    bpy.ops.object.select_all(action="DESELECT")
    final.select_set(True)
    rig.select_set(True)
    bpy.context.view_layer.objects.active = final
    result = bpy.ops.export_scene.gltf(
        filepath=str(OUT_GLB),
        export_format="GLB",
        use_selection=True,
        export_apply=False,          # 关键：不烘焙 ARMATURE，保留 skin
        export_skins=True,
        export_animations=False,
        export_materials="EXPORT",
        export_yup=True,
        export_cameras=False,
        export_lights=False,
    )
    log("EXPORT", list(result), OUT_GLB.stat().st_size, "B")
    assert list(result) == ["FINISHED"]
    assert OUT_GLB.is_file() and OUT_GLB.stat().st_size > 1_000_000

    report = {
        "blender": bpy.app.version_string,
        "source_blend": str(BLEND),
        "source_blend_sha256": blend_sha,
        "source": {"object": src.name, "verts": len(src.data.vertices),
                   "shells_before": None,
                   "uv_layers": src_uv, "textures": src_tex,
                   "vertex_groups": len(src.vertex_groups)},
        "weight_source": {"object": shell.name,
                          "verts": len(shell.data.vertices),
                          "groups": shell_groups},
        "rig": {"object": rig.name, "bones": bone_names},
        "skinned": {"object": final.name, "verts": total,
                    "weighted_verts": covered,
                    "coverage_pct": round(covered / total * 100, 4),
                    "assets": assets,
                    "modifiers": [{"name": m.name, "type": m.type}
                                  for m in final.modifiers]},
        "export": {"file": OUT_GLB.name,
                   "bytes": OUT_GLB.stat().st_size,
                   "sha256": sha256(OUT_GLB),
                   "export_apply": False,
                   "export_skins": True,
                   "operator_result": list(result)},
    }
    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
    OUT_JSON.write_text(json.dumps(report, ensure_ascii=False,
                                   indent=2) + "\n", encoding="utf-8")
    log("RIGGED_GLB_OK", report["skinned"]["coverage_pct"], "%")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== export_rig_frames.py =====
"""阶段 3：导出 Godot 驱动层的「输入」与 Blender 端「基准」。

分工（这是本方案的关键边界）：
  · motion_input.json  = Godot 运行时真正读的输入：stance + 三卡逐帧
    11 关节 + retarget mapping + 13 骨顺序。GDScript 自己实现
    make_points / angle / retarget_delta / root 位移，不读烘死的动画。
  · rig_frames.json    = Blender 端独立基准：pose_frame 每帧产出的
    delta 角度、matrix_basis 的 quat/loc/scale、global pose translation。
    Godot 侧只拿它做数值校验，不拿来驱动。

用法：blender.exe -b --python export_rig_frames.py
"""
from __future__ import annotations

import json
import math
import sys
from pathlib import Path

sys.dont_write_bytecode = True
import bpy

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
E = BAKE / "E路线-玩家3D绑骨"
sys.path.insert(0, str(BAKE / "C路线-真3D修复"))
import c_build as C  # noqa: E402

BLEND = E / "玩家V4b-可变形连续壳.blend"
TABLE = BAKE / "baked2.json"
SPEC = BAKE / "3D攻击GIF" / "apose_joints.json"
MAPPING = BAKE / "3D攻击GIF" / "puppet_mapping.json"
OUT_INPUT = HERE / "data" / "motion_input.json"
OUT_FRAMES = HERE / "data" / "rig_frames.json"
CARDS = (("jab", 14), ("cross", 22), ("wave", 36))


def log(*a):
    print(*a, flush=True)


def main() -> int:
    table = json.loads(TABLE.read_text(encoding="utf-8"))
    mapping = json.loads(MAPPING.read_text(encoding="utf-8"))
    spec = json.loads(SPEC.read_text(encoding="utf-8"))
    stance = C.joints_of(table, None, 0)
    P = C.apose_points({"foe": spec["player"]})

    # 1) 运行时输入：只给原始 2D 关节表与 mapping，不给任何烘好的 pose。
    tracks = {}
    for card, n in CARDS:
        src = table["cards"] if card in table["cards"] else table["motions"]
        track = src[card]["track"]
        assert len(track) >= n, (card, len(track), n)
        tracks[card] = [
            {k: [round(float(v[0]), 4), round(float(v[1]), 4)]
             for k, v in C.joints_of(table, card, f).items()}
            for f in range(n)]
    motion = {
        "source": "baked2.json",
        "joint_names": list(C.JOINTS),
        "stance": {k: [round(float(v[0]), 4), round(float(v[1]), 4)]
                   for k, v in stance.items()},
        "cards": {card: {"frames": n, "track": tracks[card]}
                  for card, n in CARDS},
        "mapping": {k: v for k, v in mapping.items()
                    if not k.startswith("_")},
        "bones": [n for n, _p, _u, _v in C.CHAIN],
        "chain": [[n, p, u, v] for n, p, u, v in C.CHAIN],
        "apose_points": {k: [round(float(v[0]), 6), round(float(v[1]), 6)]
                         for k, v in P.items()},
        "px_to_m": 0.01,
    }
    OUT_INPUT.parent.mkdir(parents=True, exist_ok=True)
    OUT_INPUT.write_text(json.dumps(motion, ensure_ascii=False,
                                    separators=(",", ":")) + "\n",
                         encoding="utf-8")

    # 2) Blender 端基准：逐帧 pose_frame 的 delta 与 matrix_basis。
    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    rig = next(o for o in bpy.context.scene.objects
               if o.type == "ARMATURE")
    frames = []
    for card, frame in [(None, 0)] + [(c, f) for c, n in CARDS
                                      for f in range(n)]:
        delta, root, signals = C.pose_frame(
            rig, P, table, stance, card, frame, mapping)
        bones = {}
        for name in motion["bones"]:
            pb = rig.pose.bones[name]
            loc, rot, scale = pb.matrix_basis.decompose()
            bones[name] = {
                "delta_deg": round(math.degrees(delta[name]), 5),
                "quat": [round(float(v), 7) for v in
                         (rot.w, rot.x, rot.y, rot.z)],
                "loc": [round(float(v), 7) for v in loc],
                "scale": [round(float(v), 7) for v in scale],
                "global_pos": [round(float(v), 6) for v in
                               pb.matrix.translation],
            }
        frames.append({
            "card": card if card else "stance", "frame": frame,
            "root_m": [round(float(v), 6) for v in root],
            "signals": signals, "bones": bones,
        })
    baseline = {
        "source_blend": str(BLEND),
        "blender": bpy.app.version_string,
        "algorithm": "c_build.pose_frame / retarget_delta",
        "frame_count": len(frames),
        "bones": motion["bones"],
        "frames": frames,
    }
    OUT_FRAMES.write_text(json.dumps(baseline, ensure_ascii=False,
                                     separators=(",", ":")) + "\n",
                          encoding="utf-8")
    log("MOTION_INPUT", OUT_INPUT.stat().st_size, "B")
    log("RIG_FRAMES", OUT_FRAMES.stat().st_size, "B",
        "frames", len(frames))
    assert len(frames) == 1 + sum(n for _c, n in CARDS) == 73
    log("RIG_FRAMES_OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


===== crosscheck_motion_input.py =====
"""纯 Python 独立复算：motion_input.json 是否足以重建 retarget_delta。

不 import c_build、不依赖 Blender；算法按公式重写，逐帧逐骨与
rig_frames.json 的 Blender 基准 delta_deg 比对。这份实现同时是
GDScript RigDriver.gd 的算法蓝本。
"""
from __future__ import annotations

import json
import math
from pathlib import Path

HERE = Path(__file__).resolve().parent
DATA = HERE / "data"
OUT = HERE / "data" / "motion_crosscheck.json"


def lerp(a, b, t):
    return (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t)


def angle(p, q):
    return math.atan2(q[1] - p[1], q[0] - p[0])


def wrap_pi(a):
    return (a + math.pi) % (2 * math.pi) - math.pi


def clamp(v, cap):
    return max(-cap, min(cap, v))


def make_points(j):
    hip, sh, hd = j["hip"], j["shoulder"], j["head"]
    return {
        "A": hip, "B": lerp(hip, sh, 0.26), "C": lerp(hip, sh, 0.60),
        "D": sh, "E": lerp(sh, hd, 0.58), "F": hd,
        "f_elbow": j["f_elbow"], "f_hand": j["f_hand"],
        "b_elbow": j["b_elbow"], "b_hand": j["b_hand"],
        "f_knee": j["f_knee"], "f_foot": j["f_foot"],
        "b_knee": j["b_knee"], "b_foot": j["b_foot"],
        "tf_head": (hip[0] + 4.0, hip[1]),
        "tb_head": (hip[0] - 4.0, hip[1]),
    }


def retarget(frame_j, stance_j, chain, mapping):
    fp, sp = make_points(frame_j), make_points(stance_j)
    raw = {n: math.degrees(wrap_pi(angle(fp[u], fp[v]) -
                                   angle(sp[u], sp[v])))
           for n, _p, u, v in chain}
    torso = math.degrees(wrap_pi(angle(fp["A"], fp["D"]) -
                                 angle(sp["A"], sp["D"])))
    used = clamp(torso * mapping["torso_gain"], mapping["torso_cap_deg"])
    mf = math.dist(frame_j["f_hand"], stance_j["f_hand"])
    mb = math.dist(frame_j["b_hand"], stance_j["b_hand"])
    tf = min(1.0, mf / mapping["reach_norm_px"])
    tb = min(1.0, mb / mapping["reach_norm_px"])
    tw = (min(1.0, min(mf, mb) / mapping["wave_min_norm_px"])
          * mapping["wave_arm_weight"])
    af, ab = max(tf, tw), max(tb, tw)
    g, cap = mapping["arm_gain_deg"], mapping["leg_cap_deg"]
    return {
        "hips": 0.0, "spine": used, "chest": 0.0, "neck": 0.0,
        "head": -used * mapping["head_compensation"],
        "upperarm_f": -g["f_upper"] * af,
        "forearm_f": -g["f_fore"] * af,
        "upperarm_b": g["b_upper"] * ab,
        "forearm_b": g["b_fore"] * ab,
        "thigh_f": clamp(raw["thigh_f"], cap),
        "shin_f": clamp(raw["shin_f"], cap),
        "thigh_b": clamp(raw["thigh_b"], cap),
        "shin_b": clamp(raw["shin_b"], cap),
    }


def main() -> int:
    motion = json.loads((DATA / "motion_input.json").read_text(
        encoding="utf-8"))
    baseline = json.loads((DATA / "rig_frames.json").read_text(
        encoding="utf-8"))
    chain = motion["chain"]
    mapping = motion["mapping"]
    stance = motion["stance"]
    assert len(baseline["frames"]) == 73

    worst = 0.0
    rows = []
    for f in baseline["frames"]:
        card = f["card"]
        if card == "stance":
            frame_j = stance
        else:
            frame_j = motion["cards"][card]["track"][f["frame"]]
        calc = retarget(frame_j, stance, chain, mapping)
        diffs = {n: abs(calc[n] - f["bones"][n]["delta_deg"])
                 for n in motion["bones"]}
        mx = max(diffs.values())
        worst = max(worst, mx)
        rows.append({"card": card, "frame": f["frame"],
                     "max_abs_delta_deg": round(mx, 6)})
        # root 位移也独立复算
        dx = (frame_j["hip"][0] - stance["hip"][0]) * motion["px_to_m"]
        dz = -(frame_j["hip"][1] - stance["hip"][1]) * motion["px_to_m"]
        assert abs(dx - f["root_m"][0]) < 1e-6
        assert abs(dz - f["root_m"][1]) < 1e-6
    ok = worst < 1e-4 and len(rows) == 73
    OUT.write_text(json.dumps({
        "frames": len(rows), "worst_abs_delta_deg": round(worst, 7),
        "tolerance_deg": 1e-4, "root_recomputed": True,
        "ok": ok, "rows": rows,
    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"FRAMES={len(rows)} WORST_ABS_DELTA_DEG={worst:.7f} "
          f"TOL=1e-4 ROOT_OK=True")
    print("MOTION_INPUT_OK" if ok else "MOTION_INPUT_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== inspect_rigged_glb.py =====
"""纯 Python 复核 player-rigged.glb：skin 是否真的挂在高模上。

不依赖 Blender；解析 GLB 的 JSON chunk + BIN chunk，逐项验证
primitive 属性、skin joints、贴图零重编码，并与 E 路线 player-full.glb
对照。导出器警告「Armature must be the parent of skinned mesh」必须由
这里的 node.skin / JOINTS_0 实据来判定有没有造成实际损害。
"""
from __future__ import annotations

import hashlib
import json
import struct
from pathlib import Path

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
E = BAKE / "E路线-玩家3D绑骨"
GLB = HERE / "player-rigged.glb"
REF = E / "player-full.glb"
OUT = HERE / "data" / "rigged_gltf_inspection.json"


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def parse(path: Path):
    data = path.read_bytes()
    assert struct.unpack_from("<I", data, 0)[0] == 0x46546C67, path
    version, length = struct.unpack_from("<II", data, 4)
    assert version == 2 and length == len(data)
    off, chunks = 12, []
    while off < len(data):
        clen, ctype = struct.unpack_from("<I4s", data, off)
        off += 8
        chunks.append((ctype, data[off:off + clen]))
        off += clen
    js = json.loads(next(p for t, p in chunks if t == b"JSON").decode("utf-8"))
    binary = next(p for t, p in chunks if t == b"BIN\x00")
    return js, binary, len(data)


def image_blobs(js, binary):
    out = []
    for i, im in enumerate(js.get("images", [])):
        bv = js["bufferViews"][im["bufferView"]]
        off = bv.get("byteOffset", 0)
        blob = binary[off:off + bv["byteLength"]]
        out.append({"index": i, "bytes": len(blob), "sha256": sha(blob),
                    "name": im.get("name")})
    return out


def summarize(path: Path) -> dict:
    js, binary, size = parse(path)
    prims = []
    for mi, mesh in enumerate(js.get("meshes", [])):
        for pi, prim in enumerate(mesh.get("primitives", [])):
            acc = js["accessors"][prim["attributes"]["POSITION"]]
            prims.append({
                "mesh": mi, "primitive": pi,
                "attributes": sorted(prim["attributes"].keys()),
                "verts": acc["count"],
                "has_joints": "JOINTS_0" in prim["attributes"],
                "has_weights": "WEIGHTS_0" in prim["attributes"],
                "pos_min": acc.get("min"), "pos_max": acc.get("max"),
            })
    skinned_nodes = [
        {"node": i, "name": n.get("name"),
         "skin": n.get("skin"), "mesh": n.get("mesh")}
        for i, n in enumerate(js.get("nodes", []))
        if "skin" in n]
    skins = [{"joints": len(s.get("joints", [])),
              "inverse_bind": len(s.get("inverseBindMatrices", [])) if isinstance(
                  s.get("inverseBindMatrices"), list) else "accessor"}
             for s in js.get("skins", [])]
    return {
        "file": path.name, "bytes": size, "sha256": sha(path.read_bytes()),
        "counts": {k: len(js.get(k, [])) for k in
                   ("scenes", "nodes", "meshes", "materials", "textures",
                    "images", "skins", "animations", "accessors")},
        "primitives": prims,
        "skinned_nodes": skinned_nodes,
        "skins": skins,
        "images": image_blobs(js, binary),
        "joint_node_names": [js["nodes"][j].get("name")
                             for j in js.get("skins", [{}])[0].get("joints", [])]
        if js.get("skins") else [],
    }


def main() -> int:
    rigged = summarize(GLB)
    ref = summarize(REF)
    out = {"rigged": rigged, "reference_player_full": ref,
           "verdict": {}}
    skinned_hi = [p for p in rigged["primitives"]
                  if p["has_joints"] and p["verts"] > 50000]
    out["verdict"] = {
        "highpoly_has_skin": bool(skinned_hi),
        "highpoly_verts": skinned_hi[0]["verts"] if skinned_hi else None,
        "skinned_nodes": len(rigged["skinned_nodes"]),
        "skin_joints": rigged["skins"][0]["joints"] if rigged["skins"] else 0,
        "images_zero_reencode": all(
            any(i["sha256"] == r["sha256"] for r in ref["images"])
            for i in rigged["images"]),
        "reference_highpoly_has_skin": any(
            p["has_joints"] and p["verts"] > 50000
            for p in ref["primitives"]),
    }
    v = out["verdict"]
    ok = (v["highpoly_has_skin"] and v["skinned_nodes"] >= 1
          and v["skin_joints"] >= 13
          and v["images_zero_reencode"]
          and not v["reference_highpoly_has_skin"])
    out["ok"] = ok
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("RIGGED", json.dumps(v, ensure_ascii=False))
    print("SKINNED_NODES", rigged["skinned_nodes"])
    print("JOINTS", rigged["joint_node_names"])
    print("PRIMS", [(p["verts"], p["has_joints"]) for p in
                    rigged["primitives"]])
    print("RIGGED_GLTF_OK" if ok else "RIGGED_GLTF_FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())


===== probe_rig_basis.py =====
"""阶段 1 诊断：Blender 端 pose_frame 产出的骨骼局部变换长什么样。

要回答三个问题，决定 GDScript 驱动层怎么写：
  1. A-pose rest 13 骨在 armature space 的 head/tail 坐标；
  2. 一帧驱动后每根骨的 matrix_basis（loc/quat/scale）形态；
  3. matrix_basis 的旋转轴/角度是否就是 retarget_delta 的 delta。

只读 E 路线交付的 .blend，不回写任何归档。
用法：blender.exe -b --python probe_rig_basis.py
"""
from __future__ import annotations

import hashlib
import json
import math
import sys
from pathlib import Path

sys.dont_write_bytecode = True
import bpy
from mathutils import Vector

HERE = Path(__file__).resolve().parent
BAKE = HERE.parent
E = BAKE / "E路线-玩家3D绑骨"
sys.path.insert(0, str(BAKE / "C路线-真3D修复"))
import c_build as C  # noqa: E402

BLEND = E / "玩家V4b-可变形连续壳.blend"
TABLE = BAKE / "baked2.json"
SPEC = BAKE / "3D攻击GIF" / "apose_joints.json"
MAPPING = BAKE / "3D攻击GIF" / "puppet_mapping.json"
OUT = HERE / "data" / "rig_basis_probe.json"


def q_row(name: str, pb, delta: float) -> dict:
    loc, rot, scale = pb.matrix_basis.decompose()
    axis = rot.axis
    ang = math.degrees(rot.angle)
    return {
        "bone": name,
        "delta_deg": round(math.degrees(delta), 4),
        "loc": [round(v, 6) for v in loc],
        "quat": [round(v, 6) for v in (rot.w, rot.x, rot.y, rot.z)],
        "quat_axis": [round(v, 5) for v in axis],
        "quat_angle_deg": round(ang, 4),
        "scale": [round(v, 6) for v in scale],
        "rest_head": [round(v, 5) for v in pb.bone.head_local],
        "rest_tail": [round(v, 5) for v in pb.bone.tail_local],
        "global_pose_translation": [
            round(v, 6) for v in pb.matrix.translation],
    }


def main() -> int:
    spec = json.loads(SPEC.read_text(encoding="utf-8"))
    table = json.loads(TABLE.read_text(encoding="utf-8"))
    mapping = json.loads(MAPPING.read_text(encoding="utf-8"))
    P = C.apose_points({"foe": spec["player"]})
    stance = C.joints_of(table, None, 0)

    bpy.ops.wm.open_mainfile(filepath=str(BLEND))
    scene = bpy.context.scene
    rig = next(o for o in scene.objects if o.type == "ARMATURE")
    hi = next(o for o in scene.objects
              if o.type == "MESH"
              and any(m.type == "SURFACE_DEFORM" for m in o.modifiers))
    shell = next(m for m in hi.modifiers
                 if m.type == "SURFACE_DEFORM").target
    print("OPEN", BLEND.name, "rig", rig.name,
          "bones", len(rig.pose.bones),
          "hi_verts", len(hi.data.vertices),
          "shell_verts", len(shell.data.vertices))
    print("SHELL_GROUPS", [g.name for g in shell.vertex_groups])
    print("HI_GROUPS", [g.name for g in hi.vertex_groups])

    frames = []
    for card, frame in ((None, 0), ("jab", 6), ("cross", 10),
                        ("wave", 17)):
        delta, root, signals = C.pose_frame(
            rig, P, table, stance, card, frame, mapping)
        rows = [q_row(n, rig.pose.bones[n], delta[n])
                for n, _p, _u, _v in C.CHAIN]
        frames.append({"card": card, "frame": frame, "root": root,
                       "signals": signals, "bones": rows})
        print("FRAME", card, frame,
              "max_abs_quat_deg",
              round(max(abs(r["quat_angle_deg"]) for r in rows), 3),
              "max_abs_delta_deg",
              round(max(abs(r["delta_deg"]) for r in rows), 3))

    out = {
        "blend": str(BLEND),
        "blend_sha256": hashlib.sha256(BLEND.read_bytes()).hexdigest(),
        "bone_names": [b.name for b in rig.data.bones],
        "hi_verts": len(hi.data.vertices),
        "shell_verts": len(shell.data.vertices),
        "shell_groups": [g.name for g in shell.vertex_groups],
        "hi_groups": [g.name for g in hi.vertex_groups],
        "apose_points": {k: [round(v, 6) for v in p]
                         for k, p in P.items()},
        "frames": frames,
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    print("RIG_BASIS_PROBE_OK", OUT.stat().st_size)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


