--- /dev/null
+++ tests/fighter_skin_check.gd
@@ -0,0 +1,124 @@
+extends SceneTree
+## 外观层自检：证明「V4-02 造型」真的挂在 _draw() 上，且没污染判定层。
+##
+## 跑法（游戏目录下）：
+##   godot --headless --path . --script res://tests/fighter_skin_check.gd
+## 退出码 0 = 全过，1 = 有断言失败。
+##
+## 四组断言各防一件具体的事：
+##   1) 规格色值 / 12 部件清单（连长度一起断言）→ 防悄悄删件或改色
+##   2) SKIN_V2 开启 + 源码里 _draw_skin_v2 被调用 → 防「文件在但没接线」
+##   3) 旧绘制仍在 → 防 SKIN_V2=false 的回退能力消失
+##   4) 动作表 12 卡 + _build_pose() 键集 → 防外观层动到判定数据
+##
+## 注意：这是一条**接线守卫**，不是「画得好看」的守卫。
+## 真正证明「画出来了」的是引擎内截帧 + 像素取证，见
+## `牌拳-CardBoxer-bake/外观层/`。
+
+const FighterScript = preload("res://scripts/fighter.gd")
+const SkinSpec = preload("res://scripts/fighter_skin.gd")
+const Motion = preload("res://scripts/card_motion.gd")
+const Defs = preload("res://scripts/card_data.gd")
+const FIGHTER_SRC := "res://scripts/fighter.gd"
+
+const EXPECTED_PARTS := [
+	"white_outer", "ink_collar", "red_sash", "gold_clasp",
+	"chinese_knot", "double_bun", "pom_pom", "hair_clip",
+	"half_lidded_eye", "glove", "platform_shoe", "ring_blade",
+]
+
+var _fail := 0
+var _checks := 0
+
+
+func _init() -> void:
+	_check_spec()
+	_check_wiring()
+	_check_fallback()
+	_check_pose_untouched()
+	print("")
+	print("检查项 %d，失败 %d 项" % [_checks, _fail])
+	print("FIGHTER SKIN CHECK: " + ("PASS" if _fail == 0 else "FAIL"))
+	quit(0 if _fail == 0 else 1)
+
+
+func _expect(ok: bool, msg: String) -> void:
+	_checks += 1
+	if not ok:
+		_fail += 1
+		print("FAIL: " + msg)
+
+
+# 1) 规格：颜色必须真的分得开，部件必须一个不少。
+func _check_spec() -> void:
+	var spec: Dictionary = SkinSpec.spec()
+	var white: Color = spec["white"]
+	var ink: Color = spec["ink"]
+	var red: Color = spec["red"]
+	var gold: Color = spec["gold"]
+
+	_expect(white.r > 0.90 and white.g > 0.88, "白色外层应接近白，实际 %s" % str(white))
+	_expect(ink.r < 0.20 and ink.g < 0.20, "黑色内层应接近黑，实际 %s" % str(ink))
+	_expect(red.r > red.g + 0.40 and red.r > red.b + 0.40, "红中国结必须是红，实际 %s" % str(red))
+	_expect(gold.r > gold.g and gold.g > gold.b, "金扣必须是暖金，实际 %s" % str(gold))
+	_expect(white.r - ink.r > 0.60, "黑白对比必须足够，否则侧视剪影读不出来")
+	_expect(float(spec["glove_radius"]) >= 12.0, "拳套必须是大圆拳套，实际 %.1f" % float(spec["glove_radius"]))
+	_expect(float(spec["bun_radius"]) >= 7.0, "双环发髻必须可见，实际 %.1f" % float(spec["bun_radius"]))
+
+	var parts: Array = SkinSpec.part_names()
+	_expect(parts.size() == EXPECTED_PARTS.size(),
+		"部件清单长度应为 %d，实际 %d（只断言 has 会让删件通过）" % [EXPECTED_PARTS.size(), parts.size()])
+	for name: String in EXPECTED_PARTS:
+		_expect(parts.has(name), "缺少造型部件 %s" % name)
+	_expect(not parts.has("cat_ear") and not parts.has("cat_tail"),
+		"上一版猫耳/猫尾造型已作废，不应残留在部件清单里")
+	_expect(spec["parts"].size() == EXPECTED_PARTS.size(), "spec() 里的 parts 必须与 part_names() 同长")
+
+
+# 2) 接线：常量开着、调用在 _draw() 里、方法真的存在。
+func _check_wiring() -> void:
+	_expect(FighterScript.SKIN_V2 == true, "SKIN_V2 必须开启，否则整层外观没接上")
+	_expect(FighterScript.SkinSpec == SkinSpec, "fighter.gd 的规格 preload 必须指向同一个脚本")
+
+	var src := FileAccess.get_file_as_string(FIGHTER_SRC)
+	_expect(src.length() > 20000, "fighter.gd 源码读回来必须非空（防真空通过），实际 %d 字符" % src.length())
+	_expect(src.contains("if SKIN_V2:"), "_draw() 里必须有外观开关")
+	_expect(src.contains("_draw_skin_v2(p, body, trim, flash_mix)"), "_draw() 里必须真的调用外观层")
+	_expect(src.count("_draw_skin_v2(") == 2,
+		"外观函数应恰好出现 2 次（1 次定义 + 1 次调用），实际 %d" % src.count("_draw_skin_v2("))
+	var gate_at := src.find("if SKIN_V2:")
+	var call_at := src.find("_draw_skin_v2(p, body, trim, flash_mix)")
+	_expect(gate_at >= 0 and call_at > gate_at, "调用必须落在开关之后，不是散落在别处")
+
+	var f := FighterScript.new()
+	_expect(f.has_method("_draw_skin_v2"), "Fighter 必须真的有 _draw_skin_v2 方法")
+	for name: String in ["_skin_limb", "_skin_glove", "_skin_shoe", "_skin_torso",
+			"_skin_head", "_skin_bun", "_skin_ring_blade"]:
+		_expect(f.has_method(name), "缺少绘制部件方法 %s" % name)
+	f.free()
+
+
+# 3) 回退：旧自绘一行没删，关掉开关还能用。
+func _check_fallback() -> void:
+	var src := FileAccess.get_file_as_string(FIGHTER_SRC)
+	_expect(src.contains("const SKIN_V2 := true"), "开关必须显式为 true（可被变异验证抓到）")
+	_expect(src.contains("\telse:"), "_draw() 里必须保留 else 回退分支")
+	for name: String in ["_draw_limb(", "_draw_torso(", "_draw_head(", "_draw_glove(", "_draw_foot("]:
+		_expect(src.count(name) >= 2, "旧绘制 %s 应仍有定义与调用，实际 %d 次" % [name, src.count(name)])
+
+
+# 4) 判定层：动作表和关节键集一个都不能少。
+func _check_pose_untouched() -> void:
+	_expect(Motion.available(), "card_motion.json 必须仍能载入（外观层不该动动作表）")
+	for id: String in Defs.CARDS:
+		_expect(Motion.has_card(id), "动作表缺少卡牌 %s 的轨迹" % id)
+
+	var f := FighterScript.new()
+	var pose: Dictionary = f._build_pose()
+	var expected := Motion.JOINTS.duplicate()
+	expected.append("lean")
+	_expect(pose.size() == expected.size(),
+		"关节键集应为 %d 个，实际 %d" % [expected.size(), pose.size()])
+	for key: String in expected:
+		_expect(pose.has(key), "关节键集缺少 %s" % key)
+	f.free()
