+            "tear_e": e["tear_p999_m"], "tear_a": a["tear_p999_m"],
+            "reach_e": e["reach_max_m"], "reach_a": a["reach_max_m"],
+        })
+    worst = max(ratios, key=lambda x: x["tear_ratio"])
