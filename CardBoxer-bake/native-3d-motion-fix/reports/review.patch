+## Native clips contain local-rest-relative quaternions, never retarget amplitudes.
+## Validate the entire pose before writing any bone so a bad clip cannot leave a
+## partially updated skeleton. Imported rest translations/scales stay intact.
+func apply_pose(pose: Dictionary) -> Dictionary:
+	if skel == null or local_rest.size() != 13:
+		return {"error": "Native rig is not initialized"}
+	var raw_rotations: Variant = pose.get("rotations")
+	var raw_root: Variant = pose.get("root_offset")
+	if typeof(raw_rotations) != TYPE_DICTIONARY:
+		return {"error": "Native pose rotations must be a dictionary"}
+	if typeof(raw_root) != TYPE_ARRAY or (raw_root as Array).size() != 3:
+		return {"error": "Native root offset must have three components"}
+	var offset: Array = raw_root
+	for value in offset:
+		if typeof(value) != TYPE_INT and typeof(value) != TYPE_FLOAT:
+			return {"error": "Native root offset must be numeric"}
+		if not is_finite(float(value)):
+			return {"error": "Native root offset must be finite"}
