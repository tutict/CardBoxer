+		var name := String(raw_name)
+		var raw: Variant = rotations.get(name)
+		if typeof(raw) != TYPE_ARRAY or (raw as Array).size() != 4:
+			return {"error": "Missing native quaternion for " + name}
+		var components: Array = raw
+		for value in components:
+			if typeof(value) != TYPE_INT and typeof(value) != TYPE_FLOAT:
+				return {"error": "Native quaternion must be numeric: " + name}
+			if not is_finite(float(value)):
+				return {"error": "Native quaternion must be finite: " + name}
+		var q := Quaternion(float(components[0]), float(components[1]),
