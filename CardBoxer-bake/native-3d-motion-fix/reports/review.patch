+## Predict skeleton-space globals without changing live bones. Native exchange
+## choreography uses this to align visible hands instead of arbitrary lunge pixels.
+func pose_global_transforms(pose: Dictionary) -> Dictionary:
+	if skel == null or typeof(pose.get("rotations")) != TYPE_DICTIONARY \
+		or typeof(pose.get("root_offset")) != TYPE_ARRAY:
+		return {}
+	var offset: Array = pose.root_offset
+	if offset.size() != 3:
+		return {}
+	var root_delta := Vector3(float(offset[0]),float(offset[1]),float(offset[2]))
+	if not root_delta.is_finite():
+		return {}
+	var rotations := {}
+	for raw_name in bone_names:
+		var name := String(raw_name)
+		var row: Variant = pose.rotations.get(name)
+		if typeof(row) != TYPE_ARRAY or (row as Array).size() != 4:
+			return {}
+		var a: Array = row
+		var q := Quaternion(float(a[0]),float(a[1]),float(a[2]),float(a[3]))
+		if not q.is_finite() or absf(q.length_squared()-1.0) > 0.01:
+			return {}
+		rotations[name] = q.normalized()
+	var globals := {}
+	var pending: Array = bone_names.duplicate()
+	while not pending.is_empty():
+		var progressed := false
+		for raw_name in pending.duplicate():
+			var name := String(raw_name)
+			var idx: int = int(bone_idx[name])
+			var parent := skel.get_bone_parent(idx)
+			var parent_name := skel.get_bone_name(parent) if parent >= 0 else ""
+			if bone_idx.has(parent_name) and not globals.has(parent_name):
+				continue
+			var rest: Transform3D = local_rest[name]
+			var q: Quaternion = rest.basis.get_rotation_quaternion() * rotations[name]
+			var local := Transform3D(Basis(q).scaled(rest.basis.get_scale()),rest.origin)
+			if name == "hips":
+				local.origin += root_delta
+			var parent_pose: Transform3D = globals.get(parent_name,
+				skel.get_bone_global_rest(parent) if parent >= 0 else Transform3D.IDENTITY)
+			globals[name] = parent_pose * local
+			pending.erase(raw_name)
+			progressed = true
+		if not progressed:
+			return {}
+	return globals
